<UserControl x:Class="CloudAlarmOverlay.App.Controls.TimeInput" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
 <Grid Height="36" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <TextBox Text="{Binding Text,ElementName=Root,UpdateSourceTrigger=PropertyChanged}" MaxLength="5" Margin="0" VerticalContentAlignment="Center" ToolTip="直接輸入 HH:mm，或按右側鐘面選時" AutomationProperties.Name="時間 HH:mm"/>
  <Button Grid.Column="1" Content="&#xE823;" FontFamily="Segoe MDL2 Assets" Click="OpenClock" Padding="6" Margin="4,0,0,0" ToolTip="開啟鐘面選時" AutomationProperties.Name="開啟鐘面選時"/>
 </Grid>
</UserControl>
