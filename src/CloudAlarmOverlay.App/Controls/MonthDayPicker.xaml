<UserControl x:Class="CloudAlarmOverlay.App.Controls.MonthDayPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/LightTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid>
  <ToggleButton Foreground="{adaptive:AdaptiveBrush #16243E}" Background="{adaptive:AdaptiveBrush #FFFFFF}" BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" x:Name="OpenButton" Padding="12,8" HorizontalContentAlignment="Stretch" AutomationProperties.Name="選擇每年國曆月日">
   <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
   <DockPanel><TextBlock DockPanel.Dock="Right" Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Margin="18,0,0,0"/><TextBlock x:Name="SelectionLabel"/></DockPanel>
  </ToggleButton>
  <Popup x:Name="DatePopup" IsOpen="{Binding IsChecked,ElementName=OpenButton}" PlacementTarget="{Binding ElementName=OpenButton}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
   <Border Background="{adaptive:AdaptiveBrush #FFFFFF}" BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="1" CornerRadius="14" PreviewKeyDown="PopupKeyDown" Padding="14" Margin="0,5,0,0" Width="330">
    <StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="‹" Click="PreviousMonth" Margin="0" AutomationProperties.Name="上一個月"/><Button x:Name="MonthHeading" Grid.Column="1" Click="ShowMonths" Background="Transparent" BorderThickness="0" Margin="6,0" ToolTip="選擇月份"/><Button Grid.Column="2" Content="›" Click="NextMonth" Margin="0" AutomationProperties.Name="下一個月"/>
     </Grid>
     <UniformGrid x:Name="MonthGrid" Columns="4" Margin="0,10,0,0" Visibility="Collapsed"/>
     <UniformGrid x:Name="DayGrid" Columns="7" Margin="0,10,0,8"/>
     <TextBlock Text="每年在所選月日提醒；2 月 29 日僅在閏年提醒。" Style="{StaticResource Muted}" FontSize="12"/>
    </StackPanel>
   </Border>
  </Popup>
 </Grid>
</UserControl>
