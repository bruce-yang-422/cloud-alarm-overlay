<UserControl x:Class="CloudAlarmOverlay.App.Controls.SymbolPicker"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles"
 x:Name="Root">
 <Grid>
  <Button x:Name="OpenButton" Click="OpenPicker" Padding="10,4" Margin="0,0,4,4" ToolTip="選擇特殊符號插入內容" AutomationProperties.Name="開啟特殊符號">
   <StackPanel Orientation="Horizontal"><TextBlock Text="✦" Foreground="{adaptive:AdaptiveBrush #0766FF}" FontSize="17" VerticalAlignment="Center"/><TextBlock Text=" 特殊符號 ▾" VerticalAlignment="Center"/></StackPanel>
  </Button>
  <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=OpenButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="OnOpened" Closed="OnClosed">
   <Border Width="324" Background="{adaptive:AdaptiveBrush White}" BorderBrush="{adaptive:AdaptiveBrush #D5E1EF}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,4,4,4" PreviewKeyDown="OnPopupKeyDown">
    <StackPanel>
     <TextBlock Text="特殊符號" Foreground="{adaptive:AdaptiveBrush #263C57}" FontSize="14" FontWeight="SemiBold"/>
     <TextBlock Text="點選符號，插入目前的游標位置" Foreground="{adaptive:AdaptiveBrush #7184A0}" FontSize="12" Margin="0,4,0,10"/>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="240">
      <ItemsControl x:Name="Choices" ItemsSource="{Binding Symbols,ElementName=Root}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Button Content="{Binding}" Click="ChooseSymbol" Width="40" Height="40" Padding="0" Margin="0,0,5,5" FontFamily="Segoe UI Symbol, Microsoft JhengHei UI" FontSize="19" ToolTip="{Binding}" AutomationProperties.Name="{Binding}">
         <Button.Template><ControlTemplate TargetType="Button">
          <Border x:Name="Tile" Background="{adaptive:AdaptiveBrush #F2F6FC}" CornerRadius="8" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{adaptive:AdaptiveBrush #E3EEFF}"/></Trigger>
           <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #246BDF}"/></Trigger>
           <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tile" Property="Background" Value="{adaptive:AdaptiveBrush #CADAFA}"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate></Button.Template>
        </Button>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
    </StackPanel>
   </Border>
  </Popup>
 </Grid>
</UserControl>
