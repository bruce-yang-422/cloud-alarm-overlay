<UserControl x:Class="CloudAlarmOverlay.App.Controls.CyclicTimeSelector"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles" x:Name="Root" Height="40" MinWidth="64"
 ToolTip="可直接輸入數字；也可使用箭頭、滾輪或上下方向鍵循環調整。">
 <Border x:Name="Surface" CornerRadius="7" BorderThickness="1" BorderBrush="{adaptive:AdaptiveBrush #D6E1EF}" Background="{adaptive:AdaptiveBrush #FDFEFF}">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
   <TextBox x:Name="ValueEditor" Text="00" MaxLength="2" TextAlignment="Center" VerticalContentAlignment="Center"
    Margin="0" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{adaptive:AdaptiveBrush #16243E}" CaretBrush="{adaptive:AdaptiveBrush #16243E}"
    AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),ElementName=Root}"
    TextChanged="EditValue" GotKeyboardFocus="SelectValue" PreviewMouseLeftButtonDown="FocusEditor" LostKeyboardFocus="FinishEditing">
    <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost"/></ControlTemplate></TextBox.Template>
   </TextBox>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <Grid.Resources><Style TargetType="Button"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #576C8B}"/></Style></Grid.Resources>
    <Button Content="▴" Click="Previous" AutomationProperties.Name="減少一格" ToolTip="減少一格，00 會循環到最大值"/>
    <Button Grid.Row="1" Content="▾" Click="Next" AutomationProperties.Name="增加一格" ToolTip="增加一格，最大值會循環到 00"/>
   </Grid>
  </Grid>
 </Border>
 <UserControl.Style><Style TargetType="UserControl"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></Style.Triggers></Style></UserControl.Style>
</UserControl>
