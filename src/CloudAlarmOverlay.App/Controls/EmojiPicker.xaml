<UserControl x:Class="CloudAlarmOverlay.App.Controls.EmojiPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles" xmlns:local="clr-namespace:CloudAlarmOverlay.App.Controls" x:Name="Root">
 <Grid>
  <Button x:Name="OpenButton"  Click="OpenPicker" Padding="10,4" Margin="0,0,4,4" ToolTip="選擇 emoji 插入內容" AutomationProperties.Name="開啟常用 emoji"><StackPanel Orientation="Horizontal"><local:EmojiGlyph Text="😊" Width="20" Height="20"/><TextBlock Text=" 常用 emoji ▾" VerticalAlignment="Center"/></StackPanel></Button>
  <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=OpenButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="OnOpened" Closed="OnClosed">
   <Border Width="292" Background="{adaptive:AdaptiveBrush White}" BorderBrush="{adaptive:AdaptiveBrush #D5E1EF}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,4,4,4" PreviewKeyDown="OnPopupKeyDown">
    <StackPanel>
     <TextBlock Text="常用 emoji" Foreground="{adaptive:AdaptiveBrush #263C57}" FontSize="14" FontWeight="SemiBold"/>
     <TextBlock Text="點選即可插入" Foreground="{adaptive:AdaptiveBrush #7184A0}" FontSize="12" Margin="0,4,0,10"/>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="240">
      <ItemsControl x:Name="Choices" ItemsSource="{Binding Items,ElementName=Root}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Button Content="{Binding}" Click="ChooseEmoji" Width="40" Height="40" Padding="0" Margin="0,0,3,4" FontFamily="Segoe UI Emoji" FontSize="22" ToolTip="{Binding}" AutomationProperties.Name="{Binding}">
         <Button.ContentTemplate><DataTemplate><local:EmojiGlyph Text="{Binding}" Width="28" Height="28"/></DataTemplate></Button.ContentTemplate><Button.Template><ControlTemplate TargetType="Button">
          <Border x:Name="Tile" Background="{adaptive:AdaptiveBrush #F2F6FC}" CornerRadius="8" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{adaptive:AdaptiveBrush #E3EEFF}"/></Trigger>
           <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #246BDF}"/></Trigger>
           <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tile" Property="Background" Value="{adaptive:AdaptiveBrush #CADAFA}"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate></Button.Template>
        </Button>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
     <TextBlock Foreground="{adaptive:AdaptiveBrush #7184A0}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Text="可到「設定 → 常用 emoji」編輯清單。"/>
    </StackPanel>
   </Border>
  </Popup>
 </Grid>
</UserControl>
