<UserControl x:Class="CloudAlarmOverlay.App.Views.GoogleWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/LightTheme.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
   <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #697C99}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,2"/></Style>
   <Style x:Key="SourceListItem" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="ItemBorder" Padding="10,10" CornerRadius="8" Background="Transparent"><ContentPresenter/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{adaptive:AdaptiveBrush #F0F5FB}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{adaptive:AdaptiveBrush #E6F0FF}"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/><Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="168"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="0,0,1,0" Padding="0,0,12,0">
   <DockPanel IsEnabled="{Binding CanAct}">
    <TextBlock DockPanel.Dock="Top" Text="帳號與同步來源" Style="{StaticResource FieldLabel}" Margin="10,4,0,10"/>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
     <Button Content="＋ 新增來源" Command="{Binding AddSourceCommand}" Margin="0,0,0,8"/>
     <Button Content="更新狀態" Command="{Binding RefreshStatusCommand}" Margin="0"/>
    </StackPanel>
    <ListBox x:Name="SourceTabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Selected}" SelectionChanged="SourceChanged" Background="Transparent" BorderThickness="0" Padding="0"
     ItemContainerStyle="{StaticResource SourceListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="帳號與同步來源">
     <ListBox.ItemTemplate><DataTemplate><StackPanel>
      <TextBlock Text="{Binding Name}" Foreground="{adaptive:AdaptiveBrush #16243E}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
      <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{adaptive:AdaptiveBrush #697C99}" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Id}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="16,0,0,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,12" IsEnabled="{Binding CanAct}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Selected.Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Selected.Name}"/>
    <CheckBox Grid.Column="1" Content="鎖定設定" IsChecked="{Binding Selected.Locked}" Style="{StaticResource PillSwitch}" Margin="12,0,0,0" Visibility="{Binding IsSource,Converter={StaticResource BoolVisibility}}"/>
   </Grid>
   <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
    <StackPanel IsEnabled="{Binding CanAct}">
     <StackPanel Visibility="{Binding IsOverview,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="管理個人與公司帳號，再從左側新增同步來源。" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
      <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding Accounts.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel>
       <TextBlock Text="已連接帳號" Style="{StaticResource SectionTitle}"/>
       <ComboBox x:Name="AccountPicker" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" AutomationProperties.Name="已連接 Google 帳號"><ComboBox.ItemTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Label}"/><Run Text=" · "/><Run Text="{Binding Email}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
       <TextBlock Text="{Binding SelectedAccount.Status}" Style="{StaticResource Muted}" Margin="0,4,0,10"/>
       <WrapPanel><Button Content="登出此帳號" Click="SignOut"/><Button Content="解除 Google 授權" Click="Revoke"/></WrapPanel>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><Expander x:Name="AddAccountExpander" Header="新增 Google 帳號">
       <Expander.Style><Style TargetType="Expander"><Setter Property="IsExpanded" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding Accounts.Count}" Value="0"><Setter Property="IsExpanded" Value="True"/></DataTrigger></Style.Triggers></Style></Expander.Style>
       <StackPanel Margin="0,12,0,0">
        <TextBlock Text="帳號標籤" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding AccountLabel,UpdateSourceTrigger=PropertyChanged}" Width="220" HorizontalAlignment="Left"/>
        <WrapPanel Margin="0,8"><CheckBox Content="讀取 Sheets" IsChecked="{Binding UseSheets}" Margin="0,0,20,8"/><CheckBox Content="讀取自己的日曆" IsChecked="{Binding UseCalendar}" Margin="0,0,0,8"/></WrapPanel>
        <CheckBox Content="同時申請 Sheets 編輯權限" IsChecked="{Binding WriteSheets}" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding ConfigurationStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
        <Button Content="使用 Google 登入" Command="{Binding SignInCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
        <TextBlock Text="有效憑證會自動續用；授權失效時才需重新登入。" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
       </StackPanel>
      </Expander></Border>
      <Expander Header="進階：組織登入設定" Margin="0,8,0,14"><StackPanel Margin="0,12,0,0">
       <TextBlock Text="{Binding ConfigurationStatus}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <TextBlock Text="一般使用者直接使用 Google 登入。僅在組織要求自訂 Google Cloud 專案時匯入設定；切換前請先登出所有帳號。" Style="{StaticResource Muted}"/>
       <WrapPanel Margin="0,10"><Button Content="匯入桌面 OAuth 設定" Click="ImportClient" Margin="0,0,8,8"/><Button Content="恢復程式預設" Command="{Binding UseBuiltInClientCommand}" Margin="0,0,8,8"/><Button Content="設定教學" Click="OpenGuide" Margin="0,0,0,8"/></WrapPanel>
      </StackPanel></Expander>
      <TextBlock Text="同步概況" Style="{StaticResource SectionTitle}"/>
      <ItemsControl ItemsSource="{Binding SourceCards}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel>
       <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding LastSync,StringFormat=最後成功：{0}}" Style="{StaticResource Muted}" FontSize="12"/>
      </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
     <StackPanel Visibility="{Binding IsSource,Converter={StaticResource BoolVisibility}}">
      <StackPanel IsEnabled="{Binding Selected.Editable}">
       <StackPanel.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,2"/><Setter Property="Margin" Value="0,3,0,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="0,3,0,6"/></Style>
       </StackPanel.Resources>
       <TextBlock Text="基本資料" Style="{StaticResource SectionTitle}"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="來源名稱" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Selected.Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="來源名稱"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="來源類型" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Selected.Kind}" AutomationProperties.Name="來源類型"/></StackPanel>
       </Grid>
       <TextBlock Text="使用帳號" Style="{StaticResource FieldLabel}" Margin="0,6,0,2"/>
       <ComboBox ItemsSource="{Binding Accounts}" SelectedValuePath="Id" SelectedValue="{Binding Selected.AccountId}" AutomationProperties.Name="來源使用帳號"><ComboBox.ItemTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Label}"/><Run Text=" · "/><Run Text="{Binding Email}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
       <Border BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0"><StackPanel>
        <TextBlock Text="連線內容" Style="{StaticResource SectionTitle}"/>
        <StackPanel Visibility="{Binding Selected.IsSheet,Converter={StaticResource BoolVisibility}}">
         <TextBlock Text="試算表網址或 Spreadsheet ID" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Selected.ResourceId,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="試算表網址"/>
        </StackPanel>
        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ComboBox ItemsSource="{Binding Selected.Resources}" SelectedItem="{Binding Selected.SelectedResource}" DisplayMemberPath="Name" AutomationProperties.Name="工作表或自有日曆" ToolTip="先讀取清單，再選擇工作表或自己擁有的日曆" Margin="0,0,8,0"/>
         <Button Grid.Column="1" Content="讀取清單" Command="{Binding LoadResourcesCommand}" Margin="0" ToolTip="讀取試算表的工作表，或此帳號自己擁有的日曆"/>
        </Grid>
        <TextBlock Text="選擇工作表或自有日曆後，儲存來源即可開始同步。" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
        <TextBlock Text="{Binding Selected.ResourceId}" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding Selected.IsCalendar,Converter={StaticResource BoolVisibility}}"/>
       </StackPanel></Border>
       <Border BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0"><StackPanel>
        <TextBlock Text="同步與提醒" Style="{StaticResource SectionTitle}"/>
        <WrapPanel>
         <CheckBox Content="啟用同步" IsChecked="{Binding Selected.Enabled}" Style="{StaticResource PillSwitch}" Margin="0,0,24,8" VerticalAlignment="Center"/>
         <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Text="每"/><TextBox Text="{Binding Selected.IntervalMinutes}" Width="64" Margin="8,0" AutomationProperties.Name="同步間隔分鐘"/><TextBlock Text="分鐘同步"/></StackPanel>
        </WrapPanel>
        <WrapPanel Visibility="{Binding Selected.IsCalendar,Converter={StaticResource BoolVisibility}}">
         <StackPanel Width="140" Margin="0,4,16,8"><TextBlock Text="提前提醒（分鐘）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Selected.ReminderMinutes}"/></StackPanel>
         <StackPanel Margin="0,4,0,8"><CheckBox Content="包含全天行程" IsChecked="{Binding Selected.IncludeAllDay}" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal" IsEnabled="{Binding Selected.IncludeAllDay}"><TextBlock Text="日曆當地時間"/><TextBox Text="{Binding Selected.AllDayHour}" Width="52" Margin="8,0"/><TextBlock Text="時提醒"/></StackPanel></StackPanel>
        </WrapPanel>
        <TextBlock Text="Google 日曆只讀取行程，不會修改內容或回覆邀請。" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding Selected.IsCalendar,Converter={StaticResource BoolVisibility}}"/>
       </StackPanel></Border>
       <Expander Header="進階：工作表編號與寫入權限" Margin="0,8,0,14" Visibility="{Binding Selected.IsSheet,Converter={StaticResource BoolVisibility}}"><StackPanel Margin="0,10,0,0">
        <TextBlock Text="Tasks 工作表 GID（也可手動填入）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Selected.TabId,UpdateSourceTrigger=PropertyChanged}"/>
        <CheckBox Content="允許此 Tasks 來源寫回" IsChecked="{Binding Selected.AllowWrite}" Margin="0,8"/>
        <TextBlock Text="需另行授予 Sheets 編輯權限。任務表保留標題列及第二列中文說明；寫入時請避免其他人同時編輯。" Style="{StaticResource Muted}" FontSize="12"/>
       </StackPanel></Expander>
      </StackPanel>
      <Expander x:Name="TaskEditorExpander" Header="線上任務編輯" Margin="0,8,0,14" Visibility="{Binding Selected.IsSheet,Converter={StaticResource BoolVisibility}}"><StackPanel Margin="0,12,0,0">
       <TextBlock Text="先儲存來源，再輸入任務 ID 讀取，或新增任務。寫入前會預覽差異並再次確認。" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
       <WrapPanel><TextBox Text="{Binding EditTaskId,UpdateSourceTrigger=PropertyChanged}" Width="180" AutomationProperties.Name="線上任務 ID"/><Button Content="讀取任務" Command="{Binding ReadTaskCommand}"/><Button Content="新增任務" Command="{Binding NewTaskCommand}"/></WrapPanel>
       <TextBlock Text="{Binding EditSummary}" TextWrapping="Wrap"/>
       <ItemsControl ItemsSource="{Binding TaskFields}"><ItemsControl.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnly}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <WrapPanel Visibility="{Binding HasTaskDraft,Converter={StaticResource BoolVisibility}}"><Button Content="預覽差異並寫入" Click="WriteTask"/><Button Content="刪除雲端任務" Click="DeleteTask"/></WrapPanel>
      </StackPanel></Expander>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <Border x:Name="SourceActions" Grid.Row="2" BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0" IsEnabled="{Binding CanAct}">
    <StackPanel>
     <StackPanel Visibility="{Binding IsSource,Converter={StaticResource BoolVisibility}}">
      <TextBlock ToolTip="{Binding Selected.Status}" TextTrimming="CharacterEllipsis" Foreground="{adaptive:AdaptiveBrush #697C99}" FontSize="12" Margin="0,0,0,8"><Run Text="{Binding Selected.Status}"/><Run Text=" · 最後成功："/><Run Text="{Binding Selected.LastSync}"/></TextBlock>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal"><Button x:Name="SaveSourceButton" Content="儲存來源" Command="{Binding SaveSourceCommand}" IsEnabled="{Binding Selected.Editable}" Style="{StaticResource Primary}"/><Button x:Name="SyncSourceButton" Content="立即同步" Command="{Binding SyncSelectedCommand}"/></StackPanel>
       <Button Grid.Column="1" Content="移除來源" Click="RemoveSource" Margin="8,0,0,0"/>
      </Grid>
     </StackPanel>
     <Button Content="同步全部 Google 來源" Command="{Binding SyncSelectedCommand}" HorizontalAlignment="Left" Visibility="{Binding IsOverview,Converter={StaticResource BoolVisibility}}"/>
    </StackPanel>
   </Border>
   <DockPanel Grid.Row="3" Margin="0,8,0,0">
    <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
    <Button DockPanel.Dock="Right" Content="取消操作" Command="{Binding CancelCommand}" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}" Margin="8,0,0,0"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="44"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{adaptive:AdaptiveBrush #3664A0}" FontSize="12"/></ScrollViewer>
   </DockPanel>
  </Grid>
 </Grid>
</UserControl>
