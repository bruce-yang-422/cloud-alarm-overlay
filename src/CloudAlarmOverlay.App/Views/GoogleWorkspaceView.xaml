<UserControl xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CloudAlarmOverlay.App.Views.GoogleWorkspaceView" FontSize="13">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles/GoogleWorkspaceStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Background="{adaptive:AdaptiveBrush WorkspaceSurface}">
    <Grid Margin="0" MaxWidth="920" HorizontalAlignment="Stretch">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,18" IsEnabled="{Binding CanAct}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Selected.Name}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Selected.Name}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsSource,Converter={StaticResource BoolVisibility}}">
          <Button Content="編輯設定" Click="EditSource" IsEnabled="{Binding Selected.Locked}" />
          <Button x:Name="SyncSourceButton" Content="立即同步" Command="{Binding SyncSelectedCommand}" IsEnabled="{Binding Selected.Locked}" />
          <Button Content="⋯" Click="SourceMenu" AutomationProperties.Name="來源更多操作" />
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
        <StackPanel IsEnabled="{Binding CanAct}">
          <StackPanel Visibility="{Binding IsOverview,Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="連接你的 Google 帳號，集中管理任務與行程。" Style="{StaticResource WorkspaceMuted}" FontSize="13" Margin="0,0,0,18" />
            <Grid Margin="2,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock FontWeight="SemiBold">
                <Run Text="我的帳號" />
                <Run Text="  " />
                <Run Text="{Binding Accounts.Count,Mode=OneWay}" Foreground="{adaptive:AdaptiveBrush WorkspaceMuted}" />
              </TextBlock>
              <Button x:Name="AddAccountButton" Grid.Column="1" Click="AddAccount" IsEnabled="{Binding CanSignIn}" Style="{StaticResource SettingsPrimary}" Margin="0">
                <TextBlock Text="＋ 新增帳號" Foreground="{adaptive:AdaptiveBrush AccentText}" />
              </Button>
            </Grid>
            <Border x:Name="EmptyAccounts" Padding="22" Margin="0,0,0,16">
              <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource WorkspaceGroup}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Accounts.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel HorizontalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="14" Background="{adaptive:AdaptiveBrush #E6F0FF}" HorizontalAlignment="Center" Margin="0,0,0,12">
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center" Foreground="{adaptive:AdaptiveBrush #0766FF}" />
                </Border>
                <TextBlock Text="加入第一個 Google 帳號" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="登入後即可新增試算表或日曆來源。" Style="{StaticResource WorkspaceMuted}" FontSize="12" TextAlignment="Center" />
              </StackPanel>
            </Border>
            <ItemsControl x:Name="AccountList" ItemsSource="{Binding Accounts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource WorkspaceGroup}" Padding="14" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="38" Height="38" CornerRadius="10" Background="{adaptive:AdaptiveBrush WorkspaceSidebar}" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{adaptive:AdaptiveBrush WorkspaceMuted}" />
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Label}" Foreground="{adaptive:AdaptiveBrush WorkspaceText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" Margin="0,0,0,6" />
                        <DockPanel>
                          <ContentControl DockPanel.Dock="Right" Content="{Binding Status}" ContentTemplate="{StaticResource WorkspaceAccountStatus}" Margin="10,0,0,0" />
                          <TextBlock Text="{Binding Email}" Style="{StaticResource WorkspaceMuted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Email}" />
                        </DockPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="新增來源" Click="AddAccountSource" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <Button Content="•••" Click="AccountMenu" Width="32" MinHeight="28" Padding="0" Margin="0" VerticalAlignment="Center" ToolTip="管理此帳號" AutomationProperties.Name="管理此 Google 帳號">
                          <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource GoogleAccountMenu}" Background="{adaptive:AdaptiveBrush #FFFFFF}" Foreground="{adaptive:AdaptiveBrush WorkspaceText}" FontSize="13">
                              <MenuItem Header="重新命名…" Click="RenameAccount" />
                              <Separator />
                              <MenuItem Header="登出此帳號…" Click="SignOut" />
                              <Separator />
                              <MenuItem Header="解除 Google 授權…" Click="Revoke" Foreground="{adaptive:AdaptiveBrush #BA3D45}" />
                            </ContextMenu>
                          </Button.ContextMenu>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="帳號憑證有效時會自動續用，無需每次登入。" Style="{StaticResource WorkspaceMuted}" FontSize="12" Margin="2,4,0,22" />
            <DockPanel Margin="0,0,0,12">
              <ComboBox DockPanel.Dock="Right" Width="160" ItemsSource="{Binding SourceAccountFilters}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SourceAccountFilter}" AutomationProperties.Name="篩選來源帳號" />
              <TextBlock Text="同步來源" Style="{StaticResource WorkspaceSection}" />
            </DockPanel>
            <TextBlock x:Name="EmptySources" Text="還沒有同步來源。從帳號卡片新增試算表或日曆。" FontSize="12" Margin="2,0,0,12">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource WorkspaceMuted}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Tabs.Count}" Value="1">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding SourceCards}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Click="OpenSource" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Padding="12,10" ToolTip="開啟來源設定">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                      </Grid.ColumnDefinitions>
                      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource WorkspaceSourceIcon}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" Foreground="{adaptive:AdaptiveBrush WorkspaceText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding AccountLabel}" Style="{StaticResource WorkspaceMuted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource WorkspaceMuted}" FontSize="12" Margin="0,4,0,0" />
                      </StackPanel>
                      <Path Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="{adaptive:AdaptiveBrush WorkspaceMuted}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Visibility="{Binding IsSource,Converter={StaticResource BoolVisibility}}">
            <Button Content="‹ 返回帳號與同步" Click="BackToAccounts" Style="{StaticResource WorkspaceQuietButton}" HorizontalAlignment="Left" Margin="0,0,0,16" />
            <StackPanel IsEnabled="{Binding Selected.Editable}">
              <StackPanel.Resources>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                  <Setter Property="MinHeight" Value="34" />
                  <Setter Property="Padding" Value="8,2" />
                  <Setter Property="Margin" Value="0,3,0,6" />
                  <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                  <Setter Property="Height" Value="34" />
                  <Setter Property="Margin" Value="0,3,0,6" />
                </Style>
              </StackPanel.Resources>
              <TextBlock Text="基本資料" Style="{StaticResource WorkspaceSection}" />
              <Border Style="{StaticResource WorkspaceGroup}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="來源名稱" Style="{StaticResource WorkspaceFieldLabel}" />
                      <TextBox Text="{Binding Selected.Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="來源名稱" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="來源類型" Style="{StaticResource WorkspaceFieldLabel}" />
                      <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Selected.Kind}" AutomationProperties.Name="來源類型" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="使用帳號" Style="{StaticResource WorkspaceFieldLabel}" Margin="0,6,0,2" />
                  <ComboBox ItemsSource="{Binding Accounts}" SelectedValuePath="Id" SelectedValue="{Binding Selected.AccountId}" AutomationProperties.Name="來源使用帳號">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Label}" />
                          <Run Text=" · " />
                          <Run Text="{Binding Email}" />
                        </TextBlock>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Border>
              <TextBlock Text="連線內容" Style="{StaticResource WorkspaceSection}" />
              <Border Style="{StaticResource WorkspaceGroup}">
                <StackPanel>
                  <StackPanel Visibility="{Binding Selected.IsSheet,Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="試算表網址或 Spreadsheet ID" Style="{StaticResource WorkspaceFieldLabel}" />
                    <TextBox Text="{Binding Selected.ResourceId,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="試算表網址" />
                  </StackPanel>
                  <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Selected.Resources}" SelectedItem="{Binding Selected.SelectedResource}" DisplayMemberPath="Name" AutomationProperties.Name="工作表或自有日曆" ToolTip="先讀取清單，再選擇工作表或自己擁有的日曆" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="讀取清單" Command="{Binding LoadResourcesCommand}" Margin="0" ToolTip="讀取試算表的工作表，或此帳號自己擁有的日曆" />
                  </Grid>
                  <TextBlock Text="選擇工作表或自有日曆後，儲存來源即可開始同步。" Style="{StaticResource WorkspaceMuted}" FontSize="12" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding Selected.ResourceId}" TextWrapping="Wrap" Style="{StaticResource WorkspaceMuted}" FontSize="12" Visibility="{Binding Selected.IsCalendar,Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
              </Border>
              <TextBlock Text="同步與提醒" Style="{StaticResource WorkspaceSection}" />
              <Border Style="{StaticResource WorkspaceGroup}">
                <StackPanel>
                  <WrapPanel>
                    <CheckBox Content="啟用同步" IsChecked="{Binding Selected.Enabled}" Style="{StaticResource SettingsSwitch}" Margin="0,0,24,8" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                      <TextBlock Text="每" />
                      <TextBox Text="{Binding Selected.IntervalMinutes,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}" Width="64" Margin="8,0" AutomationProperties.Name="同步間隔分鐘" />
                      <TextBlock Text="分鐘同步" />
                    </StackPanel>
                  </WrapPanel>
                  <CheckBox Content="包含全天行程" IsChecked="{Binding Selected.IncludeAllDay}" Margin="0,4,0,8" Visibility="{Binding Selected.IsCalendar,Converter={StaticResource BoolVisibility}}" />
                  <TextBlock Text="首次採用 Google 彈出式提醒設定。同步後可在「我的任務」調整各行程的提醒開關與時間，或恢復 Google 設定。" Style="{StaticResource WorkspaceMuted}" FontSize="12" Visibility="{Binding Selected.IsCalendar,Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
              </Border>
              <Expander Header="進階：工作表編號與寫入權限" Margin="0,8,0,14" Visibility="{Binding Selected.IsSheet,Converter={StaticResource BoolVisibility}}">
                <StackPanel Margin="0,10,0,0">
                  <TextBlock Text="Tasks 工作表 GID（也可手動填入）" Style="{StaticResource WorkspaceFieldLabel}" />
                  <TextBox Text="{Binding Selected.TabId,UpdateSourceTrigger=PropertyChanged}" />
                  <CheckBox Content="允許此 Tasks 來源寫回" IsChecked="{Binding Selected.AllowWrite}" Margin="0,8" />
                  <TextBlock Text="需另行授予 Sheets 編輯權限。任務表保留標題列及第二列中文說明；寫入時請避免其他人同時編輯。" Style="{StaticResource WorkspaceMuted}" FontSize="12" />
                </StackPanel>
              </Expander>
            </StackPanel>
            <Button Content="管理線上任務…" Click="OpenTaskEditor" HorizontalAlignment="Left" IsEnabled="{Binding Selected.Locked}" Visibility="{Binding Selected.IsSheet,Converter={StaticResource BoolVisibility}}" />
            <Expander x:Name="TaskEditorExpander" Visibility="Collapsed">
              <StackPanel Margin="0,12,0,0">
                <TextBlock Text="先儲存來源，再輸入任務 ID 讀取，或新增任務。寫入前會預覽差異並再次確認。" Style="{StaticResource WorkspaceMuted}" Margin="0,0,0,10" />
                <WrapPanel>
                  <TextBox Text="{Binding EditTaskId,UpdateSourceTrigger=PropertyChanged}" Width="180" AutomationProperties.Name="線上任務 ID" />
                  <Button Content="讀取任務" Command="{Binding ReadTaskCommand}" />
                  <Button Content="新增任務" Command="{Binding NewTaskCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding EditSummary}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding TaskFields}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="130" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ReadOnly}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Visibility="{Binding HasTaskDraft,Converter={StaticResource BoolVisibility}}">
                  <Button Content="預覽差異並寫入" Click="WriteTask" />
                  <Button Content="刪除雲端任務" Click="DeleteTask" />
                </WrapPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border x:Name="SourceActions" Grid.Row="2" BorderBrush="{adaptive:AdaptiveBrush WorkspaceBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0" IsEnabled="{Binding CanAct}">
        <StackPanel>
          <StackPanel Visibility="{Binding IsSource,Converter={StaticResource BoolVisibility}}">
            <TextBlock ToolTip="{Binding Selected.Status}" TextTrimming="CharacterEllipsis" Foreground="{adaptive:AdaptiveBrush WorkspaceMuted}" FontSize="12" Margin="0,0,0,8">
              <Run Text="{Binding Selected.Status}" />
              <Run Text=" · 最後成功：" />
              <Run Text="{Binding Selected.LastSync}" />
            </TextBlock>
            <StackPanel Orientation="Horizontal" Visibility="{Binding HasSourceChanges,Converter={StaticResource BoolVisibility}}">
              <Button Content="捨棄變更" Click="DiscardSource" />
              <Button x:Name="SaveSourceButton" Click="SaveSource" IsEnabled="{Binding Selected.Editable}" Style="{StaticResource SettingsPrimary}">
                <TextBlock Text="儲存來源" Foreground="{adaptive:AdaptiveBrush AccentText}" />
              </Button>
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsOverview,Converter={StaticResource BoolVisibility}}">
            <Button Content="同步全部來源" Command="{Binding SyncSelectedCommand}" />
            <Button Content="更新狀態" Command="{Binding RefreshStatusCommand}" Style="{StaticResource WorkspaceQuietButton}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <DockPanel Grid.Row="3" Margin="0,8,0,0">
        <DockPanel.Style>
          <Style TargetType="DockPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Message}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DockPanel.Style>
        <Button DockPanel.Dock="Right" Content="取消操作" Command="{Binding CancelCommand}" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}" Margin="8,0,0,0" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="44">
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{adaptive:AdaptiveBrush #3664A0}" FontSize="12" />
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
