<Window x:Class="CloudAlarmOverlay.App.Views.TaskPreviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:CloudAlarmOverlay.App.Controls" xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles"
 Title="任務詳細訊息" Width="700" Height="700" MinWidth="420" MinHeight="360" WindowStartupLocation="CenterOwner"
 FontFamily="Segoe UI, Microsoft JhengHei UI" Background="{adaptive:AdaptiveBrush #F7FAFE}" Foreground="{adaptive:AdaptiveBrush #16243E}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/LightTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <DockPanel Margin="24">
  <Button DockPanel.Dock="Bottom" Content="關閉" IsCancel="True" HorizontalAlignment="Right" Padding="24,10" Margin="0,16,0,0"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="{Binding Notice}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,12"/>
   <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding HistoryDetails}" TextWrapping="Wrap" Margin="0,12,0,0"/>
   <Border Background="{adaptive:AdaptiveBrush #FFFFFF}" CornerRadius="12" Padding="18" Margin="0,18,0,0"><StackPanel>
    <TextBlock Text="詳細內容" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <controls:MarkdownView x:Name="DescriptionPreview" Text="{Binding Description, Mode=OneWay}" EditableTasks="False" Foreground="{adaptive:AdaptiveBrush #16243E}" FontSize="16"/>
   </StackPanel></Border>
   <Border Background="{adaptive:AdaptiveBrush #FFFFFF}" CornerRadius="12" Padding="18" Margin="0,12,0,0"><StackPanel>
    <TextBlock Text="補充說明／備註" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <controls:MarkdownView x:Name="NotePreview" Text="{Binding Note, Mode=OneWay}" EditableTasks="False" Foreground="{adaptive:AdaptiveBrush #16243E}" FontSize="16"/>
   </StackPanel></Border>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
