<Window x:Class="CloudAlarmOverlay.App.Views.CountdownEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
 xmlns:controls="clr-namespace:CloudAlarmOverlay.App.Controls"
 xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles"
 Title="{Binding EditorHeading}" Width="1120" Height="820" MinWidth="560" MinHeight="480"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 FontFamily="Segoe UI, Microsoft JhengHei UI" Background="{adaptive:AdaptiveBrush #F7FAFE}" Foreground="{adaptive:AdaptiveBrush #16243E}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../Styles/LightTheme.xaml"/>
  <ResourceDictionary Source="../Styles/CalendarStyles.xaml"/>
  <ResourceDictionary Source="../Styles/SlidingSegmentedControl.xaml"/>
  <ResourceDictionary Source="../Styles/CountdownStyles.xaml"/>
 </ResourceDictionary.MergedDictionaries>
  <Style x:Key="CountdownCalendar" TargetType="Calendar" BasedOn="{StaticResource EditorCalendar}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Calendar">
    <Border Background="{adaptive:AdaptiveBrush #FFFFFF}" BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,5,0,0">
     <StackPanel x:Name="PART_Root"><primitives:CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/></StackPanel>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
            <Style x:Key="DayCheck" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Pill" Background="{adaptive:AdaptiveBrush #F1F5FA}" BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="1" CornerRadius="12" Padding="6,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="Tick" Text="✓ " Foreground="{adaptive:AdaptiveBrush #3664A0}" Visibility="Collapsed"/>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Pill" Property="Background" Value="{adaptive:AdaptiveBrush #E6F0FF}"/><Setter TargetName="Pill" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #3664A0}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,10,0,6"/></Style>
  <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0"/></Style>
 </ResourceDictionary></Window.Resources>
 <Grid Margin="20,14,20,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
   <Border Background="{adaptive:AdaptiveBrush #E6F0FF}" CornerRadius="12" Padding="12" Margin="0,0,12,0"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{adaptive:AdaptiveBrush #0766FF}"/></Border>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding EditorHeading}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="倒數 / 紀念事件 · 記下每個值得期待的日子" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PreviewGap" Width="20"/><ColumnDefinition x:Name="PreviewColumn" Width="310"/></Grid.ColumnDefinitions>
   <Border Padding="0,0,10,0">
    <StackPanel x:Name="EditorCard">
     <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <TextBlock Text="1. 先選擇倒數／正數" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
     <Border Style="{StaticResource SectionCard}"><StackPanel>
      <controls:SlidingSegmentedControl x:Name="DirectionSelector" ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}" Style="{StaticResource PillSlidingSegmentedControl}" Width="280" HorizontalAlignment="Left" FontSize="16" AutomationProperties.Name="計數方向"/>
      <TextBlock x:Name="DirectionHint" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
       <Setter Property="Text" Value="倒數至目標日期／時間；設定重複後，顯示下一次目標，依提醒設定通知。"/>
       <Style.Triggers><DataTrigger Binding="{Binding IsCountUp}" Value="True"><Setter Property="Text" Value="正數從起始日期持續累計；重複設定僅用於提醒，不重設累計時間。"/></DataTrigger></Style.Triggers>
      </Style></TextBlock.Style></TextBlock>
     </StackPanel></Border>
     <TextBlock Text="2. 基本資訊" Style="{StaticResource SectionTitle}"/>
     <Border Style="{StaticResource SectionCard}"><WrapPanel>
      <StackPanel Width="310" Margin="0,0,14,4"><TextBlock Text="事件名稱"/><TextBox x:Name="EventTitle" Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Margin="0,4,0,0" AutomationProperties.Name="倒數名稱"/></StackPanel>
      <StackPanel Margin="0,0,0,4"><TextBlock Text="分類" Margin="0,0,0,4"/><controls:SlidingSegmentedControl ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" MinWidth="300" HorizontalAlignment="Left" AutomationProperties.Name="事件分類"/></StackPanel>
     </WrapPanel></Border>

     <TextBlock Text="3. 日期與時間" Style="{StaticResource SectionTitle}"/>
     <Border Style="{StaticResource SectionCard}"><StackPanel>     <WrapPanel>
      <StackPanel Margin="0,0,12,6" Width="140"><TextBlock Text="時間精度" Margin="0,0,0,4"/>
       <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" AutomationProperties.Name="時間精度"><ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="日期"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="倒數時間"><Setter Property="Text" Value="日期與時間"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      </StackPanel>
      <StackPanel Margin="0,0,12,6" Width="180"><TextBlock Text="{Binding DateLabel}" Margin="0,0,0,4"/>
       <DatePicker x:Name="TargetDatePicker" SelectedDate="{Binding TargetDate}" Style="{StaticResource HistoryDatePicker}" CalendarStyle="{StaticResource CountdownCalendar}" Height="38" AutomationProperties.Name="倒數目標日期"/>
      </StackPanel>
      <StackPanel Margin="0,0,0,6" Width="130" IsEnabled="{Binding IsTimeMode}">
       <TextBlock Text="時間（24 小時制）" Margin="0,0,0,4"/>
       <controls:TimeInput Text="{Binding TargetTime,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="倒數時間 HH:mm"/>
      </StackPanel>
     </WrapPanel>
<TextBlock Text="日期模式視為整天事件；需要精確時間時，選擇日期與時間。" Style="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
     <TextBlock Text="4. 重複與提醒" Style="{StaticResource SectionTitle}"/>
     <Border Style="{StaticResource SectionCard}"><StackPanel>     <WrapPanel>
      <StackPanel Width="140" Margin="0,0,12,6"><TextBlock Text="重複設定" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Repeats}" SelectedItem="{Binding Repeat}" AutomationProperties.Name="重複設定"/></StackPanel>
      <StackPanel Width="180" Margin="0,0,12,6"><TextBlock Text="提醒設定" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Reminders}" SelectedItem="{Binding Reminder}" AutomationProperties.Name="提醒提前天數"/></StackPanel>
      <StackPanel Width="130" IsEnabled="{Binding HasReminder}" Margin="0,0,0,6">
       <TextBlock Text="提醒時間（HH:mm）" Margin="0,0,0,4"/>
       <controls:TimeInput Text="{Binding ReminderTime,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="自訂提醒時間"/>
      </StackPanel>
     </WrapPanel>
     <StackPanel Visibility="{Binding IsWeekly,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6">
      <TextBlock Text="選擇星期（可複選）" Margin="0,0,0,4"/>
      <ItemsControl ItemsSource="{Binding Weekdays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Style="{StaticResource DayCheck}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
     <StackPanel Visibility="{Binding IsMonthly,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6">
      <TextBlock Text="提醒月份（可複選）" Margin="0,0,0,4"/>
      <ItemsControl ItemsSource="{Binding Months}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Style="{StaticResource DayCheck}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="每月日期（單選；沒有該日的月份略過）" Margin="0,6,0,6"/><ComboBox ItemsSource="{Binding MonthDays}" SelectedItem="{Binding MonthDay}" Width="130" HorizontalAlignment="Left"/>
     </StackPanel>
     <StackPanel Visibility="{Binding IsLunar,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6">
      <TextBlock Text="每月農曆日期（可複選，如初一、十五）" Margin="0,0,0,4"/>
      <ItemsControl ItemsSource="{Binding LunarDays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Style="{StaticResource DayCheck}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="與任務提醒相同，使用已同步的農曆日期；缺少資料時不推測提醒日期。" Style="{StaticResource Muted}" FontSize="12"/>
     </StackPanel>
          <StackPanel Visibility="{Binding IsAnnual,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6">
      <TextBlock Text="每年國曆月日（紀念日／生日）" Margin="0,0,0,4"/>
      <controls:MonthDayPicker x:Name="AnnualDatePicker" Month="{Binding AnnualMonth}" Day="{Binding AnnualDay}" Width="280" HorizontalAlignment="Left" Margin="0,4,0,8"/>
      <TextBlock Text="從開始日期起，每年在此月日提醒一次；2 月 29 日只在閏年提醒。" Style="{StaticResource Muted}" FontSize="12"/>
     </StackPanel>
<StackPanel Visibility="{Binding IsLunarDate,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,6">
      <TextBlock Text="每年農曆月日（例如神明生日）" Margin="0,0,0,4"/>
      <WrapPanel>
       <StackPanel Width="140" Margin="0,0,18,8"><TextBlock Text="農曆月"/><ComboBox ItemsSource="{Binding LunarMonths}" SelectedItem="{Binding LunarMonth}" AutomationProperties.Name="農曆月份"/></StackPanel>
       <StackPanel Width="140" Margin="0,0,0,8"><TextBlock Text="農曆日"/><ComboBox ItemsSource="{Binding LunarDates}" SelectedItem="{Binding LunarDate}" AutomationProperties.Name="農曆日期"/></StackPanel>
      </WrapPanel>
      <CheckBox Content="閏月也提醒（預設只在一般月份提醒）" IsChecked="{Binding IncludeLeapMonth}" Margin="0,0,0,4"/>
      <TextBlock Text="依國曆開始日期尋找下一次農曆月日；當年沒有該日便略過。" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
     </StackPanel>
</StackPanel></Border>
     <TextBlock Text="5. 顯示設定" Style="{StaticResource SectionTitle}"/>
     <Border Style="{StaticResource SectionCard}"><StackPanel>     <WrapPanel>
      <StackPanel Width="360" Margin="0,0,0,6"><TextBlock Text="顯示方式" Margin="0,0,0,4"/><controls:SlidingSegmentedControl ItemsSource="{Binding DisplayFormats}" SelectedItem="{Binding DisplayFormat}" AutomationProperties.Name="日期顯示方式"/></StackPanel>
     </WrapPanel>
</StackPanel></Border>
     <TextBlock Text="6. 其他選項" Style="{StaticResource SectionTitle}"/>
     <Border Style="{StaticResource SectionCard}" Margin="0,0,0,8"><StackPanel>
     <CheckBox Content="釘選到首頁（最多 2 項）" IsChecked="{Binding PinOnHome}" Style="{StaticResource PillSwitch}" Margin="0,0,0,8"/>
     <CheckBox Content="假日不提醒（與任務提醒共用假日資料）" IsChecked="{Binding SkipOnHoliday}" Style="{StaticResource PillSwitch}" Margin="0,0,0,8"/>
     <TextBlock Text="使用一般提醒通知；請保持程式執行。當天提醒不可晚於倒數時間。" Visibility="{Binding HasReminder,Converter={StaticResource BoolVisibility}}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4"/>
     <TextBlock Text="備註（選填）" Margin="0,0,0,4"/>
     <TextBox Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Height="56" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6" AutomationProperties.Name="倒數備註"/>
</StackPanel></Border>
    </StackPanel>
   </Border>
   <Border x:Name="PreviewPanel" Grid.Column="2" VerticalAlignment="Top">
    <Border Background="{adaptive:AdaptiveBrush #F1F5FA}" CornerRadius="18" Padding="18">
     <StackPanel>
      <TextBlock Text="預覽效果" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBlock Text="子功能頁卡片預覽" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10"/>
      <Border CornerRadius="14" BorderThickness="1" Padding="0">
       <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{adaptive:AdaptiveBrush #FFFFFF}"/><Setter Property="BorderBrush" Value="{adaptive:AdaptiveBrush #DEE6F1}"/><Style.Triggers><DataTrigger Binding="{Binding Content.StatusLabel,ElementName=PreviewCard}" Value="即將到來"><Setter Property="Background" Value="{adaptive:AdaptiveBrush #FFF3F5}"/><Setter Property="BorderBrush" Value="{adaptive:AdaptiveBrush #E4A6B5}"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <Grid><Border BorderBrush="{adaptive:AdaptiveBrush #0766FF}" BorderThickness="4,0,0,0" CornerRadius="14" Margin="-1" IsHitTestVisible="False"/>
        <ContentControl x:Name="PreviewCard" ContentTemplate="{StaticResource CountdownCardBody}" Margin="14,9,10,9"/>
       </Grid>
      </Border>
      <TextBlock x:Name="PreviewError" TextWrapping="Wrap" Foreground="{adaptive:AdaptiveBrush #B13C5A}" Margin="0,8,0,8" AutomationProperties.LiveSetting="Polite"/>
      <Border BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="1" CornerRadius="12" Padding="14"><StackPanel>
       <TextBlock Text="小提示" FontWeight="SemiBold" Margin="0,0,0,10"/>
       <TextBlock Text="每年國曆適合生日與紀念日；每年農曆適合傳統節日。" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
       <TextBlock Text="正數持續累計已過時間；重複提醒不會重設起始日。" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
       <TextBlock Text="首頁最多釘選 2 項，預覽內容會隨設定更新。" Style="{StaticResource Muted}"/>
      </StackPanel></Border>
     </StackPanel>
    </Border>
   </Border>
  </Grid></ScrollViewer>
  <Border Grid.Row="2" BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消" IsCancel="True" Padding="20,9"/><Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Style="{StaticResource Primary}" Padding="24,9" Margin="0"/></StackPanel>
  </Grid></Border>
 </Grid>
</Window>
