<UserControl x:Class="CloudAlarmOverlay.App.Views.TaskCalendarView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CloudAlarmOverlay.App.Views" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/LightTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <local:CalendarHeightConverter x:Key="CalendarHeight"/>
  <local:CalendarEntrySelectedConverter x:Key="CalendarEntrySelected"/>
  <Style x:Key="AgendaButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Tag"><Setter.Value><MultiBinding Converter="{StaticResource CalendarEntrySelected}"><Binding/><Binding Path="DataContext.TaskCalendar.Selected" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Setter.Value></Setter>
   <Setter Property="ToolTip" Value="雙擊查看詳細資料"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{adaptive:AdaptiveBrush #EAF3FF}"/></Trigger><Trigger Property="Tag"><Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value><Setter TargetName="Surface" Property="Background" Value="{adaptive:AdaptiveBrush #E6F0FF}"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/><Setter TargetName="Surface" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="1"/><Setter TargetName="Surface" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <local:CalendarDateSelectedConverter x:Key="CalendarDateSelected"/>
  <Style x:Key="DayFocusVisual"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border Margin="3" CornerRadius="8" BorderThickness="1" BorderBrush="{adaptive:AdaptiveBrush #0766FF}"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="DayButton" TargetType="Button">
   <Setter Property="FocusVisualStyle" Value="{StaticResource DayFocusVisual}"/>
   <Setter Property="Background" Value="{adaptive:AdaptiveBrush #FFFFFF}"/>
   <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Top"/>
   <Setter Property="Tag"><Setter.Value><MultiBinding Converter="{StaticResource CalendarDateSelected}"><Binding Path="Date"/><Binding Path="DataContext.TaskCalendar.SelectedDay" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{adaptive:AdaptiveBrush #E1E8F1}" BorderThickness="0,0,1,1"/>
     <!-- Selected day: a faint rounded tint (lighter than event bars) inset from the grid lines, beneath the day's content. -->
     <Grid x:Name="SelectionLayer" Margin="3,3,4,4" Visibility="Collapsed" IsHitTestVisible="False">
      <Border CornerRadius="8" Background="{adaptive:AdaptiveBrush #0766FF}" Opacity="0.06"/>
      <Border x:Name="SelectionFrame" CornerRadius="8" BorderThickness="1" BorderBrush="{adaptive:AdaptiveBrush #0766FF}"/>
     </Grid>
     <ContentPresenter Margin="6" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{adaptive:AdaptiveBrush #EAF3FF}"/></Trigger>
     <Trigger Property="Tag"><Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value><Setter TargetName="SelectionLayer" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><DataTrigger Binding="{Binding InMonth}" Value="False"><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #8391A5}"/></DataTrigger><DataTrigger Binding="{Binding IsRedDay}" Value="True"><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush CalendarHolidayText}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="EventButton" TargetType="Button"><Setter Property="Padding" Value="5,1"/><Setter Property="Margin" Value="3,2"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="{adaptive:AdaptiveBrush #E6F0FF}"/><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #3664A0}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="EventBorder" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding Foreground}" BorderThickness="2,0,0,0"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="EventBorder" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EventBorder" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding Entry.AllDay}" Value="True"><Setter Property="Background" Value="{adaptive:AdaptiveBrush #E3F6ED}"/><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #167D59}"/></DataTrigger></Style.Triggers></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid DataContext="{Binding TaskCalendar}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
  <DockPanel>
   <DockPanel DockPanel.Dock="Top" Margin="0,6,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="‹" Command="{Binding PreviousMonthCommand}" AutomationProperties.Name="上個月"/><Button Content="今天" Command="{Binding TodayCommand}" Click="ShowSelectedDay"/><Button Content="›" Command="{Binding NextMonthCommand}" AutomationProperties.Name="下個月" Margin="0"/></StackPanel><TextBlock Text="{Binding MonthLabel}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Style="{StaticResource Muted}" FontSize="11" Margin="0,8"/>
   <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Weekdays}" Margin="0,0,0,6"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
    <TextBlock Text="{Binding ShortLabel}" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/><Style.Triggers><DataTrigger Binding="{Binding IsWeekend}" Value="True"><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush CalendarHolidayText}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <ScrollViewer x:Name="MonthScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Weeks}"><ItemsControl.Height><MultiBinding Converter="{StaticResource CalendarHeight}"><Binding ElementName="MonthScroll" Path="ActualHeight"/><Binding Path="Weeks.Count"/></MultiBinding></ItemsControl.Height><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
    <Grid>
     <ItemsControl ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Button Style="{StaticResource DayButton}" Command="{Binding DataContext.TaskCalendar.SelectDayCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Date}" ToolTip="{Binding Label}">
       <StackPanel>
        <DockPanel><Border DockPanel.Dock="Right" CornerRadius="10" Padding="5,0" MinWidth="20"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Today}" Value="True"><Setter Property="Background" Value="{adaptive:AdaptiveBrush #D9E8FA}"/></DataTrigger><DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Background" Value="{adaptive:AdaptiveBrush #0766FF}"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Number}" FontSize="12" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/><Style.Triggers><DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #FFFFFF}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border><TextBlock Text="{Binding LunarLabel}" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
        <TextBlock Text="{Binding HolidayName}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush CalendarHolidayText}"/><Style.Triggers><DataTrigger Binding="{Binding IsMakeupDay}" Value="True"><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #536982}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <TextBlock Text="{Binding SolarTerm}" Foreground="{adaptive:AdaptiveBrush #167D59}" FontSize="10" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <ItemsControl ItemsSource="{Binding Segments}" Margin="0,54,0,16"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions></Grid></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Grid.Column" Value="{Binding Column}"/><Setter Property="Grid.ColumnSpan" Value="{Binding Span}"/><Setter Property="Grid.Row" Value="{Binding Lane}"/></Style></ItemsControl.ItemContainerStyle><ItemsControl.ItemTemplate><DataTemplate>
      <Button Style="{StaticResource EventButton}" MouseDoubleClick="PreviewEntry" Command="{Binding DataContext.TaskCalendar.SelectEventCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Entry}" ToolTip="{Binding Entry.PreviewHint}" AutomationProperties.Name="{Binding Entry.Title}"><TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <ItemsControl ItemsSource="{Binding Days}" VerticalAlignment="Bottom" Height="16"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding More}" Command="{Binding DataContext.TaskCalendar.SelectDayCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Date}" FontSize="10" Background="Transparent" BorderThickness="0" Padding="2" Margin="0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </Grid>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  </DockPanel>
  <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" Margin="0" VerticalAlignment="Stretch"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <StackPanel x:Name="DayDetails">
    <TextBlock Text="當日工作" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding DayLabel}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,4"/>
    <TextBlock Text="{Binding DayAlmanac}" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,14"/>
    <ItemsControl x:Name="DayActivities" ItemsSource="{Binding DayEvents}"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource AgendaButton}" MouseDoubleClick="PreviewEntry" Command="{Binding DataContext.TaskCalendar.SelectEventCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,0,6" Padding="8,6" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{adaptive:AdaptiveBrush #16243E}"/><TextBlock Text="{Binding Period}" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="當日沒有其他活動。" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DayEvents.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <StackPanel Visibility="{Binding HasDayRoutines,Converter={StaticResource BoolVisibility}}" Margin="0,14,0,0">
     <DockPanel Margin="0,0,0,8"><TextBlock DockPanel.Dock="Right" Text="{Binding DayRoutines.Count}" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Text="日常任務" FontSize="12" FontWeight="SemiBold"/></DockPanel>
     <ItemsControl x:Name="DayRoutineList" ItemsSource="{Binding DayRoutines}"><ItemsControl.ItemTemplate><DataTemplate>
      <Button Style="{StaticResource AgendaButton}" MouseDoubleClick="PreviewEntry" Command="{Binding DataContext.TaskCalendar.SelectEventCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="6,5" Margin="0,0,0,3" Background="Transparent" BorderThickness="0">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding TimeLabel}" FontSize="12" Foreground="{adaptive:AdaptiveBrush #536982}" VerticalAlignment="Top"/>
        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="12" Foreground="{adaptive:AdaptiveBrush #16243E}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding RoutineHint}" Style="{StaticResource Muted}" FontSize="10"/></StackPanel>
       </Grid>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
    <TextBlock Text="點選項目可標示，雙擊開啟詳細資料。" Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <Button Content="＋ 在這天新增活動" Command="{Binding DataContext.NewActivityCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding SelectedDay}" Margin="0,10,0,0" Padding="8,6"/>
   </StackPanel>
  </StackPanel></ScrollViewer></Border>
 </Grid>
</UserControl>
