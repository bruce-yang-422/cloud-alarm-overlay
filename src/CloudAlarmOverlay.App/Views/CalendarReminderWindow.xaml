<Window x:Class="CloudAlarmOverlay.App.Views.CalendarReminderWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
 xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles" Title="Google 日曆提醒設定"
 Width="520" Height="570" MinHeight="440" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize" WindowStyle="None"
 Background="{adaptive:AdaptiveBrush #F7FAFE}" Foreground="{adaptive:AdaptiveBrush #16243E}" FontSize="13" FontFamily="Segoe UI, Microsoft JhengHei UI">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="12"/></WindowChrome.WindowChrome>
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/SettingsFormStyles.xaml"/><ResourceDictionary Source="../Styles/CalendarStyles.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="ReminderCalendar" TargetType="Calendar" BasedOn="{StaticResource EditorCalendar}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Calendar">
     <Border Background="{adaptive:AdaptiveBrush #FFFFFF}" BorderBrush="{adaptive:AdaptiveBrush #D6E1EF}" BorderThickness="1" CornerRadius="10" Padding="12">
      <StackPanel x:Name="PART_Root"><p:CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/></StackPanel>
     </Border>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="ReminderDateField" TargetType="DatePicker">
    <Setter Property="CalendarStyle" Value="{StaticResource ReminderCalendar}"/>
    <Setter Property="SelectedDateFormat" Value="Short"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker">
     <Border x:Name="Field" CornerRadius="7" Background="{adaptive:AdaptiveBrush #FDFEFF}" BorderBrush="{adaptive:AdaptiveBrush #D6E1EF}" BorderThickness="1">
      <Grid Margin="10,0,3,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
       <p:DatePickerTextBox x:Name="PART_TextBox" FontSize="13" Foreground="{adaptive:AdaptiveBrush #16243E}" CaretBrush="{adaptive:AdaptiveBrush #16243E}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0" VerticalContentAlignment="Center">
        <p:DatePickerTextBox.Template><ControlTemplate TargetType="p:DatePickerTextBox"><ScrollViewer x:Name="PART_ContentHost"/></ControlTemplate></p:DatePickerTextBox.Template>
       </p:DatePickerTextBox>
       <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource CalendarNavButton}" Width="32" Height="32" AutomationProperties.Name="選擇提醒日期" ToolTip="選擇日期">
        <Path Data="M3,5 L21,5 21,21 3,21 Z M3,10 L21,10 M8,2 L8,7 M16,2 L16,7 M7,14 L10,14 M14,14 L17,14 M7,17 L10,17" Width="18" Height="18" Stretch="Uniform" Stroke="{adaptive:AdaptiveBrush #0766FF}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
       </Button>
       <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value=".45"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </Window.Resources>
 <Border BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="1" CornerRadius="12" Padding="24">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,18" MouseLeftButtonDown="DragHeader">
    <Border DockPanel.Dock="Right" VerticalAlignment="Center" Background="{adaptive:AdaptiveBrush #E6F0FF}" CornerRadius="10" Padding="9,4"><TextBlock Text="本機提醒" Foreground="{adaptive:AdaptiveBrush #0766FF}" FontSize="11"/></Border>
    <TextBlock Text="日曆提醒設定" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </DockPanel>
   <ScrollViewer x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Editor">
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Width="32" Height="36" VerticalAlignment="Top" Background="{adaptive:AdaptiveBrush #E6F0FF}" CornerRadius="8">
      <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{adaptive:AdaptiveBrush #0766FF}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
     </Border>
     <StackPanel Grid.Column="1"><TextBlock x:Name="EventTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="EventStart" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
    </Grid>
    <Border Style="{StaticResource SettingsGroup}" Padding="16" Margin="0,0,0,18"><StackPanel>
     <CheckBox x:Name="ReminderEnabled" Content="提醒我" FontWeight="SemiBold" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="啟用此日曆行程提醒"/>
     <Border Height="1" Background="{adaptive:AdaptiveBrush #E8EDF4}" Margin="0,13,0,13"/>
     <Grid IsEnabled="{Binding IsChecked,ElementName=ReminderEnabled}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="132"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="日期" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/><DatePicker x:Name="ReminderDate" Style="{StaticResource ReminderDateField}" AutomationProperties.Name="提醒日期"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="時間 · 24 小時制" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/><TextBox x:Name="ReminderTime" Height="40" Margin="0" Padding="10,2" MaxLength="8" AutomationProperties.Name="提醒時間" ToolTip="輸入時間，例如 09:30 或 09:30:00"/></StackPanel>
     </Grid>
     <TextBlock Text="依這台電腦的當地時間提醒" Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
    </StackPanel></Border>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="Google 同步設定" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="恢復設定後，提醒開關與時間會重新跟隨 Google。多個彈出式提醒採用最早一個；電子郵件提醒不轉成桌面提醒。"/>
     <TextBlock x:Name="ReminderMode" Grid.Column="1" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
    </Grid>
    <Border Style="{StaticResource SettingsGroup}" Padding="14" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="GoogleDefaults" TextWrapping="Wrap" FontSize="13"/><TextBlock Text="最近一次同步的提醒參數" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
     <Button x:Name="ResetButton" Grid.Column="1" Content="恢復設定" Click="Reset" VerticalAlignment="Center" Margin="0" ToolTip="立即恢復最近同步的 Google 提醒開關與時間，並關閉此視窗。" AutomationProperties.Name="恢復 Google 設定"/>
    </Grid></Border>
    <TextBlock Text="自訂提醒只套用於本程式，後續同步會保留你的調整。" Style="{StaticResource Muted}" FontSize="12" LineHeight="19"/>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,14,0,0"><StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="{adaptive:AdaptiveBrush #BA3D45}" TextWrapping="Wrap">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,10"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="取消" IsCancel="True" MinWidth="76" Height="36"/><Button x:Name="SaveButton" Click="Save" Style="{StaticResource SettingsPrimary}" IsDefault="True" MinWidth="96" Height="36" Margin="0"><TextBlock Text="儲存提醒" Foreground="{adaptive:AdaptiveBrush AccentText}"/></Button></StackPanel>
   </StackPanel></Border>
  </Grid>
 </Border>
</Window>
