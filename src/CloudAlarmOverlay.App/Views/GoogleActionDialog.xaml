<Window x:Class="CloudAlarmOverlay.App.Views.GoogleActionDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles" Width="460" SizeToContent="Height" ResizeMode="NoResize"
 WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="13" Background="{adaptive:AdaptiveBrush #F7FAFE}">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="12"/></WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/SettingsFormStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="1" Padding="28" CornerRadius="12" Background="{adaptive:AdaptiveBrush #F7FAFE}">
  <StackPanel>
   <Grid MouseLeftButtonDown="DragHeader" Margin="0,0,0,18">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="44" Height="44" CornerRadius="12" Background="{adaptive:AdaptiveBrush #E6F0FF}" Margin="0,0,14,0">
     <TextBlock x:Name="Symbol" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{adaptive:AdaptiveBrush #0766FF}" HorizontalAlignment="Center"/>
    </Border>
    <TextBlock x:Name="Heading" Grid.Column="1" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
   </Grid>
   <Border x:Name="SubjectCard" Style="{StaticResource SettingsGroup}" Padding="12,10" Margin="0,0,0,14">
    <TextBlock x:Name="Subject" FontWeight="SemiBold" TextWrapping="Wrap"/>
   </Border>
   <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260"><TextBlock x:Name="Description" Style="{StaticResource Muted}"/></ScrollViewer>
   <Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="CancelButton" Grid.Column="1" Content="取消" IsCancel="True" IsDefault="True" MinWidth="82"/>
    <Button x:Name="ConfirmButton" Grid.Column="2" MinWidth="100" Click="Confirm" Margin="0"/>
   </Grid>
  </StackPanel>
 </Border>
</Window>
