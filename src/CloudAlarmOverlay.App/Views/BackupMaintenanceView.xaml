<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CloudAlarmOverlay.App.Views.BackupMaintenanceView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles/AdminWorkspaceStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="本機資料" Style="{StaticResource WorkspaceSection}" />
    <Border Style="{StaticResource AdminCard}">
      <StackPanel>
        <TextBlock Text="備份與還原 · .calbak" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Text="保存本機任務、允許還原的個人設定、裝置身分與相關紀錄。重複任務保留本機版本。" Style="{StaticResource AdminResult}" />
        <WrapPanel Margin="0,16,0,0">
          <Button Content="建立備份…" Click="ExportBackup" />
          <Button Content="選擇備份還原…" Click="ImportBackup" />
        </WrapPanel>
        <Expander Header="進階備份選項" Margin="0,14,0,0" FontSize="12" Visibility="{Binding IsCompanyMode,Converter={StaticResource BoolVisibility}}">
          <CheckBox x:Name="IncludeAdmin" Content="備份包含管理者帳密（需驗證）" Margin="0,10,0,0" />
        </Expander>
        <TextBlock Text="不包含 Google 登入憑證，也不是完整資料庫鏡像。" Style="{StaticResource AdminResult}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
