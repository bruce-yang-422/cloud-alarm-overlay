<Window x:Class="CloudAlarmOverlay.App.Views.AlarmWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CloudAlarmOverlay.App.Controls" Title="提醒" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Background="{DynamicResource NoticeBackground}" Foreground="{DynamicResource NoticeText}" FontSize="16" FontFamily="Segoe UI, Microsoft JhengHei UI">
<Window.Resources><ResourceDictionary>
<ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/LightTheme.xaml"/></ResourceDictionary.MergedDictionaries>
<SolidColorBrush x:Key="NoticeBackground" Color="#EDF7F2"/><SolidColorBrush x:Key="NoticeSurface" Color="#FFFFFF"/>
<SolidColorBrush x:Key="NoticeText" Color="#20324A"/><SolidColorBrush x:Key="NoticeMuted" Color="#52647A"/>
<SolidColorBrush x:Key="NoticeAccent" Color="#14715E"/><SolidColorBrush x:Key="NoticeButtonText" Color="#FFFFFF"/>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource NoticeText}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
</ResourceDictionary></Window.Resources>
<Border Background="{DynamicResource NoticeBackground}" x:Name="Frame" BorderBrush="{DynamicResource NoticeAccent}" BorderThickness="2" Padding="24">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,18"><Border Background="{DynamicResource NoticeSurface}" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left"><TextBlock Text="{Binding Caption}" Foreground="{DynamicResource NoticeAccent}" FontSize="13" FontWeight="SemiBold"/></Border></DockPanel>
<Grid x:Name="ContentSlot" Grid.Row="1"><Grid x:Name="NoticeBody" MaxWidth="760" VerticalAlignment="Center">
<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ScrollViewer x:Name="NoticeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel x:Name="Panel" MaxWidth="850">
<TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18"/>
<StackPanel Visibility="{Binding HasDescription,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,16">
<TextBlock Text="詳細內容" Foreground="{DynamicResource NoticeMuted}" FontSize="12" Margin="0,0,0,6"/>
<controls:MarkdownView x:Name="DescriptionText" Text="{Binding Description}" FontSize="17" Foreground="{DynamicResource NoticeText}"/>
</StackPanel>
<Border Background="{DynamicResource NoticeSurface}" CornerRadius="10" Padding="14" Margin="0,0,0,16" Visibility="{Binding HasNote,Converter={StaticResource BoolVisibility}}">
<StackPanel><TextBlock Text="補充說明及備註" Foreground="{DynamicResource NoticeMuted}" FontSize="12" Margin="0,0,0,6"/>
<controls:MarkdownView x:Name="NoteText" Text="{Binding Note}" FontSize="16" Foreground="{DynamicResource NoticeText}"/></StackPanel>
</Border>
<StackPanel Visibility="{Binding RequiresCode,Converter={StaticResource BoolVisibility}}">
<TextBlock Text="{Binding Code}" FontSize="42" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,8"/>
<TextBox x:Name="CodeInput" Text="{Binding Input,UpdateSourceTrigger=PropertyChanged}" FontSize="24" HorizontalContentAlignment="Center" MaxWidth="350" MaxLength="11" Background="{DynamicResource NoticeSurface}" Foreground="{DynamicResource NoticeText}" CaretBrush="{DynamicResource NoticeText}" AutomationProperties.Name="9 位數字閱讀確認碼，可省略連字號" InputMethod.IsInputMethodEnabled="False"/>
<TextBlock Text="{Binding Error}" Foreground="{DynamicResource NoticeAccent}" HorizontalAlignment="Center"/>
</StackPanel>
</StackPanel></ScrollViewer>
<StackPanel x:Name="Actions" Grid.Row="1" Margin="0,24,0,0">
<TextBlock Text="{Binding Instruction}" TextAlignment="Center" Foreground="{DynamicResource NoticeMuted}" FontSize="12" Margin="0,0,0,10"/>
<StackPanel Visibility="{Binding CanSnooze,Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Center" Margin="0,0,0,10">
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ComboBox ItemsSource="{Binding SnoozeChoices}" SelectedItem="{Binding SnoozeMinutes}" Width="70"/><TextBlock Text="分鐘後" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource NoticeMuted}"/></StackPanel>
<Button Content="{Binding SnoozeLabel}" Command="{Binding SnoozeCommand}" Margin="0,6,0,0" Padding="10,8"/>
</StackPanel><Button x:Name="ConfirmButton" Content="我已閱讀，確認" Command="{Binding ConfirmCommand}" Background="{DynamicResource NoticeAccent}" Foreground="{DynamicResource NoticeButtonText}" HorizontalAlignment="Center" MinWidth="200" MaxWidth="280" Padding="32,12" MinHeight="48" Margin="0"/>
</StackPanel>
</Grid></Grid></Grid></Border></Window>