<Window x:Class="CloudAlarmOverlay.App.Views.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CloudAlarmOverlay.App.Controls"
        Title="提醒通知" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="{DynamicResource NoticeBackground}"
        Foreground="{DynamicResource NoticeText}" FontSize="16" FontFamily="Segoe UI, Microsoft JhengHei UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/LightTheme.xaml"/></ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="NoticeBackground" Color="#EDF7F2"/>
            <SolidColorBrush x:Key="NoticeSurface" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="NoticeText" Color="#20324A"/>
            <SolidColorBrush x:Key="NoticeMuted" Color="#52647A"/>
            <SolidColorBrush x:Key="NoticeAccent" Color="#14715E"/>
            <SolidColorBrush x:Key="NoticeButtonText" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="NoticeLine" Color="#DCE9E6"/>
            <Style x:Key="NoticeCombo" TargetType="ComboBox">
                <Setter Property="Foreground" Value="{DynamicResource NoticeText}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Background="{DynamicResource NoticeSurface}" BorderBrush="{TemplateBinding BorderBrush}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11">
                                                <Path Data="M 0,0 L 4,4 8,0" Stroke="{DynamicResource NoticeMuted}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border Background="{DynamicResource NoticeSurface}" BorderBrush="{DynamicResource NoticeLine}" BorderThickness="1" CornerRadius="10" Padding="4" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource NoticeAccent}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush" Value="{DynamicResource NoticeLine}"/>
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource NoticeText}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="NoticeButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource NoticeSurface}"/>
                <Setter Property="Foreground" Value="{DynamicResource NoticeAccent}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource NoticeLine}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="18,12"/>
                <Setter Property="MinHeight" Value="46"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value=".82"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value=".65"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource NoticeAccent}"/><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value=".45"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NoticeActionButton" TargetType="Button" BasedOn="{StaticResource NoticeButton}">
                <Setter Property="Background" Value="{DynamicResource NoticeAccent}"/>
                <Setter Property="Foreground" Value="{DynamicResource NoticeButtonText}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CanComplete}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource NoticeSurface}"/>
                        <Setter Property="Foreground" Value="{DynamicResource NoticeText}"/>
                        <Setter Property="MinWidth" Value="140"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="12" Background="{DynamicResource NoticeSurface}" x:Name="Frame" BorderBrush="{DynamicResource NoticeLine}" BorderThickness="1" CornerRadius="22">
        <Border.Effect><DropShadowEffect Color="#193F3A" BlurRadius="22" ShadowDepth="5" Opacity=".16"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource NoticeBackground}" BorderBrush="{DynamicResource NoticeLine}" BorderThickness="0,0,0,1" CornerRadius="21,21,0,0" Padding="24,18" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource NoticeSurface}" CornerRadius="13" Width="44" Height="44" Margin="0,0,14,0">
                        <Viewbox Width="26" Height="26"><Path Data="M 4,17 C 6,15 6,12 6,9 C 6,1 18,1 18,9 C 18,12 18,15 20,17 L 20,19 L 4,19 Z M 10,22 L 14,22" Stroke="{DynamicResource NoticeAccent}" StrokeThickness="1.7" StrokeLineJoin="Round"/></Viewbox>
                    </Border>
                    <TextBlock Grid.Column="1" Text="提醒通知" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Background="{DynamicResource NoticeSurface}" CornerRadius="18" Padding="12,7" VerticalAlignment="Center" MaxWidth="210">
                        <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource NoticeAccent}" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>
            <Grid x:Name="ContentSlot" Grid.Row="1">
                <Grid x:Name="NoticeBody">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer x:Name="NoticeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0" Margin="0,0,0,4">
                        <StackPanel x:Name="Panel" Margin="30,26,30,20">
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="TitleIcon" Width="64" Height="64" Background="{DynamicResource NoticeBackground}" CornerRadius="18" VerticalAlignment="Top" Margin="0,2,20,0">
                                    <Viewbox x:Name="TitleIconArtwork" Width="32" Height="32" ToolTip="{Binding Icon.Label}" AutomationProperties.Name="{Binding Icon.Label}">
                                        <Grid Width="26" Height="26"><Path x:Name="TaskIconPath" Data="{Binding Icon.PathData}" Margin="1" Stroke="{DynamicResource NoticeAccent}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding SourceLabel}" Foreground="{DynamicResource NoticeMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="NoticeTitle" Text="{Binding Title}" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding ReminderTimeLabel}" Foreground="{DynamicResource NoticeMuted}" FontSize="13"/>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="MessageCard" Background="{DynamicResource NoticeBackground}" BorderBrush="{DynamicResource NoticeLine}" BorderThickness="1" CornerRadius="16" Padding="22" MinHeight="130">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource NoticeAccent}" Opacity=".5" CornerRadius="2"/>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                        <TextBlock Text="通知內容" Foreground="{DynamicResource NoticeMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                        <controls:MarkdownView x:Name="DescriptionText" Text="{Binding Description}" Visibility="{Binding HasDescription,Converter={StaticResource BoolVisibility}}" FontSize="17" Foreground="{DynamicResource NoticeText}"/>
                                        <TextBlock Text="此提醒沒有附加內容。" Foreground="{DynamicResource NoticeMuted}" Visibility="{Binding HasNoDescription,Converter={StaticResource BoolVisibility}}"/>
                                        <StackPanel Visibility="{Binding HasNote,Converter={StaticResource BoolVisibility}}" Margin="0,16,0,0">
                                            <TextBlock Text="補充說明及備註" Foreground="{DynamicResource NoticeMuted}" FontSize="13" Margin="0,0,0,8"/>
                                            <controls:MarkdownView x:Name="NoteText" Text="{Binding Note}" FontSize="16" Foreground="{DynamicResource NoticeText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="ReadingHint" Text="•  內容較長時，可在此區域捲動閱讀。" Foreground="{DynamicResource NoticeMuted}" FontSize="12" Margin="0,16,0,0"/>
                            <StackPanel Visibility="{Binding RequiresCode,Converter={StaticResource BoolVisibility}}" Margin="0,16,0,0">
                                <TextBlock Text="{Binding Code}" FontSize="42" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,8"/>
                                <TextBox x:Name="CodeInput" Text="{Binding Input,UpdateSourceTrigger=PropertyChanged}" FontSize="24" HorizontalContentAlignment="Center" MaxWidth="350" MaxLength="11" Background="{DynamicResource NoticeSurface}" Foreground="{DynamicResource NoticeText}" CaretBrush="{DynamicResource NoticeText}" AutomationProperties.Name="9 位數字閱讀確認碼，可省略連字號" InputMethod.IsInputMethodEnabled="False"/>
                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource NoticeAccent}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource NoticeLine}" BorderThickness="0,1,0,0" Padding="30,20,30,22">
                        <StackPanel x:Name="Actions">
                            <Grid x:Name="ActionLayout">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <WrapPanel x:Name="SnoozeActions" Visibility="{Binding CanSnooze,Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,12,0"><Path Data="M 12,2 A 10,10 0 1 1 11.99,2 M 12,6 L 12,12 17,15" Stroke="{DynamicResource NoticeMuted}" StrokeThickness="1.7" StrokeLineJoin="Round"/></Viewbox>
                                    <ComboBox x:Name="SnoozeInterval" Style="{StaticResource NoticeCombo}" ItemsSource="{Binding SnoozeChoices}" SelectedItem="{Binding SnoozeMinutes}" Width="132" MinHeight="46" Margin="0,0,10,0" AutomationProperties.Name="稍後提醒間隔">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Mode=OneWay}"/><Run Text=" 分鐘後"/></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="稍後提醒" Command="{Binding SnoozeCommand}" ToolTip="{Binding SnoozeLabel}" Style="{StaticResource NoticeButton}"/>
                                </WrapPanel>
                                <WrapPanel x:Name="ConfirmActions" Grid.Column="1" HorizontalAlignment="Right">
                                    <Button x:Name="ConfirmButton" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" Style="{StaticResource NoticeActionButton}" Margin="0"/>
                                    <Button x:Name="CompleteTaskButton" Content="已完成" Command="{Binding CompleteTaskCommand}" Visibility="{Binding CanComplete,Converter={StaticResource BoolVisibility}}" Style="{StaticResource NoticeActionButton}" Margin="10,0,0,0"/>
                                </WrapPanel>
                            </Grid>
                            <TextBlock Text="{Binding Instruction}" Foreground="{DynamicResource NoticeMuted}" FontSize="12" LineHeight="19" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
