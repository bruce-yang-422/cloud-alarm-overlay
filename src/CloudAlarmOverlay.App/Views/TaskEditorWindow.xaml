<Window x:Class="CloudAlarmOverlay.App.Views.TaskEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles"
 xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
 xmlns:controls="clr-namespace:CloudAlarmOverlay.App.Controls"
 Title="{Binding Heading}" Width="880" Height="790" MinWidth="480" MinHeight="450"
 Icon="/CloudAlarmOverlay.App;component/Assets/Brand/cloud_alarm_icon.png" WindowStartupLocation="CenterOwner" Background="{adaptive:AdaptiveBrush #F7FAFE}" Foreground="{adaptive:AdaptiveBrush #16243E}"
 FontSize="14" FontFamily="Segoe UI, Microsoft JhengHei UI" UseLayoutRounding="True">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/LightTheme.xaml"/><ResourceDictionary Source="../Styles/CalendarStyles.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="ChoiceItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/>
                <Setter Property="Padding" Value="8,7"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Pill" Background="{adaptive:AdaptiveBrush #F1F5FA}" BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Pill" Property="Background" Value="{adaptive:AdaptiveBrush #E6F0FF}"/><Setter TargetName="Pill" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #3664A0}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
            <Style x:Key="DayCheck" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Pill" Background="{adaptive:AdaptiveBrush #F1F5FA}" BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="1" CornerRadius="12" Padding="6,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="Tick" Text="✓ " Foreground="{adaptive:AdaptiveBrush #3664A0}" Visibility="Collapsed"/>
                                <ContentPresenter/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Pill" Property="Background" Value="{adaptive:AdaptiveBrush #E6F0FF}"/><Setter TargetName="Pill" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #3664A0}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
            <Style x:Key="PillSwitch" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/>
                <Setter Property="Margin" Value="0,8,0,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" MinHeight="32">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Track" Width="48" Height="28" CornerRadius="14" Background="{adaptive:AdaptiveBrush #A7B3C6}" HorizontalAlignment="Left">
                                <Ellipse Width="20" Height="20" Fill="{adaptive:AdaptiveBrush White}" HorizontalAlignment="Left" Margin="4,0,0,0">
                                    <Ellipse.RenderTransform><TranslateTransform x:Name="Knob"/></Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{adaptive:AdaptiveBrush #0766FF}"/>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #3664A0}"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
            
   <Style x:Key="Section" TargetType="Border">
    <Setter Property="Background" Value="{adaptive:AdaptiveBrush #FFFFFF}"/><Setter Property="BorderBrush" Value="{adaptive:AdaptiveBrush #E0E7F1}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,16"/>
   </Style>
   <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Padding" Value="12,11"/><Setter Property="Margin" Value="0,8,0,0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
     <Border x:Name="FieldBorder" Background="{adaptive:AdaptiveBrush #FFFFFF}" BorderBrush="{adaptive:AdaptiveBrush #D6E1EF}" BorderThickness="1" CornerRadius="10">
      <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
     </Border>
     <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="DateButton" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
     <Border x:Name="DateBorder" Background="{adaptive:AdaptiveBrush #FFFFFF}" BorderBrush="{adaptive:AdaptiveBrush #D6E1EF}" BorderThickness="1" CornerRadius="10" Padding="14,12">
      <ContentPresenter/>
     </Border>
     <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DateBorder" Property="Background" Value="{adaptive:AdaptiveBrush #FAFCFF}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="DateBorder" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DateBorder" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </Window.Resources>
 <Grid x:Name="EditorRoot" Background="{adaptive:AdaptiveBrush #F7FAFE}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="28,24,28,20">
   <StackPanel><TextBlock Text="{Binding Heading}" FontSize="26" FontWeight="SemiBold"/>
    <TextBlock Text="安排好時間，讓提醒替你記住。" Foreground="{adaptive:AdaptiveBrush #7184A0}" Margin="0,7,0,0"/>
   </StackPanel>
   <Border Background="{adaptive:AdaptiveBrush #EAF3FF}" CornerRadius="12" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Top">
    <TextBlock Text="個人提醒" Foreground="{adaptive:AdaptiveBrush #0766FF}" FontSize="12"/>
   </Border>
  </Grid>
  <ScrollViewer x:Name="FormScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" ScrollChanged="OnFormScrollChanged" Padding="28,0,28,0">
   <Grid x:Name="FormColumns">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel>
     <Border Style="{StaticResource Section}">
      <StackPanel>
       <TextBlock Text="提醒什麼事？" FontSize="16" FontWeight="SemiBold"/>
       <TextBox Text="{Binding TaskTitle,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" MaxLength="50" AutomationProperties.Name="任務名稱"/>
       <TextBlock Text="提醒方式" Foreground="{adaptive:AdaptiveBrush #576C8B}" Margin="0,12,0,6"/>
       <ListBox Style="{StaticResource SegmentedSelector}" ItemTemplate="{StaticResource AlarmLevelItem}" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" Background="Transparent" BorderThickness="0">
        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
       </ListBox>
       <TextBlock Text="一般提醒：日常事項（預設） · 重要提醒：高優先事項 · 緊急提醒：死線、需即時處理" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
       <Border Height="1" Background="{adaptive:AdaptiveBrush #E0E7F1}" Margin="0,14"/>
       <TextBlock Text="多久提醒一次？" Foreground="{adaptive:AdaptiveBrush #576C8B}" Margin="0,0,0,10"/>
       <ListBox Style="{StaticResource SegmentedSelector}" ItemsSource="{Binding Repeats}" SelectedItem="{Binding Repeat}" Background="Transparent" BorderThickness="0">
        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
       </ListBox>
       <StackPanel Visibility="{Binding IsWeekly,Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0">
        <TextBlock Text="選擇星期，可複選" Foreground="{adaptive:AdaptiveBrush #7184A0}" FontSize="12" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding Weekdays}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding ShortLabel}" IsChecked="{Binding IsSelected,Mode=TwoWay}" Style="{StaticResource DayCheck}"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
       <StackPanel Visibility="{Binding IsMonthly,Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0">
        <TextBlock Text="提醒月份（可複選）" Foreground="{adaptive:AdaptiveBrush #7184A0}" FontSize="12" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding Months}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected,Mode=TwoWay}" Style="{StaticResource DayCheck}"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="選擇每月日期" Foreground="{adaptive:AdaptiveBrush #7184A0}" FontSize="12" Margin="0,12,0,10"/>
        <ListBox ItemsSource="{Binding MonthDays}" SelectedItem="{Binding MonthDay,Mode=TwoWay}" ItemContainerStyle="{StaticResource ChoiceItem}" Background="Transparent" BorderThickness="0">
         <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ListBox.ItemsPanel>
        </ListBox>
        <TextBlock Text="當月沒有這一天時，自動略過。" Style="{StaticResource Muted}" FontSize="11"/>
       </StackPanel>
                 <StackPanel Visibility="{Binding IsAnnual,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12">
      <TextBlock Text="每年國曆月日（紀念日／生日）" Margin="0,0,0,6"/>
      <WrapPanel>
       <StackPanel Width="140" Margin="0,0,18,8"><TextBlock Text="國曆月"/><ComboBox ItemsSource="{Binding AnnualMonths}" SelectedItem="{Binding AnnualMonth}" AutomationProperties.Name="每年國曆月份"/></StackPanel>
       <StackPanel Width="140" Margin="0,0,0,8"><TextBlock Text="國曆日"/><ComboBox ItemsSource="{Binding MonthDays}" SelectedItem="{Binding AnnualDay}" AutomationProperties.Name="每年國曆日期"/></StackPanel>
      </WrapPanel>
      <TextBlock Text="從開始日期起，每年在此月日提醒一次；2 月 29 日只在閏年提醒。" Style="{StaticResource Muted}" FontSize="12"/>
     </StackPanel>
<StackPanel Visibility="{Binding IsLunarDate,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12">
      <TextBlock Text="每年農曆月日（例如神明生日）" Margin="0,0,0,6"/>
      <WrapPanel>
       <StackPanel Width="140" Margin="0,0,18,8"><TextBlock Text="農曆月"/><ComboBox ItemsSource="{Binding LunarMonths}" SelectedItem="{Binding LunarMonth}" AutomationProperties.Name="農曆月份"/></StackPanel>
       <StackPanel Width="140" Margin="0,0,0,8"><TextBlock Text="農曆日"/><ComboBox ItemsSource="{Binding LunarDates}" SelectedItem="{Binding LunarDate}" AutomationProperties.Name="農曆日期"/></StackPanel>
      </WrapPanel>
      <CheckBox Content="閏月也提醒（預設只在一般月份提醒）" IsChecked="{Binding IncludeLeapMonth}"/>
      <TextBlock Text="依國曆開始日期尋找下一次農曆月日；當年沒有該日便略過。" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
     </StackPanel>
<StackPanel Visibility="{Binding IsLunar,Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0">
        <TextBlock Text="選擇農曆日期，可複選" Foreground="{adaptive:AdaptiveBrush #7184A0}" FontSize="12" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding LunarDays}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected,Mode=TwoWay}" Style="{StaticResource DayCheck}"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Section}" Padding="18,10">
      <UniformGrid Columns="2">
       <CheckBox Content="啟用提醒" IsChecked="{Binding Enabled}" Style="{StaticResource PillSwitch}"/>
       <CheckBox Content="假日不提醒" IsChecked="{Binding SkipOnHoliday}" Style="{StaticResource PillSwitch}"/>
      </UniformGrid>
     </Border>
    </StackPanel>
    <StackPanel x:Name="ScheduleColumn" Grid.Column="2">
     <Border Style="{StaticResource Section}">
      <StackPanel>
       <TextBlock Text="{Binding ScheduleHeading}" FontSize="16" FontWeight="SemiBold"/>
       <ToggleButton x:Name="DateToggle" Style="{StaticResource DateButton}" Margin="0,16,0,20" AutomationProperties.Name="選擇日期">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Date,StringFormat={}{0:yyyy年M月d日}}" Foreground="{adaptive:AdaptiveBrush #16243E}" VerticalAlignment="Center"/>
         <Path Grid.Column="1" Width="20" Height="20" Stroke="{adaptive:AdaptiveBrush #0766FF}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Data="M 3,5 L 19,5 19,19 3,19 Z M 3,9 L 19,9 M 7,3 L 7,7 M 15,3 L 15,7 M 7,12 L 9,12 M 12,12 L 14,12 M 7,15 L 9,15 M 12,15 L 14,15"/>
        </Grid>
       </ToggleButton>
       <Popup x:Name="DatePopup" PlacementTarget="{Binding ElementName=DateToggle}" IsOpen="{Binding IsChecked,ElementName=DateToggle,Mode=TwoWay}" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Background="{adaptive:AdaptiveBrush #FFFFFF}" CornerRadius="16" BorderBrush="{adaptive:AdaptiveBrush #D6E1EF}" BorderThickness="1" Padding="12" Margin="4">
         <Border.Effect><DropShadowEffect Color="#263B57" BlurRadius="18" ShadowDepth="4" Opacity="0.2"/></Border.Effect>
         <Calendar Style="{StaticResource EditorCalendar}" SelectedDate="{Binding Date,Mode=TwoWay}" SelectedDatesChanged="OnDateSelected"/>
        </Border>
       </Popup>
       <TextBlock Text="{Binding NextReminderPreview}" TextWrapping="Wrap" Margin="0,8,0,8" Foreground="{adaptive:AdaptiveBrush #576C8B}"/>
       <UniformGrid Columns="2"><TextBlock Text="時" HorizontalAlignment="Center" Foreground="{adaptive:AdaptiveBrush #7184A0}"/><TextBlock Text="分" HorizontalAlignment="Center" Foreground="{adaptive:AdaptiveBrush #7184A0}"/></UniformGrid>
       <Grid Margin="0,8,0,8">
        <Border Height="38" VerticalAlignment="Center" Background="{adaptive:AdaptiveBrush #E8F1FF}" CornerRadius="10"/>
        <UniformGrid Columns="2">
         <controls:TimeWheel x:Name="HourWheel" Maximum="23" Value="{Binding SelectedHour,Mode=TwoWay}" AutomationProperties.Name="小時"/>
         <controls:TimeWheel x:Name="MinuteWheel" Value="{Binding SelectedMinute,Mode=TwoWay}" AutomationProperties.Name="分鐘"/>
        </UniformGrid>
       </Grid>
       <TextBlock Text="可直接輸入或按 ＋ / − · 滾輪輔助調整" Foreground="{adaptive:AdaptiveBrush #7184A0}" FontSize="11" HorizontalAlignment="Center"/>
      </StackPanel>
     </Border>

    </StackPanel>
     <Border x:Name="DetailsSection" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Section}" Padding="12">

       <StackPanel>
        <TextBlock Text="詳細內容（選填 · 最多 1,000 字 · 通知時顯示）" Foreground="{adaptive:AdaptiveBrush #576C8B}" FontSize="12"/>
        <controls:MarkdownEditor Emojis="{Binding Emojis}" MaxLength="1000" Text="{Binding Description,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="補充說明及備註（選填 · 最多 500 字 · 通知時顯示）" Foreground="{adaptive:AdaptiveBrush #576C8B}" FontSize="12" Margin="0,16,0,0"/>
        <controls:MarkdownEditor Emojis="{Binding Emojis}" MaxLength="500" Text="{Binding Note,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="可插入待辦方框，切到預覽直接勾選，儲存提醒後保留。常用 emoji 可到設定修改。不支援圖片；詳細內容 1,000 字、補充說明及備註 500 字。" TextWrapping="Wrap" FontSize="12" Foreground="{adaptive:AdaptiveBrush #576C8B}" Margin="0,10,0,0"/>
       </StackPanel>

     </Border>
   </Grid>
  </ScrollViewer>
  <Border Grid.Row="2" Background="{adaptive:AdaptiveBrush #FFFFFF}" BorderBrush="{adaptive:AdaptiveBrush #E0E7F1}" BorderThickness="0,1,0,0" Padding="28,14,28,18">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
     <TextBlock Text="{Binding Error}" Foreground="{adaptive:AdaptiveBrush #C62835}" TextWrapping="Wrap"/>
     <TextBlock x:Name="ScrollHint" Text="↓  向下捲動查看更多" Foreground="{adaptive:AdaptiveBrush #7184A0}" FontSize="12" Visibility="Collapsed"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button Content="取消" IsCancel="True" Background="{adaptive:AdaptiveBrush #F1F5FA}" Padding="24,12"/>
     <Button x:Name="SaveButton" Content="儲存提醒" ToolTip="Enter 或 Ctrl+S 儲存；Esc 取消" IsDefault="True" Command="{Binding SaveCommand}" Style="{StaticResource Primary}" Padding="28,12" Margin="4,0,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
