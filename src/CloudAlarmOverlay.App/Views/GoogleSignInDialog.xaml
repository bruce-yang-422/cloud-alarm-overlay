<Window x:Class="CloudAlarmOverlay.App.Views.GoogleSignInDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles" Title="新增 Google 帳號" Width="500" Height="610" ResizeMode="NoResize"
 WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="13" Background="{adaptive:AdaptiveBrush #F7FAFE}">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="12"/></WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/SettingsFormStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="1" Padding="26" CornerRadius="12" Background="{adaptive:AdaptiveBrush #F7FAFE}">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel MouseLeftButtonDown="DragHeader" Margin="0,0,0,20">
    <Border Width="44" Height="44" CornerRadius="12" Background="{adaptive:AdaptiveBrush #E6F0FF}" HorizontalAlignment="Left" Margin="0,0,0,14"><TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" Foreground="{adaptive:AdaptiveBrush #0766FF}"/></Border>
    <TextBlock Text="新增 Google 帳號" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBlock Text="連接個人或公司帳號，選擇要使用的功能。" Style="{StaticResource Muted}"/>
   </StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"><StackPanel>
    <TextBlock Text="帳號名稱" Style="{StaticResource SectionTitle}"/>
    <TextBox x:Name="AccountLabelInput" MaxLength="40" AutomationProperties.Name="帳號名稱" TextChanged="InputChanged" Margin="0,0,0,6"/>
    <TextBlock Text="例如：工作排程、家庭生活、接案專用。之後可從帳號選單重新命名。" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,20"/>
    <TextBlock Text="使用功能" Style="{StaticResource SectionTitle}"/>
    <Border Style="{StaticResource SettingsGroup}" Padding="14,4" Margin="0,0,0,12"><StackPanel>
     <CheckBox x:Name="SheetsToggle" Checked="InputChanged" Unchecked="InputChanged" Margin="0,8" AutomationProperties.Name="讀取 Google Sheets">
      <StackPanel><TextBlock Text="Google Sheets" FontWeight="SemiBold"/><TextBlock Text="同步試算表中的任務與提醒" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
     </CheckBox>
     <Border BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="0,1,0,0"/>
     <CheckBox x:Name="CalendarToggle" Checked="InputChanged" Unchecked="InputChanged" Margin="0,8" AutomationProperties.Name="讀取自己的 Google 日曆">
      <StackPanel><TextBlock Text="Google 日曆" FontWeight="SemiBold"/><TextBlock Text="讀取自己擁有的日曆與行程" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
     </CheckBox>
    </StackPanel></Border>
    <CheckBox x:Name="WriteToggle" Margin="2,0,2,6" AutomationProperties.Name="允許編輯 Google Sheets"><TextBlock Text="同時申請 Sheets 編輯權限"/></CheckBox>
    <TextBlock Text="需要從程式修改線上任務時才開啟。" Style="{StaticResource Muted}" FontSize="12" Margin="4,0,0,12"/>
    <TextBlock x:Name="ValidationText" Text="請至少選擇一項功能，並填寫帳號名稱。" Foreground="{adaptive:AdaptiveBrush #BA3D45}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
   </StackPanel></ScrollViewer>
   <StackPanel Grid.Row="2" Margin="0,18,0,0">
    <TextBlock Text="接著會開啟瀏覽器，由 Google 確認登入與授權。" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" MinWidth="80"/><Button x:Name="ContinueButton" Content="繼續前往 Google" Click="Continue" IsDefault="True" Style="{StaticResource SettingsPrimary}" Margin="0"/></StackPanel>
   </StackPanel>
  </Grid>
 </Border>
</Window>
