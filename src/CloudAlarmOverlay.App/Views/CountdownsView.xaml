<UserControl x:Class="CloudAlarmOverlay.App.Views.CountdownsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:CloudAlarmOverlay.App.Controls"
 xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
 xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../Styles/LightTheme.xaml"/>
  <ResourceDictionary Source="../Styles/CalendarStyles.xaml"/>
  <ResourceDictionary Source="../Styles/CountdownStyles.xaml"/>
 </ResourceDictionary.MergedDictionaries>
 </ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
   <DockPanel Margin="0,0,0,4">
    <Button DockPanel.Dock="Right" Content="＋ 新增倒數" Click="ShowEditor" Style="{StaticResource Primary}" VerticalAlignment="Top" Margin="12,0,0,0"/>
    <StackPanel><TextBlock Text="倒數／正數" Style="{StaticResource Heading}"/>
     <TextBlock Text="讓期待有刻度，讓重要時刻一目了然。" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
    </StackPanel>
   </DockPanel>
   <Grid x:Name="CompactStatistics" Margin="0,0,0,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,10,0"><StackPanel>
     <DockPanel Margin="0,0,0,5"><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" Width="90" Height="26" MinHeight="0" Margin="0" Padding="6,2" FontSize="12" HorizontalAlignment="Right" AutomationProperties.Name="統計年度"/><TextBlock Text="倒數統計" FontSize="15" FontWeight="SemiBold" ToolTip="依事件目前的目標年度統計；完成需手動標記，與逾期分開計算。"/></DockPanel>
     <UniformGrid Columns="4" Margin="0,0,0,6"><StackPanel><TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="SemiBold" Foreground="{adaptive:AdaptiveBrush #0766FF}"/><TextBlock Text="全部" Style="{StaticResource Muted}" FontSize="11" LineHeight="14"/></StackPanel>
<StackPanel><TextBlock Text="{Binding ActiveCount}" FontSize="20" FontWeight="SemiBold" Foreground="{adaptive:AdaptiveBrush #099666}"/><TextBlock Text="進行中" Style="{StaticResource Muted}" FontSize="11" LineHeight="14"/></StackPanel>
<StackPanel><TextBlock Text="{Binding CompletedCount}" FontSize="20" FontWeight="SemiBold" Foreground="{adaptive:AdaptiveBrush #3664A0}"/><TextBlock Text="已完成" Style="{StaticResource Muted}" FontSize="11" LineHeight="14"/></StackPanel>
<StackPanel><TextBlock Text="{Binding ExpiredCount}" FontSize="20" FontWeight="SemiBold" Foreground="{adaptive:AdaptiveBrush #B13C5A}"/><TextBlock Text="已逾期" Style="{StaticResource Muted}" FontSize="11" LineHeight="14"/></StackPanel>
</UniformGrid>
     <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding YearPercent,StringFormat=已經過 {0:0}%}" Style="{StaticResource Muted}" FontSize="11" LineHeight="14"/><TextBlock Text="{Binding YearProgressLabel}" Style="{StaticResource Muted}" FontSize="11" LineHeight="14"/></DockPanel>
     <ProgressBar Style="{StaticResource CountdownBar}" Value="{Binding YearPercent}" Maximum="100" Height="4" Margin="0,4,0,0" AutomationProperties.Name="年度進度"/>
    </StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10" Margin="0"><StackPanel>
     <TextBlock Text="分類統計" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Width="68" Height="68" HorizontalAlignment="Left">
       <controls:CountdownDonut First="{Binding WorkCount}" Second="{Binding LifeCount}" Third="{Binding HolidayCount}" Fourth="{Binding TravelCount}" Fifth="{Binding OtherCount}" FourthBrush="#8C70D4" FifthBrush="#D89231" FirstBrush="#309EDE" SecondBrush="#39A67F" ThirdBrush="#E46C80" TrackBrush="{adaptive:AdaptiveBrush #E6F0FF}" AutomationProperties.Name="工作、生活、節日、旅行、其他事件比例"/>
       <TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <UniformGrid Grid.Column="1" Columns="2" VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Ellipse Width="8" Height="8" Fill="#309EDE" Margin="0,0,8,0"/><TextBlock Text="{Binding WorkCount,StringFormat=工作  {0}}" FontSize="12"/></StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Ellipse Width="8" Height="8" Fill="#39A67F" Margin="0,0,8,0"/><TextBlock Text="{Binding LifeCount,StringFormat=生活  {0}}" FontSize="12"/></StackPanel>
       <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#E46C80" Margin="0,0,8,0"/><TextBlock Text="{Binding HolidayCount,StringFormat=節日  {0}}" FontSize="12"/></StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><Ellipse Width="8" Height="8" Fill="#8C70D4" Margin="0,0,8,0"/><TextBlock Text="{Binding TravelCount,StringFormat=旅行  {0}}" FontSize="12"/></StackPanel>
       <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#D89231" Margin="0,0,8,0"/><TextBlock Text="{Binding OtherCount,StringFormat=其他  {0}}" FontSize="12"/></StackPanel>
      </UniformGrid>
     </Grid>
    </StackPanel></Border>
   </Grid>
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Margin" Value="0,0,0,6"/><Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <DockPanel x:Name="ListHeading" Margin="0,0,0,8">
    <ListBox DockPanel.Dock="Right" ItemsSource="{Binding ViewModes}" SelectedItem="{Binding ViewMode}" Style="{StaticResource SegmentedSelector}" HorizontalAlignment="Right" AutomationProperties.Name="倒數呈現方式"/>
    <TextBlock Text="我的倒數" FontSize="20" FontWeight="SemiBold"/>
   </DockPanel>

   <WrapPanel><ListBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter}" Style="{StaticResource SegmentedSelector}" Margin="0,0,12,8" AutomationProperties.Name="事件分類篩選"/><ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Style="{StaticResource SegmentedSelector}" HorizontalAlignment="Left" Margin="0,0,0,8" AutomationProperties.Name="倒數篩選"/></WrapPanel>
   <TextBlock Text="此分類還沒有倒數項目。" Style="{StaticResource Muted}" Visibility="{Binding IsFilteredEmpty,Converter={StaticResource BoolVisibility}}"/>
   <ItemsControl x:Name="CountdownCards" ItemsSource="{Binding VisibleItems}" Visibility="{Binding IsCardView,Converter={StaticResource BoolVisibility}}" SizeChanged="UpdateCardColumns">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding CardColumns,RelativeSource={RelativeSource AncestorType=UserControl}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border x:Name="CountdownEventCard" Padding="0" Margin="0,0,10,10" CornerRadius="14">
      <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers>
      <DataTrigger Binding="{Binding StatusLabel}" Value="即將到來"><Setter Property="BorderBrush" Value="{adaptive:AdaptiveBrush #E4A6B5}"/><Setter Property="Background" Value="{adaptive:AdaptiveBrush #FFF3F5}"/></DataTrigger>
     </Style.Triggers></Style></Border.Style>
      <Grid SnapsToDevicePixels="True">
       <Border BorderBrush="{adaptive:AdaptiveBrush #0766FF}" BorderThickness="4,0,0,0" CornerRadius="14" Margin="-1" IsHitTestVisible="False"/>
       <StackPanel Margin="14,9,10,9">
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CountdownCardBody}"/>
        <DockPanel Margin="0,6,0,0">
         <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource CountdownIconButton}" Content="&#xE718;" ToolTip="{Binding PinLabel}" AutomationProperties.Name="{Binding PinLabel}" Command="{Binding DataContext.TogglePinCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
          <Button Style="{StaticResource CountdownIconButton}" Content="&#xE74A;" ToolTip="{Binding TopLabel}" AutomationProperties.Name="{Binding TopLabel}" Command="{Binding DataContext.ToggleTopCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
          <Button Style="{StaticResource CountdownIconButton}" Content="&#xE74D;" ToolTip="刪除" AutomationProperties.Name="刪除" Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
         </StackPanel>
         <StackPanel Orientation="Horizontal">
          <Button Padding="7,4" FontSize="12" Content="編輯" Click="ShowEditor"/>
          <Button Padding="7,4" FontSize="12" Content="{Binding CompleteLabel}" Command="{Binding DataContext.ToggleCompleteCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
         </StackPanel>
        </DockPanel>
       </StackPanel>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <DataGrid x:Name="CountdownTable" ItemsSource="{Binding VisibleItems}" Visibility="{Binding IsTableView,Converter={StaticResource BoolVisibility}}" IsReadOnly="True" CanUserSortColumns="False" RowHeight="70" MaxHeight="560" FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="倒數資料表">
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="事件名稱" Width="*" MinWidth="150"><DataGridTemplateColumn.CellTemplate><DataTemplate>
      <StackPanel><TextBlock Text="{Binding Title}" ToolTip="{Binding Item.Notes}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{adaptive:AdaptiveBrush #16243E}"/>
       <TextBlock Text="{Binding PlacementLabel}" FontSize="11" Foreground="{adaptive:AdaptiveBrush #0766FF}"/>
       <TextBlock Text="{Binding DetailsLabel}" ToolTip="{Binding DetailsLabel}" Style="{StaticResource Muted}" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="目標日期" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel>
      <TextBlock Text="{Binding TargetLabel}" Foreground="{adaptive:AdaptiveBrush #16243E}"/>
      <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource Muted}" FontSize="11"/>
     </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="剩餘／已過" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Remaining}" TextWrapping="Wrap" ToolTip="{Binding NextReminderLabel}" Foreground="{adaptive:AdaptiveBrush #0766FF}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="已經過" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel>
      <TextBlock Text="{Binding ProgressLabel}" Foreground="{adaptive:AdaptiveBrush #16243E}" FontSize="11"/>
      <ProgressBar Style="{StaticResource CountdownBar}" Value="{Binding ElapsedPercent}" Maximum="100" Visibility="{Binding ShowProgress,Converter={StaticResource BoolVisibility}}" Margin="0,6,0,0"/>
     </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="狀態" Binding="{Binding StatusLabel}" Width="85"/>
     <DataGridTemplateColumn Header="操作" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate>
      <StackPanel Orientation="Horizontal">
       <Button Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="6" Margin="0,0,3,0" ToolTip="編輯" AutomationProperties.Name="編輯" Click="ShowEditor"/>
       <Button Content="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="6" Margin="0,0,3,0" ToolTip="{Binding PinLabel}" AutomationProperties.Name="{Binding PinLabel}" Command="{Binding DataContext.TogglePinCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
       <Button Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="6" Margin="0,0,3,0" ToolTip="{Binding TopLabel}" AutomationProperties.Name="{Binding TopLabel}" Command="{Binding DataContext.ToggleTopCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
       <Button Content="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="6" Margin="0,0,3,0" ToolTip="{Binding CompleteLabel}" AutomationProperties.Name="{Binding CompleteLabel}" Command="{Binding DataContext.ToggleCompleteCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
       <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="6" Margin="0,0,3,0" ToolTip="刪除" AutomationProperties.Name="刪除" Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
      </StackPanel>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   <Expander Header="時間分布與使用提示" IsExpanded="False" Margin="0,12,0,12" Foreground="{adaptive:AdaptiveBrush #16243E}"><StackPanel>
   <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
    <StackPanel>
     <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ChartScale,StringFormat=刻度上限 {0:0} 天}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right"/><TextBlock Text="即將到來 · 時間分布" FontSize="18" FontWeight="SemiBold"/></DockPanel>
     <TextBlock Text="最近 5 項未到期倒數，以相同刻度比較剩餘天數；越短代表越接近目標。" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,12"/>
     <TextBlock Text="目前沒有未到期的倒數，新增一個期待的日子吧。" Style="{StaticResource Muted}" Visibility="{Binding IsTimelineEmpty,Converter={StaticResource BoolVisibility}}"/>
     <ItemsControl ItemsSource="{Binding Timeline}">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{adaptive:AdaptiveBrush #16243E}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <ProgressBar Grid.Column="1" Style="{StaticResource CountdownBar}" Height="12" Value="{Binding RemainingDays}" Maximum="{Binding DataContext.ChartScale,RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Center" ToolTip="{Binding Remaining}" AutomationProperties.Name="剩餘天數"/>
        <TextBlock Grid.Column="2" Text="{Binding Remaining}" Foreground="{adaptive:AdaptiveBrush #0766FF}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
       </Grid>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </Border>
    <TextBlock Text="每月遇到不存在的日期會略過；每年 2/29 在閏年提醒。已完成事件停止重複與提醒，恢復進行即可繼續。首頁最多釘選 2 項，清單置頂不占釘選名額。" Style="{StaticResource Muted}" FontSize="12"/>
   </StackPanel></Expander>
  </StackPanel>
 </ScrollViewer>
</UserControl>
