<Window xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CloudAlarmOverlay.App.Views.AdminCredentialsDialog" Width="460" SizeToContent="Height" MaxHeight="700" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{adaptive:AdaptiveBrush WorkspaceSurface}" Foreground="{adaptive:AdaptiveBrush WorkspaceText}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles/AdminWorkspaceStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="Heading" Style="{StaticResource AdminTitle}" />
      <TextBlock x:Name="Description" Style="{StaticResource AdminDescription}" />
    </StackPanel>
    <StackPanel Grid.Row="1" x:Name="Fields">
      <StackPanel x:Name="UsernameField">
        <TextBlock Text="管理者帳號" Style="{StaticResource WorkspaceFieldLabel}" />
        <TextBox x:Name="Username" MaxLength="50" AutomationProperties.Name="管理者帳號" />
      </StackPanel>
      <StackPanel x:Name="CurrentField">
        <TextBlock Text="目前密碼" Style="{StaticResource WorkspaceFieldLabel}" />
        <PasswordBox x:Name="CurrentPassword" MaxLength="128" Margin="0,4,0,12" AutomationProperties.Name="目前管理者密碼" />
      </StackPanel>
      <StackPanel x:Name="NewFields">
        <TextBlock Text="新密碼" Style="{StaticResource WorkspaceFieldLabel}" />
        <PasswordBox x:Name="NewPassword" MaxLength="128" Margin="0,4,0,12" AutomationProperties.Name="新密碼" />
        <TextBlock Text="再次輸入新密碼" Style="{StaticResource WorkspaceFieldLabel}" />
        <PasswordBox x:Name="ConfirmPassword" MaxLength="128" Margin="0,4,0,12" AutomationProperties.Name="確認新密碼" />
      </StackPanel>
      <TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="{adaptive:AdaptiveBrush #BA3D45}" FontSize="12" Margin="0,8,0,8" />
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="CancelButton" Content="取消" IsCancel="True" IsDefault="True" />
      <Button x:Name="ApplyButton" Content="儲存" Click="Apply" Style="{StaticResource AdminPrimary}" Margin="0" />
    </StackPanel>
  </Grid>
</Window>
