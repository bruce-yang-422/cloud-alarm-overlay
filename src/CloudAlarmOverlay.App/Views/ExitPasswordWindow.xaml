<Window x:Class="CloudAlarmOverlay.App.Views.ExitPasswordWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles"
 Title="結束程式驗證" Width="440" Height="320" MinWidth="400" MinHeight="300" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="{adaptive:AdaptiveBrush #F7FAFE}" Foreground="{adaptive:AdaptiveBrush #16243E}" FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="14"
 Icon="/CloudAlarmOverlay.App;component/Assets/Brand/cloud_alarm_icon.png">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/LightTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="結束程式密碼" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock Text="請輸入管理員設定的專用結束密碼；取消後提醒會繼續運作。" Style="{StaticResource Muted}" Margin="0,10,0,18"/>
   <Label Target="{Binding ElementName=Password}" Content="專用結束密碼"/>
   <PasswordBox x:Name="Password" Height="44" MaxLength="128" AutomationProperties.Name="專用結束程式密碼" PasswordChanged="OnPasswordChanged"/>
   <TextBlock x:Name="Error" Foreground="{adaptive:AdaptiveBrush #C62835}" TextWrapping="Wrap" Margin="0,10,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="取消" IsCancel="True"/>
   <Button x:Name="Submit" Content="驗證並結束" IsDefault="True" IsEnabled="False" Click="OnSubmit" Style="{StaticResource Primary}"/>
  </StackPanel>
 </Grid>
</Window>
