<UserControl x:Class="CloudAlarmOverlay.App.Views.HealthToolView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles" xmlns:local="clr-namespace:CloudAlarmOverlay.App.Views">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/LightTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <local:HealthColumnsConverter x:Key="HealthColumns"/><local:HealthEmptyVisibilityConverter x:Key="WhenFalse"/>
 </ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="18">
   <DockPanel Margin="0,0,0,18">
    <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="32" Foreground="{Binding Accent}" Margin="0,0,14,0"/>
    <StackPanel><TextBlock Text="{Binding Name,StringFormat={}{0}提醒}" Style="{StaticResource Heading}"/><TextBlock Text="{Binding Advice}" Style="{StaticResource Muted}"/></StackPanel>
   </DockPanel>
   <UniformGrid Columns="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource HealthColumns}}">
    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,10,12">
     <StackPanel>
      <TextBlock Text="提醒設定" Foreground="{adaptive:AdaptiveBrush #16243E}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <ContentControl Content="{Binding Editor}"><ContentControl.ContentTemplate><DataTemplate>
        <StackPanel>
         <CheckBox Content="啟用提醒" IsChecked="{Binding Enabled}" Margin="0,0,0,20"/>
         <TextBlock Foreground="{adaptive:AdaptiveBrush #16243E}" Text="提醒間隔（分鐘）"/><TextBox Text="{Binding Interval,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,5" AutomationProperties.Name="健康提醒間隔"/><TextBlock Text="5–240 分鐘" Style="{StaticResource Muted}" FontSize="12"/>
         <TextBlock Foreground="{adaptive:AdaptiveBrush #16243E}" Text="有效時段" Margin="0,20,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding Start,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="健康提醒開始時間"/><TextBlock Foreground="{adaptive:AdaptiveBrush #16243E}" Grid.Column="1" Text="～" HorizontalAlignment="Center"/><TextBox Grid.Column="2" Text="{Binding End,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="健康提醒結束時間"/></Grid>
         <TextBlock Text="HH:mm；開始與結束需在同一天。" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
         <TextBlock Foreground="{adaptive:AdaptiveBrush #16243E}" Text="提醒日期" Margin="0,20,0,10"/><ItemsControl ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}" Margin="0,0,12,12"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <TextBlock Text="以每日開始時間為基準，一個週期後第一次提醒。儲存後從下一個排程點開始，不補發先前提醒。" Style="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"/>
        </StackPanel>

      </DataTemplate></ContentControl.ContentTemplate></ContentControl>
      <TextBlock Text="{Binding Error}" Foreground="{adaptive:AdaptiveBrush #BA3D45}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding SaveMessage}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
      <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="還原設定" Command="{Binding ResetDraftCommand}" ToolTip="捨棄未儲存的修改，還原為上次儲存的內容。"/><Button Content="儲存設定" Command="{Binding SaveCommand}" Style="{StaticResource Primary}"/></WrapPanel>
     </StackPanel>
    </Border>
    <StackPanel>
     <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
      <StackPanel>
       <DockPanel><Button DockPanel.Dock="Right" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}"/><TextBlock Text="目前狀態" FontSize="16" FontWeight="SemiBold" Foreground="{adaptive:AdaptiveBrush #16243E}"/></DockPanel>
       <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
       <StackPanel Orientation="Horizontal" Margin="0,8,0,14"><TextBlock Text="{Binding Countdown}" FontSize="34" FontWeight="SemiBold" Foreground="{adaptive:AdaptiveBrush #16243E}"/><TextBlock Text="{Binding CountdownUnit}" Style="{StaticResource Muted}" Margin="8,8,0,0"/></StackPanel>
       <ProgressBar Value="{Binding Progress,Mode=OneWay}" Height="5" Maximum="100" Foreground="{Binding Accent}" Background="{adaptive:AdaptiveBrush #EEF3F9}" BorderThickness="0"/>
       <TextBlock Text="{Binding Schedule}" Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,4"/>
       <TextBlock Text="{Binding Window}" Style="{StaticResource Muted}" FontSize="12"/>
       <TextBlock Text="{Binding Today}" Foreground="{adaptive:AdaptiveBrush #16243E}" Margin="0,14,0,0"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
      <StackPanel>
       <TextBlock Text="最近 7 天" Foreground="{adaptive:AdaptiveBrush #16243E}" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding WeekCount,StringFormat=共 {0} 個提醒項目}" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,12"/>
       <ItemsControl ItemsSource="{Binding Week}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
        <StackPanel ToolTip="{Binding Total,StringFormat={}{0} 個提醒項目}"><TextBlock Text="{Binding Total}" Foreground="{adaptive:AdaptiveBrush #16243E}" FontSize="11" HorizontalAlignment="Center"/><Grid Height="112"><Border Height="{Binding WaterHeight}" VerticalAlignment="Bottom" Margin="5,0" Background="{Binding DataContext.Accent,RelativeSource={RelativeSource AncestorType=ItemsControl}}"/></Grid><TextBlock Text="{Binding Label}" Foreground="{adaptive:AdaptiveBrush #697C99}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </Border>
    </StackPanel>
   </UniformGrid>
   <Border Style="{StaticResource Card}" Padding="20">
    <StackPanel>
     <DockPanel><TextBlock DockPanel.Dock="Right" Text="最近 7 天 · 僅本功能" Style="{StaticResource Muted}" FontSize="12"/><TextBlock Text="提醒紀錄" Foreground="{adaptive:AdaptiveBrush #16243E}" FontSize="16" FontWeight="SemiBold"/></DockPanel>
     <TextBlock Text="尚無提醒紀錄，啟用後開始累積。" Style="{StaticResource Muted}" Margin="0,16" Visibility="{Binding HasHistory,Converter={StaticResource WhenFalse}}"/>
     <ListBox ItemsSource="{Binding History}" MaxHeight="260" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0"><ListBox.ItemTemplate><DataTemplate>
      <Border BorderBrush="{adaptive:AdaptiveBrush #E8EDF4}" BorderThickness="0,0,0,1" Padding="0,8"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{adaptive:AdaptiveBrush #697C99}" FontSize="12"/><TextBlock Text="{Binding Time}" Foreground="{adaptive:AdaptiveBrush #16243E}" TextWrapping="Wrap" Margin="0,0,16,0"/></DockPanel></Border>
     </DataTemplate></ListBox.ItemTemplate></ListBox>
     <TextBlock Text="已確認只代表閱讀通知，不代表已完成活動。" Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
