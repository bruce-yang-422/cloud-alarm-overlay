<Window x:Class="CloudAlarmOverlay.App.Views.ConnectionStatusWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles" Title="連線與同步" Width="620" Height="680" MinWidth="500" MinHeight="400"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{adaptive:AdaptiveBrush #F7FAFE}" FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="13">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/SettingsFormStyles.xaml"/><ResourceDictionary Source="../Styles/ConnectionStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="連線與同步" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding ConnectionSummary}" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
   <Button x:Name="RefreshButton" Grid.Column="1" Content="重新檢查" Click="Refresh" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="重新讀取目前連線狀態"/>
  </Grid>
  <ScrollViewer x:Name="ConnectionsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
   <StackPanel>
    <Border Style="{StaticResource SettingsGroup}"><StackPanel>
     <DockPanel><ContentControl DockPanel.Dock="Right" Content="{Binding LocalScheduleHealth}" ContentTemplate="{StaticResource OverallHealthBadge}"/><TextBlock Text="本機排程" FontSize="15" FontWeight="SemiBold"/></DockPanel>
     <TextBlock Text="{Binding LocalScheduleHealth.Detail}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
    </StackPanel></Border>
    <ItemsControl ItemsSource="{Binding ConnectionGroups}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Style="{StaticResource SettingsGroup}" Margin="0,0,0,12"><StackPanel>
      <TextBlock Text="{Binding Name}" Foreground="{adaptive:AdaptiveBrush #16243E}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,10"/>
      <ItemsControl ItemsSource="{Binding Sources}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{adaptive:AdaptiveBrush #E8EDF4}" BorderThickness="0,1,0,0" Padding="0,12,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Name}" Foreground="{adaptive:AdaptiveBrush #16243E}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Kind}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,4"/><TextBlock Text="{Binding Health.Detail}" Style="{StaticResource Muted}" FontSize="12"/></StackPanel>
        <ContentControl Grid.Column="1" Content="{Binding Health}" ContentTemplate="{StaticResource OverallHealthBadge}" VerticalAlignment="Top"/>
       </Grid></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="未設定的公開來源不列入狀態；已停用的來源不影響整體健康狀態。" Style="{StaticResource Muted}" FontSize="12"/>
   </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button Content="Google 帳號設定" Click="ManageGoogle"/><Button Grid.Column="1" Content="共用來源設定" Click="ManageShared"/><Button Grid.Column="2" Content="關閉" IsCancel="True" HorizontalAlignment="Right" Margin="0"/>
  </Grid>
 </Grid>
</Window>
