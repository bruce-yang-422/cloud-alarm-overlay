          <Grid xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="設定" Style="{StaticResource Heading}"/>
            <views:PreferencesView Grid.Row="1" DataContext="{Binding Preferences}"/>
          </Grid>
        </TabItem>
        <TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views" Header="管理者">
          <views:AdminView Visibility="{Binding Admin.IsAuthenticated,Converter={StaticResource BoolVisibility}}" />
        </TabItem>
      </TabControl>
    </DockPanel>
  </Grid>
