<Window xmlns:pincontrols="clr-namespace:CloudAlarmOverlay.App.Controls" x:Class="CloudAlarmOverlay.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles" Title="{Binding Title}" Icon="/CloudAlarmOverlay.App;component/Assets/Brand/cloud_alarm_icon.png" Width="1344" Height="960" MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen" Background="{adaptive:AdaptiveBrush #F7FAFE}" Foreground="{adaptive:AdaptiveBrush #16243E}" FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="14">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles/LightTheme.xaml" />
        <ResourceDictionary Source="../Styles/CountdownStyles.xaml" />
        <ResourceDictionary Source="../Styles/PinButtonStyles.xaml" />
        <ResourceDictionary Source="../Styles/ConnectionStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="TaskMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
          <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{adaptive:AdaptiveBrush #E6F0FF}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="TaskMenu" TargetType="ContextMenu">
        <Style.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource TaskMenuItem}"/></Style.Resources>
        <Setter Property="Background" Value="{adaptive:AdaptiveBrush #FFFFFF}"/>
        <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/>
        <Setter Property="BorderBrush" Value="{adaptive:AdaptiveBrush #D6E1EF}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
          <Border Padding="5" CornerRadius="7" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"><StackPanel IsItemsHost="True"/></Border>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
                <DataTemplate x:Key="NavigationItemTemplate">
                  <Button Click="Navigate" AutomationProperties.Name="{Binding Title}" HorizontalContentAlignment="Stretch">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Padding" Value="12,9"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #697C99}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border x:Name="Nav" Padding="{TemplateBinding Padding}" CornerRadius="7" Background="{TemplateBinding Background}">
                                <ContentPresenter/>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Opacity" Value=".8"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/><Setter TargetName="Nav" Property="BorderThickness" Value="1"/></Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="{adaptive:AdaptiveBrush #E6F0FF}"/>
                            <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #0766FF}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Grid>
                  </Button>
                </DataTemplate>
      <pincontrols:PinnedCardHeightConverter x:Key="PinnedCardHeight"/>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{adaptive:AdaptiveBrush #F7FAFE}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="184" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="54" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.ColumnSpan="2" Background="{adaptive:AdaptiveBrush #F0F5FB}" BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="0,0,0,1" Padding="20,6">
      <Grid>
        <Image Source="/CloudAlarmOverlay.App;component/Assets/Brand/cloud_alarm_horizontal_banner.png" Width="260" Height="40" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="Cloud Alarm Overlay" />
        <TextBlock Text="{Binding DeviceLabel}" HorizontalAlignment="Right" Foreground="{adaptive:AdaptiveBrush #697C99}" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{adaptive:AdaptiveBrush #F0F5FB}" BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,18,12,12">
        <StackPanel DockPanel.Dock="Top" Margin="10,0,0,18">
          <TextBlock Text="工作空間" Foreground="{adaptive:AdaptiveBrush #697C99}" FontSize="12" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <ContentControl x:Name="TaskBuilderNavigation" Content="{Binding TaskBuilderNavigationItem}" ContentTemplate="{StaticResource NavigationItemTemplate}" Margin="0,16,0,12"/>
          <Border x:Name="ConnectionStatusCard" Background="{adaptive:AdaptiveBrush #FFFFFF}" BorderBrush="{adaptive:AdaptiveBrush #E1E8F1}" BorderThickness="1" Padding="10" CornerRadius="12">
            <StackPanel>
              <TextBlock Text="連線狀態" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
              <ContentControl x:Name="OverallHealthStatus" Content="{Binding OverallHealth}" ContentTemplate="{StaticResource OverallHealthBadge}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
              <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="本機排程" FontSize="11"/><ContentControl Grid.Column="1" Content="{Binding LocalScheduleHealth}" ContentTemplate="{StaticResource HealthIndicator}"/></Grid>
              <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="同步來源" FontSize="11"/><ContentControl Grid.Column="1" Content="{Binding CloudHealth}" ContentTemplate="{StaticResource HealthIndicator}"/></Grid>
              <TextBlock Text="{Binding ConnectionSummary}" Style="{StaticResource Muted}" FontSize="10" LineHeight="16" Margin="0,0,0,8"/>
              <Button x:Name="ConnectionDetailsButton" Content="查看連線明細  ›" Click="OpenConnections" FontSize="11" Padding="5,6" Margin="0" HorizontalContentAlignment="Center" ToolTip="依帳號查看所有來源的同步狀態"/>
            </StackPanel>
          </Border>
          <Image Source="/CloudAlarmOverlay.App;component/Assets/Brand/cloud_alarm_wordmark.png" Width="160" Height="22" Stretch="Uniform" Margin="0,18,0,0" AutomationProperties.Name="Cloud Alarm Overlay" />
          <TextBlock Text="讓重要的事，不再遺漏。" FontSize="11" Style="{StaticResource Muted}" Margin="4,6,0,0" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
            <ItemsControl x:Name="PrimaryNavigation" ItemsSource="{Binding NavigationItems}" ItemTemplate="{StaticResource NavigationItemTemplate}"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <DockPanel Grid.Row="1" Grid.Column="1" Margin="20,14,20,10">
      <Border DockPanel.Dock="Bottom" BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding PageIndex}" Value="5"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding PageIndex}" Value="4"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" />
      </Border>
      <TabControl SelectedIndex="{Binding PageIndex}" Background="Transparent" Foreground="{adaptive:AdaptiveBrush #16243E}" BorderThickness="0">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <ContentPresenter ContentSource="SelectedContent" />
          </ControlTemplate>
        </TabControl.Template>
        <TabItem Header="首頁">
          <ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel>
              <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button x:Name="HomeNewTask" Content="＋ 新增任務" Command="{Binding NewTaskCommand}" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
                  <Button x:Name="HomeCountdown" Content="倒數／正數" Command="{Binding OpenCountdownsCommand}" Margin="0,0,8,0"/>
                  <Button x:Name="HomePomodoro" Content="番茄鐘" Command="{Binding OpenPomodoroCommand}" Margin="0"/>
                </StackPanel>
                <TextBlock Text="首頁" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <Border Background="{adaptive:AdaptiveBrush #EEF4FB}" CornerRadius="12" Padding="16,10" Margin="0,0,0,12">
                <WrapPanel>
                  <StackPanel MinWidth="90" Margin="0,0,18,8"><TextBlock Text="日期" Style="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding SolarDate}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                  <StackPanel MinWidth="90" Margin="0,0,18,8"><TextBlock Text="農曆" Style="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding LunarToday}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                  <StackPanel MinWidth="90" Margin="0,0,18,8"><TextBlock Text="時間" Style="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding CurrentClock}" FontSize="17" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                  <StackPanel MinWidth="90" Margin="0,0,18,8"><TextBlock Text="節氣" Style="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding CurrentSolarTerm}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Visibility="{Binding Preferences.Weather.Visible,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8">
                <Button x:Name="WeatherCard" Command="{Binding OpenWeatherCommand}" Padding="8,0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" ToolTip="{Binding Preferences.Weather.Details}">
                    <StackPanel DataContext="{Binding Preferences.Weather}">
                      <StackPanel.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding Stale}" Value="True"><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #697C99}"/></DataTrigger></Style.Triggers></Style></StackPanel.Resources>

                      <TextBlock Text="{Binding Heading}" FontSize="12" TextWrapping="Wrap" MaxWidth="360"/>
                      <TextBlock Text="{Binding Current}" Margin="0,4,0,0"/><TextBlock Text="{Binding Tomorrow}"/><TextBlock Text="{Binding UpdateLabel}" FontSize="11"/>
                    </StackPanel>
                  </Button>
                  <local:WeatherAlertsView xmlns:local="clr-namespace:CloudAlarmOverlay.App.Views" DataContext="{Binding Preferences.Weather}"/>
                </StackPanel></WrapPanel>
              </Border>
              <TextBlock Text="{Binding CalendarWarning}" Foreground="{adaptive:AdaptiveBrush #B46B00}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding HasCalendarWarning,Converter={StaticResource BoolVisibility}}" />
              <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.7*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="NextReminderCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:CloudAlarmOverlay.App.Controls" Style="{StaticResource Card}" Padding="14">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,0,10"><Button DockPanel.Dock="Right" Content="查看提醒 →" Click="PreviewNextReminder" Padding="8,4" Margin="8,0,0,0" FontSize="12" HorizontalAlignment="Right"/><StackPanel Orientation="Horizontal">
                      <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{adaptive:AdaptiveBrush #0766FF}" FontSize="22" Margin="0,0,10,0" />
                      <TextBlock Text="下一個提醒" FontSize="21" FontWeight="SemiBold" />
                    </StackPanel></DockPanel>
                    <Border Grid.Row="1" Background="{adaptive:AdaptiveBrush #FFF3F5}" BorderBrush="{adaptive:AdaptiveBrush #FFE1E6}" BorderThickness="1" CornerRadius="10" Padding="14" MinHeight="140">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="126" />
                          <ColumnDefinition Width="112" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                          <ContentControl Content="{Binding NextReminder}" ContentTemplate="{StaticResource LevelBadge}" HorizontalAlignment="Left" />
                          <TextBlock Text="{Binding NextTitle}" FontWeight="SemiBold" FontSize="21" TextWrapping="Wrap" MaxHeight="86" TextTrimming="CharacterEllipsis" ToolTip="{Binding NextTitle}" Margin="0,8,0,6" />
                          <TextBlock Text="{Binding NextDescription}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" ToolTip="{Binding NextDescription}" Margin="0,0,0,10" />
                          <WrapPanel>
                            <ContentControl Content="{Binding NextReminder}" ContentTemplate="{StaticResource SourceBadge}" />
                            <TextBlock Text="🔒 唯讀" FontSize="12" Foreground="{adaptive:AdaptiveBrush #697C99}" Margin="8,0,0,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding NextReminder.IsLocal}" Value="True">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NextReminder}" Value="{x:Null}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </WrapPanel>
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="{adaptive:AdaptiveBrush #F7D8DE}" BorderThickness="1,0" Padding="6,0">
                          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="{adaptive:AdaptiveBrush #536982}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding NextDate}" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding NextClock}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4" />
                            <TextBlock Text="{Binding NextLunar}" FontSize="12" Foreground="{adaptive:AdaptiveBrush #697C99}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                        <Grid Grid.Column="2" Width="104" Height="104" Margin="8,0,0,0" ToolTip="剩餘時間；環形以 24 小時為一圈">
                          <controls:CountdownRing TrackBrush="{adaptive:AdaptiveBrush #F9CFD5}" ProgressBrush="{adaptive:AdaptiveBrush #E12A43}" RemainingHours="{Binding RemainingHours}" />
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="剩餘" FontSize="13" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CountdownLabel}" Foreground="{adaptive:AdaptiveBrush #D72540}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,3,0,0" />
                          </StackPanel>
                        </Grid>
                      </Grid>
                    </Border>
                  </Grid>
                </Border>
                <Border x:Name="PinnedCountdownCard" Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource Card}" Padding="12" VerticalAlignment="Stretch">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                      <Button DockPanel.Dock="Right" Content="倒數 →" Command="{Binding OpenCountdownsCommand}" FontSize="12" Padding="8,5" Margin="6,0,0,0"/>
                      <Button DockPanel.Dock="Right" Content="任務 →" Command="{Binding OpenTasksCommand}" FontSize="12" Padding="8,5" Margin="6,0,0,0"/>
                      <TextBlock Text="重要追蹤" FontSize="17" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding HomePinSummary}" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
                    <StackPanel Grid.Row="2" Visibility="{Binding IsHomePinsEmpty,Converter={StaticResource BoolVisibility}}">
                      <TextBlock Text="釘選任務追蹤截止時間，或加入倒數／正數；共用名額可於設定調整。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                      <WrapPanel><Button Content="選擇任務" Command="{Binding OpenTasksCommand}" Margin="0,0,8,6"/>
                      <Button Content="＋ 新增倒數" Command="{Binding OpenCountdownsCommand}" Margin="0,0,0,6"/></WrapPanel>
                    </StackPanel>
                      <pincontrols:PinnedCardsScrollViewer x:Name="PinnedCounterScroll" Grid.Row="3" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" Margin="0,-3,0,-3" AutomationProperties.Name="首頁釘選卡片捲動區">
                        <pincontrols:PinnedCardsScrollViewer.Style><Style TargetType="pincontrols:PinnedCardsScrollViewer">
                          <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HomePins.Count}" Value="0"><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/></DataTrigger>
                            <DataTrigger Binding="{Binding HomePins.Count}" Value="1"><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/></DataTrigger>
                            <DataTrigger Binding="{Binding HomePins.Count}" Value="2"><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/></DataTrigger>
                          </Style.Triggers>
                        </Style></pincontrols:PinnedCardsScrollViewer.Style>
                      <ItemsControl x:Name="PinnedCounterList" ItemsSource="{Binding HomePins}">
                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter">
                          <Setter Property="Height"><Setter.Value><MultiBinding Converter="{StaticResource PinnedCardHeight}">
                            <Binding Path="ViewportHeight" ElementName="PinnedCounterScroll"/>
                            <Binding Path="Items.Count" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                          </MultiBinding></Setter.Value></Setter>
                        </Style></ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                          <Border x:Name="PinnedCounterItem" Style="{StaticResource PinnedCountdownState}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,3,0,3" MinHeight="140">
                            <Grid>
                              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                              <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="&#xE77A;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.UnpinHomeCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="取消首頁釘選（保留原項目及提醒）" AutomationProperties.Name="取消釘選" Background="Transparent" Padding="4" Margin="6,0,0,0"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding ModeIcon}" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{Binding BorderBrush,ElementName=PinnedCounterItem}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Foreground="{adaptive:AdaptiveBrush #16243E}"/>
                                <TextBlock Text="{Binding PinKind}" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                              </DockPanel>
                              <TextBlock x:Name="PinnedCounterValue" Grid.Row="1" VerticalAlignment="Center" Text="{Binding HomeSummary}" TextWrapping="Wrap" MaxHeight="60" FontSize="23" FontWeight="SemiBold" Foreground="{Binding BorderBrush,ElementName=PinnedCounterItem}" TextTrimming="CharacterEllipsis" ToolTip="{Binding HomeSummary}" Margin="0,3,0,5"/>
                              <Grid Grid.Row="2" Margin="0,0,0,4" Visibility="{Binding ShowProgress,Converter={StaticResource BoolVisibility}}" ToolTip="從建立到目前目標的時間經過比例，不代表事件完成度。">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Center" Height="4">
                                  <Border Background="{Binding BorderBrush,ElementName=PinnedCounterItem}" Opacity="0.2" CornerRadius="2"/>
                                  <ProgressBar Style="{StaticResource CountdownBar}" Background="Transparent" Foreground="{Binding BorderBrush,ElementName=PinnedCounterItem}" Height="4" Value="{Binding ElapsedPercent}" Maximum="100" AutomationProperties.Name="釘選倒數已經過比例"/>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding HomeElapsedLabel}" Style="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0"/>
                              </Grid>
                              <DockPanel Grid.Row="3">
                                <Button DockPanel.Dock="Right" Content="&#xE72D;" FontFamily="Segoe MDL2 Assets" Padding="4,0" Margin="6,0,0,0" ToolTip="分享圖片" AutomationProperties.Name="分享圖片" Visibility="{Binding CanShare,Converter={StaticResource BoolVisibility}}" Command="{Binding DataContext.Countdowns.ShareImageCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Foreground="{Binding BorderBrush,ElementName=PinnedCounterItem}" FontWeight="SemiBold" FontSize="11" Margin="6,0,0,0"/>
                                <TextBlock Text="{Binding DateCaption}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding DateCaption}"/>
                              </DockPanel>
                            </Grid>
                          </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                      </pincontrols:PinnedCardsScrollViewer>
                  </Grid>
                </Border>
                <Border x:Name="TodaySummaryCard" Grid.Row="1" Style="{StaticResource Card}" Padding="20" MinHeight="200">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                      <Button DockPanel.Dock="Right" Content="查看任務 →" Command="{Binding OpenTasksCommand}" FontSize="12" Padding="8,4" Margin="8,0,0,0"/>
                      <TextBlock Text="今日進度" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding TodayProgressLabel}" FontSize="21" FontWeight="SemiBold"/>
                    <Grid Margin="0,14,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ProgressBar Value="{Binding TodayProgress,Mode=OneWay}" Maximum="100" Height="7" Style="{StaticResource CountdownBar}" Foreground="{adaptive:AdaptiveBrush #0766FF}" Background="{adaptive:AdaptiveBrush #E1E8F1}" AutomationProperties.Name="今日提醒確認進度" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding TodayProgress,StringFormat={}{0:0}%}" Style="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0"/>
                    </Grid>
                    <UniformGrid Columns="3">
                      <StackPanel><TextBlock Text="{Binding AcknowledgedCount}" FontSize="25" FontWeight="SemiBold" Foreground="{adaptive:AdaptiveBrush #099666}"/><TextBlock Text="已確認完成" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                      <StackPanel><TextBlock Text="{Binding PendingCount}" Foreground="{adaptive:AdaptiveBrush #FF7919}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="待處理" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                      <StackPanel><TextBlock Text="{Binding OverdueCount}" Foreground="{adaptive:AdaptiveBrush #D72540}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="其中逾時未確認" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                    </UniformGrid>
                  </StackPanel>
                </Border>
              </Grid>
              <Border x:Name="HomeAttentionCard" Style="{StaticResource Card}" Padding="16" Visibility="{Binding HasHomeAttention,Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="查看明細與處理 →" Click="OpenConnections" FontSize="12" Padding="10,5" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding HomeAttentionLabel}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{adaptive:AdaptiveBrush #B46B00}"/>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding HomeAttention}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" Foreground="{adaptive:AdaptiveBrush #16243E}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Health.Detail}"/>
                      <ContentControl Grid.Column="1" Content="{Binding Health}" ContentTemplate="{StaticResource HealthIndicator}" Margin="12,0,0,0"/>
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
              </Border>
              <Border x:Name="HomeHealthCard" Style="{StaticResource Card}" Padding="16" Visibility="{Binding HealthTools.HasEnabledTools,Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Content="健康工具 →" Command="{Binding OpenHealthToolsCommand}" VerticalAlignment="Center" FontSize="12" Padding="10,5" Margin="10,0,0,0"/>
                    <StackPanel><TextBlock Text="健康提醒" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding HealthTools.HomeSummary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding HealthTools.Cards}">
                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Visibility" Value="{Binding Enabled,Converter={StaticResource BoolVisibility}}"/></Style></ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding HealthTools.EnabledCount}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <StackPanel Margin="0,4,12,4" ToolTip="{Binding Schedule}">
                        <StackPanel Orientation="Horizontal"><Path Data="{Binding HomeIcon}" Width="18" Height="18" Stretch="Uniform" Stroke="{adaptive:AdaptiveBrush #536982}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" Foreground="{adaptive:AdaptiveBrush #16243E}" FontWeight="SemiBold"/></StackPanel>
                        <TextBlock Text="{Binding Status}" FontSize="12" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="{Binding Countdown}" Foreground="{adaptive:AdaptiveBrush #16243E}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding CountdownUnit}" Style="{StaticResource Muted}" FontSize="11" Margin="5,0,0,3" VerticalAlignment="Bottom"/></StackPanel>
                        <TextBlock Text="{Binding Today}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                      </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="我的任務">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" x:Name="TaskToolbar">
              <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="＋ 新增活動" Command="{Binding NewActivityCommand}" Visibility="{Binding IsTaskCalendar,Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0"/>
                  <Button Content="＋ 新增任務" Command="{Binding NewTaskCommand}" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
                  <Button x:Name="TaskToolsButton" Content="資料工具 ▾" Click="OpenTaskMenu" Margin="0">
                    <Button.ContextMenu>
                      <ContextMenu Style="{StaticResource TaskMenu}" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="匯入 CSV…" Command="{Binding ImportTasksCommand}"/>
                        <MenuItem Header="匯出本機任務 CSV…" Command="{Binding ExportLocalTasksCommand}"/>
                        <MenuItem Header="下載範本 CSV…" Command="{Binding DownloadTaskTemplateCommand}"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>
                </StackPanel>
                <TextBlock Text="我的任務" Style="{StaticResource Heading}" Margin="0" VerticalAlignment="Center"
                           ToolTip="管理本機提醒；雲端任務會自動同步，僅供檢視。"/>
              </DockPanel>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Margin="0,0,10,0">
                  <TextBox x:Name="TaskSearchBox" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Margin="0" Height="36" VerticalContentAlignment="Center" AutomationProperties.Name="搜尋任務名稱或說明"/>
                  <TextBlock Text="搜尋任務名稱或說明" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </Grid>
                <ComboBox Grid.Column="1" Width="150" Margin="0,0,8,0" ItemsSource="{Binding Sources}" SelectedItem="{Binding SourceFilter}" AutomationProperties.Name="依任務來源篩選" ToolTip="依任務來源篩選">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock x:Name="SourceLabel" Text="{Binding}"/>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding}" Value="全部來源"><Setter TargetName="SourceLabel" Property="Text" Value="全部來源"/></DataTrigger>
                      <DataTrigger Binding="{Binding}" Value="本機"><Setter TargetName="SourceLabel" Property="Text" Value="本機任務"/></DataTrigger>
                      <DataTrigger Binding="{Binding}" Value="SheetA"><Setter TargetName="SourceLabel" Property="Text" Value="公司共用"/></DataTrigger>
                      <DataTrigger Binding="{Binding}" Value="SheetB"><Setter TargetName="SourceLabel" Property="Text" Value="團隊共用"/></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Content="↻" Command="{Binding RefreshCommand}" ToolTip="重新整理任務" AutomationProperties.Name="重新整理任務" Margin="0" Padding="12,4"/>
              </Grid>
              <Border Background="{adaptive:AdaptiveBrush #EAF0F7}" CornerRadius="8" Padding="3" HorizontalAlignment="Left" Margin="0,4,0,8">
                <StackPanel Orientation="Horizontal"><StackPanel.Resources><Style TargetType="RadioButton"><Setter Property="Width" Value="72"/><Setter Property="Padding" Value="12,5"/><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #536982}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Segment" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Segment" Property="Background" Value="{adaptive:AdaptiveBrush #FFFFFF}"/><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #0766FF}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/><Setter TargetName="Segment" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></StackPanel.Resources>
                  <RadioButton Content="清單" IsChecked="{Binding IsTaskList,Mode=OneWay}" Command="{Binding ShowTaskListCommand}" GroupName="TaskView"/>
                  <RadioButton Content="月曆" IsChecked="{Binding IsTaskCalendar,Mode=OneWay}" Command="{Binding ShowTaskCalendarCommand}" GroupName="TaskView"/>
                </StackPanel>
              </Border>
              <DockPanel x:Name="TaskSelectionToolbar" Height="44" Margin="0,0,0,4" Visibility="{Binding IsTaskList,Converter={StaticResource BoolVisibility}}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding HasTaskSelection,Converter={StaticResource BoolVisibility}}">
                  <Button Content="{Binding EditTaskLabel}" Command="{Binding EditTaskCommand}" Visibility="{Binding CanEditSelectedTask,Converter={StaticResource BoolVisibility}}" Padding="12,5" Margin="0,0,6,0"/>
                  <Button Content="複製" Command="{Binding CopyTaskCommand}" Visibility="{Binding CanCopySelectedTask,Converter={StaticResource BoolVisibility}}" Padding="12,5" Margin="0,0,6,0" ToolTip="複製為本機任務"/>
                  <Button x:Name="TaskActionsButton" Content="更多操作 ▾" Click="OpenTaskMenu" Padding="12,5" Margin="0,0,6,0" Visibility="{Binding CanCopySelectedTask,Converter={StaticResource BoolVisibility}}">
                    <Button.ContextMenu><ContextMenu Style="{StaticResource TaskMenu}" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
                      <MenuItem Header="啟用／停用" Command="{Binding ToggleTaskCommand}"/>
                      <MenuItem Header="匯出完整觸發日誌…" Command="{Binding ExportTaskTriggerLogCommand}"/>
                      <Separator/>
                      <MenuItem Header="刪除任務…" Command="{Binding DeleteTaskCommand}"/>
                    </ContextMenu></Button.ContextMenu>
                  </Button>
                  <Button x:Name="TaskBatchButton" Content="批次操作 ▾" Click="OpenTaskMenu" Padding="12,5" Margin="0,0,6,0" Visibility="{Binding HasMultipleTaskSelection,Converter={StaticResource BoolVisibility}}">
                    <Button.ContextMenu><ContextMenu Style="{StaticResource TaskMenu}" DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
                      <MenuItem Header="複製所選任務成本機" Command="{Binding BatchTasksCommand}" CommandParameter="copy"/>
                      <MenuItem Header="啟用所選本機任務" Command="{Binding BatchTasksCommand}" CommandParameter="enable"/>
                      <MenuItem Header="停用所選本機任務" Command="{Binding BatchTasksCommand}" CommandParameter="disable"/>
                      <Separator/>
                      <MenuItem Header="刪除所選本機任務…" Command="{Binding BatchTasksCommand}" CommandParameter="delete"/>
                    </ContextMenu></Button.ContextMenu>
                  </Button>
                  <Button Content="取消選取" Click="ClearTaskSelection" Padding="10,5" Margin="0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="全選" Click="SelectAllTasks" Padding="10,5" Margin="0,0,8,0" ToolTip="選取目前篩選結果"/>
                  <TextBlock Text="{Binding CompactSelectionSummary}" ToolTip="{Binding SelectionHint}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
              </DockPanel>
              <TextBlock Text="沒有符合條件的任務。按「新增任務」建立本機提醒。" Style="{StaticResource Muted}" Visibility="{Binding IsTasksEmpty,Converter={StaticResource BoolVisibility}}" Margin="0,6"/>
            </StackPanel>
            <Grid>
            <DataGrid x:Name="TaskGrid" Visibility="{Binding IsTaskList,Converter={StaticResource BoolVisibility}}" ItemsSource="{Binding Tasks}" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="TaskSelectionChanged">
              <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="Padding" Value="6,4"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/>
                <Style.Triggers><Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/>
                </Trigger></Style.Triggers>
              </Style></DataGrid.CellStyle>
              <DataGrid.RowStyle><Style TargetType="DataGridRow">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsLocal}" Value="False">
                    <Setter Property="Background" Value="{adaptive:AdaptiveBrush #F3EFFA}"/>
                    <Setter Property="ToolTip" Value="雲端唯讀：啟用狀態依 Sheet 設定；可選取並複製成本機任務。"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Task.IsGoogleCalendar}" Value="True"><Setter Property="Background" Value="{adaptive:AdaptiveBrush #FAFCFF}"/><Setter Property="ToolTip" Value="Google 日曆：可調整本機提醒開關與時間；行程內容持續由 Google 同步。"/></DataTrigger>
                  <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{adaptive:AdaptiveBrush #E6F0FF}"/></Trigger>
                </Style.Triggers>
              </Style></DataGrid.RowStyle>
              <DataGrid.Columns><DataGridTemplateColumn Header="選取" Width="48" MinWidth="48">
 <DataGridTemplateColumn.CellTemplate><DataTemplate>
  <CheckBox Style="{StaticResource TaskSelectionCheckBox}" HorizontalAlignment="Center" PreviewMouseLeftButtonDown="TaskCheckMouseDown" PreviewKeyDown="TaskCheckKeyDown" IsChecked="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=DataGridRow},Mode=OneWay}" AutomationProperties.Name="選取任務"/>
 </DataTemplate></DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTemplateColumn Header="權限" Width="40" MinWidth="40">
 <DataGridTemplateColumn.CellTemplate><DataTemplate>
  <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" ToolTip="雲端唯讀：不能編輯、刪除或切換啟用；可複製成本機任務。">
   <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding CanAdjustReminder}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
 </DataTemplate></DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
                <DataGridTemplateColumn Header="任務名稱" Width="*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Background="Transparent" Padding="4,0" Cursor="Hand" ToolTip="{Binding Title}" AutomationProperties.HelpText="連按兩下查看詳細訊息" MouseLeftButtonDown="TaskTitleDoubleClick"/>
                  <Button Grid.Column="1" Style="{StaticResource TaskPinButton}" Tag="{Binding IsPinned}" Command="{Binding DataContext.ToggleTaskPinCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="3,2,2,2" ToolTip="{Binding PinLabel}" AutomationProperties.Name="{Binding PinLabel}"/>
                 </Grid>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="日期 / 時間" Binding="{Binding Time}" Width="128" MinWidth="128" />
                <DataGridTemplateColumn Header="等級" CellTemplate="{StaticResource LevelBadge}" Width="90" MinWidth="90" />
                <DataGridTextColumn Header="重複" Binding="{Binding Recurrence}" Width="90" MinWidth="90" />
                <DataGridTemplateColumn Header="狀態" Width="148" MinWidth="148"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource PillSwitch}" IsChecked="{Binding Task.Enabled,Mode=OneWay}" IsEnabled="{Binding CanAdjustReminder}" VerticalAlignment="Center" Margin="0"
                      PreviewMouseLeftButtonDown="TaskStateMouseDown" PreviewKeyDown="TaskStateKeyDown" ToolTip="{Binding StateOrigin}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="任務啟用開關"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding State}"/><TextBlock Text="{Binding StateOrigin}" FontSize="11" Foreground="{adaptive:AdaptiveBrush #70568F}"/></StackPanel>
                  </Grid>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="來源" CellTemplate="{StaticResource SourceBadge}" Width="76" MinWidth="76" />
              </DataGrid.Columns>
            </DataGrid>
            <views:TaskCalendarView xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views" Visibility="{Binding IsTaskCalendar,Converter={StaticResource BoolVisibility}}"/>
            </Grid>
          </DockPanel>
        </TabItem>
        <TabItem Header="歷史紀錄"><TabControl SelectedIndex="{Binding HistoryTabIndex}" Style="{StaticResource FolderTabs}"><TabItem Header="任務提醒" xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views"><views:TaskHistoryView/></TabItem><TabItem Header="番茄鐘" xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views"><views:PomodoroHistoryView DataContext="{Binding Pomodoro}"/></TabItem></TabControl></TabItem>
        <TabItem Header="番茄鐘" xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views"><views:PomodoroView DataContext="{Binding Pomodoro}"/></TabItem>
        <TabItem Header="設定">
          <Grid xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="設定" Style="{StaticResource Heading}"/>
            <views:PreferencesView Grid.Row="1" DataContext="{Binding Preferences}"/>
          </Grid>
        </TabItem>
        <TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views" Header="管理者">
          <views:AdminView Visibility="{Binding Admin.IsAuthenticated,Converter={StaticResource BoolVisibility}}" />
        </TabItem>
        <TabItem Header="倒數日／時間" xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views">
          <views:CountdownsView DataContext="{Binding Countdowns}"/>
        </TabItem>
        <TabItem Header="健康工具" xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views">
          <views:HealthToolsView DataContext="{Binding HealthTools}"/>
        </TabItem>
      </TabControl>
    </DockPanel>
  </Grid>
</Window>
