<Window xmlns:pincontrols="clr-namespace:CloudAlarmOverlay.App.Controls" x:Class="CloudAlarmOverlay.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles" Title="{Binding Title}" Icon="/CloudAlarmOverlay.App;component/Assets/Brand/cloud_alarm_icon.png" Width="1344" Height="960" MinWidth="1050" MinHeight="680" WindowStartupLocation="CenterScreen" Background="{adaptive:AdaptiveBrush #F7FAFE}" Foreground="{adaptive:AdaptiveBrush #16243E}" FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="14">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles/LightTheme.xaml" />
        <ResourceDictionary Source="../Styles/CountdownStyles.xaml" />
        <ResourceDictionary Source="../Styles/PinButtonStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
                <DataTemplate x:Key="NavigationItemTemplate">
                  <Button Click="Navigate" AutomationProperties.Name="{Binding Title}" HorizontalContentAlignment="Stretch">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Padding" Value="12,9"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #697C99}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border x:Name="Nav" Padding="{TemplateBinding Padding}" CornerRadius="7" Background="{TemplateBinding Background}">
                                <ContentPresenter/>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Opacity" Value=".8"/></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/><Setter TargetName="Nav" Property="BorderThickness" Value="1"/></Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="{adaptive:AdaptiveBrush #E6F0FF}"/>
                            <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #0766FF}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Grid>
                  </Button>
                </DataTemplate>
      <pincontrols:PinnedCardHeightConverter x:Key="PinnedCardHeight"/>
      <Style x:Key="HomeShortcut" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="6,14"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Tile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding Foreground}" BorderThickness="0" CornerRadius="12" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderThickness" Value="1"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Tile" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="HomeShortcutIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="27"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,0,12"/>
      </Style>
      <DataTemplate x:Key="HealthIndicator">
       <StackPanel Orientation="Horizontal" ToolTip="{Binding Detail}">
        <TextBlock x:Name="StateIcon" Text="…" FontWeight="Bold" Margin="0,0,4,0" Foreground="{adaptive:AdaptiveBrush #64748B}"/>
        <TextBlock Text="{Binding Label}" FontSize="12"/>
       </StackPanel>
       <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Severity}" Value="Healthy"><Setter TargetName="StateIcon" Property="Text" Value="✓"/><Setter TargetName="StateIcon" Property="Foreground" Value="{adaptive:AdaptiveBrush #18964A}"/></DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter TargetName="StateIcon" Property="Text" Value="!"/><Setter TargetName="StateIcon" Property="Foreground" Value="{adaptive:AdaptiveBrush #BA3D45}"/></DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Stopped"><Setter TargetName="StateIcon" Property="Text" Value="×"/></DataTrigger>
       </DataTemplate.Triggers>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{adaptive:AdaptiveBrush #F7FAFE}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="184" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="54" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.ColumnSpan="2" Background="{adaptive:AdaptiveBrush #F0F5FB}" BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="0,0,0,1" Padding="20,6">
      <Grid>
        <Image Source="/CloudAlarmOverlay.App;component/Assets/Brand/cloud_alarm_horizontal_banner.png" Width="260" Height="40" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="Cloud Alarm Overlay" />
        <TextBlock Text="{Binding DeviceLabel}" HorizontalAlignment="Right" Foreground="{adaptive:AdaptiveBrush #697C99}" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{adaptive:AdaptiveBrush #F0F5FB}" BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,18,12,12">
        <StackPanel DockPanel.Dock="Top" Margin="10,0,0,18">
          <TextBlock Text="工作空間" Foreground="{adaptive:AdaptiveBrush #697C99}" FontSize="12" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <ContentControl x:Name="TaskBuilderNavigation" Content="{Binding TaskBuilderNavigationItem}" ContentTemplate="{StaticResource NavigationItemTemplate}" Margin="0,16,0,12"/>
          <Border Background="{adaptive:AdaptiveBrush #EAF4FF}" Padding="12" CornerRadius="8">
            <StackPanel>
              <StackPanel Orientation="Horizontal"><TextBlock Text="本機排程：" FontSize="12"/><ContentControl Content="{Binding LocalScheduleHealth}" ContentTemplate="{StaticResource HealthIndicator}"/></StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="Sheet A：" FontSize="12"/><ContentControl Content="{Binding SheetAHealth}" ContentTemplate="{StaticResource HealthIndicator}"/></StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="Sheet B：" FontSize="12"/><ContentControl Content="{Binding SheetBHealth}" ContentTemplate="{StaticResource HealthIndicator}"/></StackPanel>
              <TextBlock Text="{Binding DeviceLabel}" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Image Source="/CloudAlarmOverlay.App;component/Assets/Brand/cloud_alarm_wordmark.png" Width="160" Height="22" Stretch="Uniform" Margin="0,18,0,0" AutomationProperties.Name="Cloud Alarm Overlay" />
          <TextBlock Text="讓重要的事，不再遺漏。" FontSize="11" Style="{StaticResource Muted}" Margin="4,6,0,0" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
            <ItemsControl x:Name="PrimaryNavigation" ItemsSource="{Binding NavigationItems}" ItemTemplate="{StaticResource NavigationItemTemplate}"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <DockPanel Grid.Row="1" Grid.Column="1" Margin="20,14,20,10">
      <Border DockPanel.Dock="Bottom" BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" />
      </Border>
      <TabControl SelectedIndex="{Binding PageIndex}" Background="Transparent" Foreground="{adaptive:AdaptiveBrush #16243E}" BorderThickness="0">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <ContentPresenter ContentSource="SelectedContent" />
          </ControlTemplate>
        </TabControl.Template>
        <TabItem Header="首頁">
          <ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel>
              <Border Background="{adaptive:AdaptiveBrush #EEF4FB}" CornerRadius="12" Padding="20,10" Margin="0,0,0,12">
                <UniformGrid Columns="4">
                  <StackPanel><TextBlock Text="國曆日期" Style="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding SolarDate}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                  <StackPanel><TextBlock Text="農曆日期" Style="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding LunarToday}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                  <StackPanel><TextBlock Text="現在時間" Style="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding CurrentClock}" FontSize="22" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                  <StackPanel><TextBlock Text="節氣" Style="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding CurrentSolarTerm}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                </UniformGrid>
              </Border>
              <TextBlock Text="{Binding CalendarWarning}" Foreground="{adaptive:AdaptiveBrush #B46B00}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding HasCalendarWarning,Converter={StaticResource BoolVisibility}}" />
              <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.7*" />
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="NextReminderCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:CloudAlarmOverlay.App.Controls" Style="{StaticResource Card}" Padding="14">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                      <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{adaptive:AdaptiveBrush #0766FF}" FontSize="22" Margin="0,0,10,0" />
                      <TextBlock Text="下一個提醒" FontSize="21" FontWeight="SemiBold" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="{adaptive:AdaptiveBrush #FFF3F5}" BorderBrush="{adaptive:AdaptiveBrush #FFE1E6}" BorderThickness="1" CornerRadius="10" Padding="14" MinHeight="140">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="126" />
                          <ColumnDefinition Width="112" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                          <ContentControl Content="{Binding NextReminder}" ContentTemplate="{StaticResource LevelBadge}" HorizontalAlignment="Left" />
                          <TextBlock Text="{Binding NextTitle}" FontWeight="SemiBold" FontSize="21" TextWrapping="Wrap" MaxHeight="86" TextTrimming="CharacterEllipsis" ToolTip="{Binding NextTitle}" Margin="0,8,0,6" />
                          <TextBlock Text="{Binding NextDescription}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48" ToolTip="{Binding NextDescription}" Margin="0,0,0,10" />
                          <WrapPanel>
                            <ContentControl Content="{Binding NextReminder}" ContentTemplate="{StaticResource SourceBadge}" />
                            <TextBlock Text="🔒 唯讀" FontSize="12" Foreground="{adaptive:AdaptiveBrush #697C99}" Margin="8,0,0,0">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Visible" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding NextReminder.IsLocal}" Value="True">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NextReminder}" Value="{x:Null}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </WrapPanel>
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="{adaptive:AdaptiveBrush #F7D8DE}" BorderThickness="1,0" Padding="6,0">
                          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="{adaptive:AdaptiveBrush #536982}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding NextDate}" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding NextClock}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4" />
                            <TextBlock Text="{Binding NextLunar}" FontSize="12" Foreground="{adaptive:AdaptiveBrush #697C99}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                        <Grid Grid.Column="2" Width="104" Height="104" Margin="8,0,0,0" ToolTip="剩餘時間；環形以 24 小時為一圈">
                          <controls:CountdownRing TrackBrush="{adaptive:AdaptiveBrush #F9CFD5}" ProgressBrush="{adaptive:AdaptiveBrush #E12A43}" RemainingHours="{Binding RemainingHours}" />
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="剩餘" FontSize="13" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CountdownLabel}" Foreground="{adaptive:AdaptiveBrush #D72540}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,3,0,0" />
                          </StackPanel>
                        </Grid>
                      </Grid>
                    </Border>
                  </Grid>
                </Border>
                <Border x:Name="PinnedCountdownCard" Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource Card}" Padding="12" VerticalAlignment="Stretch">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                      <Button DockPanel.Dock="Right" Content="倒數 →" Command="{Binding OpenCountdownsCommand}" FontSize="12" Padding="8,5" Margin="6,0,0,0"/>
                      <Button DockPanel.Dock="Right" Content="任務 →" Command="{Binding OpenTasksCommand}" FontSize="12" Padding="8,5" Margin="6,0,0,0"/>
                      <TextBlock Text="首頁釘選" FontSize="17" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding HomePinSummary}" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
                    <StackPanel Grid.Row="2" Visibility="{Binding IsHomePinsEmpty,Converter={StaticResource BoolVisibility}}">
                      <TextBlock Text="釘選任務追蹤截止時間，或加入倒數／正數；共用名額可於設定調整。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                      <WrapPanel><Button Content="選擇任務" Command="{Binding OpenTasksCommand}" Margin="0,0,8,6"/>
                      <Button Content="＋ 新增倒數" Command="{Binding OpenCountdownsCommand}" Margin="0,0,0,6"/></WrapPanel>
                    </StackPanel>
                      <pincontrols:PinnedCardsScrollViewer x:Name="PinnedCounterScroll" Grid.Row="3" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly" Margin="0,-3,0,-3" AutomationProperties.Name="首頁釘選卡片捲動區">
                        <pincontrols:PinnedCardsScrollViewer.Style><Style TargetType="pincontrols:PinnedCardsScrollViewer">
                          <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HomePins.Count}" Value="0"><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/></DataTrigger>
                            <DataTrigger Binding="{Binding HomePins.Count}" Value="1"><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/></DataTrigger>
                            <DataTrigger Binding="{Binding HomePins.Count}" Value="2"><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/></DataTrigger>
                          </Style.Triggers>
                        </Style></pincontrols:PinnedCardsScrollViewer.Style>
                      <ItemsControl x:Name="PinnedCounterList" ItemsSource="{Binding HomePins}">
                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter">
                          <Setter Property="Height"><Setter.Value><MultiBinding Converter="{StaticResource PinnedCardHeight}">
                            <Binding Path="ViewportHeight" ElementName="PinnedCounterScroll"/>
                            <Binding Path="Items.Count" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                          </MultiBinding></Setter.Value></Setter>
                        </Style></ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                          <Border x:Name="PinnedCounterItem" Style="{StaticResource PinnedCountdownState}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,3,0,3" MinHeight="140">
                            <Grid>
                              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                              <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="&#xE77A;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.UnpinHomeCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="取消首頁釘選（保留原項目及提醒）" AutomationProperties.Name="取消釘選" Background="Transparent" Padding="4" Margin="6,0,0,0"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding ModeIcon}" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{Binding BorderBrush,ElementName=PinnedCounterItem}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Foreground="{adaptive:AdaptiveBrush #16243E}"/>
                                <TextBlock Text="{Binding PinKind}" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                              </DockPanel>
                              <TextBlock x:Name="PinnedCounterValue" Grid.Row="1" VerticalAlignment="Center" Text="{Binding HomeSummary}" TextWrapping="Wrap" MaxHeight="60" FontSize="23" FontWeight="SemiBold" Foreground="{Binding BorderBrush,ElementName=PinnedCounterItem}" TextTrimming="CharacterEllipsis" ToolTip="{Binding HomeSummary}" Margin="0,3,0,5"/>
                              <Grid Grid.Row="2" Margin="0,0,0,4" Visibility="{Binding ShowProgress,Converter={StaticResource BoolVisibility}}" ToolTip="從建立到目前目標的時間經過比例，不代表事件完成度。">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Center" Height="4">
                                  <Border Background="{Binding BorderBrush,ElementName=PinnedCounterItem}" Opacity="0.2" CornerRadius="2"/>
                                  <ProgressBar Style="{StaticResource CountdownBar}" Background="Transparent" Foreground="{Binding BorderBrush,ElementName=PinnedCounterItem}" Height="4" Value="{Binding ElapsedPercent}" Maximum="100" AutomationProperties.Name="釘選倒數已經過比例"/>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding HomeElapsedLabel}" Style="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0"/>
                              </Grid>
                              <DockPanel Grid.Row="3">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Foreground="{Binding BorderBrush,ElementName=PinnedCounterItem}" FontWeight="SemiBold" FontSize="11" Margin="6,0,0,0"/>
                                <TextBlock Text="{Binding DateCaption}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding DateCaption}"/>
                              </DockPanel>
                            </Grid>
                          </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                      </pincontrols:PinnedCardsScrollViewer>
                  </Grid>
                </Border>
                <Border x:Name="TodaySummaryCard" Grid.Row="1" Style="{StaticResource Card}" Padding="14">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                      <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{adaptive:AdaptiveBrush #536982}" Margin="0,0,10,0" />
                      <TextBlock Text="今日任務概況" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <UniformGrid Grid.Row="1" Columns="3" MinHeight="140">
                      <Border Background="{adaptive:AdaptiveBrush #F6FAFF}" BorderBrush="{adaptive:AdaptiveBrush #E2ECF7}" BorderThickness="1" CornerRadius="9" Margin="0,0,7,0" Padding="4,12">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{adaptive:AdaptiveBrush #0766FF}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                          <TextBlock Text="今天總任務" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Text="{Binding TodayCount}" FontSize="34" FontWeight="Bold" Foreground="{adaptive:AdaptiveBrush #0766FF}" />
                            <TextBlock Text="項" FontSize="12" Margin="3,12,0,0" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                      <Border Background="{adaptive:AdaptiveBrush #F6FAFF}" BorderBrush="{adaptive:AdaptiveBrush #E2ECF7}" BorderThickness="1" CornerRadius="9" Margin="0,0,7,0" Padding="4,12">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{adaptive:AdaptiveBrush #F07822}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                          <TextBlock Text="待處理" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Text="{Binding PendingCount}" FontSize="34" FontWeight="Bold" Foreground="{adaptive:AdaptiveBrush #F07822}" />
                            <TextBlock Text="項" FontSize="12" Margin="3,12,0,0" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                      <Border Background="{adaptive:AdaptiveBrush #F6FAFF}" BorderBrush="{adaptive:AdaptiveBrush #E2ECF7}" BorderThickness="1" CornerRadius="9" Margin="0" Padding="4,12">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{adaptive:AdaptiveBrush #099666}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                          <TextBlock Text="已確認完成" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Text="{Binding AcknowledgedCount}" FontSize="34" FontWeight="Bold" Foreground="{adaptive:AdaptiveBrush #099666}" />
                            <TextBlock Text="項" FontSize="12" Margin="3,12,0,0" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </UniformGrid>
                  </Grid>
                </Border>
                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Grid.Row="2" Style="{StaticResource Card}" Padding="14">
                  <StackPanel>
                    <TextBlock Text="常用功能" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <UniformGrid Columns="3">
                      <Button x:Name="HomeNewTask" Command="{Binding NewTaskCommand}" Style="{StaticResource HomeShortcut}" Background="{adaptive:AdaptiveBrush #E6F0FF}" Foreground="{adaptive:AdaptiveBrush #0766FF}" AutomationProperties.Name="新增任務" ToolTip="開啟新增本機任務視窗">
                        <StackPanel><TextBlock Text="&#xE710;" Style="{StaticResource HomeShortcutIcon}"/><TextBlock Text="新增任務" HorizontalAlignment="Center"/></StackPanel>
                      </Button>
                      <Button x:Name="HomeCountdown" Command="{Binding OpenCountdownsCommand}" Style="{StaticResource HomeShortcut}" Background="{adaptive:AdaptiveBrush #F0F5FB}" Foreground="{adaptive:AdaptiveBrush #3664A0}" AutomationProperties.Name="新增倒數" ToolTip="前往倒數／正數功能頁">
                        <StackPanel><TextBlock Text="&#xE787;" Style="{StaticResource HomeShortcutIcon}"/><TextBlock Text="新增倒數" HorizontalAlignment="Center"/></StackPanel>
                      </Button>
                      <Button x:Name="HomePomodoro" Command="{Binding OpenPomodoroCommand}" Style="{StaticResource HomeShortcut}" Background="{adaptive:AdaptiveBrush #FFF3F5}" Foreground="{adaptive:AdaptiveBrush #B13C5A}" Margin="0" AutomationProperties.Name="番茄鐘" ToolTip="前往番茄鐘功能頁">
                        <StackPanel><TextBlock Text="&#xE916;" Style="{StaticResource HomeShortcutIcon}"/><TextBlock Text="番茄鐘" HorizontalAlignment="Center"/></StackPanel>
                      </Button>
                    </UniformGrid>

                  </StackPanel>
                </Border>
                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                      <Button DockPanel.Dock="Right" Content="立即同步" Command="{Binding SyncCommand}" Padding="7,4" FontSize="12" Margin="8,0,0,0"/>
                      <TextBlock Text="⟳ 雲端同步狀態" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Background="{adaptive:AdaptiveBrush #F2F7FF}" CornerRadius="7" Padding="10,9" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="70" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Sheet A" Foreground="{adaptive:AdaptiveBrush #0766FF}" FontWeight="SemiBold" ToolTip="公司排程" />
                        <TextBlock Grid.Column="1" Text="{Binding SheetAStatus}" Foreground="{adaptive:AdaptiveBrush #697C99}" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="18" ToolTip="{Binding SheetAStatus}" />
                      </Grid>
                    </Border>
                    <Border Background="{adaptive:AdaptiveBrush #F0FAF5}" CornerRadius="7" Padding="10,9" Margin="0,0,0,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="70" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Sheet B" Foreground="{adaptive:AdaptiveBrush #159447}" FontWeight="SemiBold" ToolTip="團隊任務" />
                        <TextBlock Grid.Column="1" Text="{Binding SheetBStatus}" Foreground="{adaptive:AdaptiveBrush #697C99}" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="18" ToolTip="{Binding SheetBStatus}" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
              </Grid>
              <Border Style="{StaticResource Card}" Padding="16" Margin="0">
                <StackPanel>
                  <DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="查看全部任務 →" Command="{Binding OpenTasksCommand}" Background="Transparent" Foreground="{adaptive:AdaptiveBrush #0766FF}" Padding="8,4" Margin="0" />
                    <TextBlock Text="◷ 即將到來的任務" FontWeight="SemiBold" FontSize="18" />
                  </DockPanel>
                  <TextBlock Text="目前沒有待辦提醒，新增第一個任務開始使用。" Style="{StaticResource Muted}" Visibility="{Binding IsUpcomingEmpty,Converter={StaticResource BoolVisibility}}" Margin="0,12" />
                  <DataGrid ItemsSource="{Binding Upcoming}" MaxHeight="300" ColumnHeaderHeight="34" RowHeight="36">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="時間" Binding="{Binding NextTime}" Width="120" />
                      <DataGridTemplateColumn Header="任務標題" Width="*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                          <TextBlock Text="{Binding Title}" Background="Transparent" Padding="5" Cursor="Hand" ToolTip="連按兩下查看詳細訊息" MouseLeftButtonDown="TaskTitleDoubleClick"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="來源" CellTemplate="{StaticResource SourceBadge}" Width="110" />
                      <DataGridTemplateColumn Header="提醒等級" CellTemplate="{StaticResource LevelBadge}" Width="110" />
                      <DataGridTextColumn Header="狀態" Binding="{Binding UpcomingState}" Width="90" />
                      <DataGridTextColumn Header="備註" Binding="{Binding Task.Note}" Width="1.1*" />
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="我的任務">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="我的任務" Style="{StaticResource Heading}" />
              <TextBlock Text="管理本機提醒；雲端任務會自動同步，僅供檢視。" Style="{StaticResource Muted}" Margin="0,0,0,10" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="搜尋任務名稱或說明" Margin="0,0,8,8" Height="34" VerticalContentAlignment="Center" />
                <Button Grid.Column="1" Content="＋ 新增任務" Command="{Binding NewTaskCommand}" Style="{StaticResource Primary}" Margin="0,0,0,8" />
              </Grid>
              <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="任務來源" Foreground="{adaptive:AdaptiveBrush #697C99}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SourceFilter}" Style="{StaticResource SegmentedSelector}" AutomationProperties.Name="依任務來源篩選">
                  <ListBox.ItemTemplate><DataTemplate>
                    <TextBlock x:Name="SourceLabel" Text="{Binding}"/>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding}" Value="全部來源"><Setter TargetName="SourceLabel" Property="Text" Value="全部"/></DataTrigger>
                      <DataTrigger Binding="{Binding}" Value="本機"><Setter TargetName="SourceLabel" Property="Text" Value="本機任務"/><Setter TargetName="SourceLabel" Property="ToolTip" Value="這台電腦建立的提醒"/></DataTrigger>
                      <DataTrigger Binding="{Binding}" Value="SheetA"><Setter TargetName="SourceLabel" Property="Text" Value="公司共用"/><Setter TargetName="SourceLabel" Property="ToolTip" Value="SheetA · 公司共用任務，僅供檢視"/></DataTrigger>
                      <DataTrigger Binding="{Binding}" Value="SheetB"><Setter TargetName="SourceLabel" Property="Text" Value="團隊共用"/><Setter TargetName="SourceLabel" Property="ToolTip" Value="SheetB · 團隊共用任務，僅供檢視"/></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </WrapPanel>
              <WrapPanel Margin="0,0,0,8">
                <Button Content="編輯" ToolTip="{Binding SelectionHint}" ToolTipService.ShowOnDisabled="True" Command="{Binding EditTaskCommand}" />
                <Button Content="複製" ToolTip="{Binding SelectionHint}" ToolTipService.ShowOnDisabled="True" Command="{Binding CopyTaskCommand}" />
                <Button Content="啟用／停用" ToolTip="{Binding SelectionHint}" ToolTipService.ShowOnDisabled="True" Command="{Binding ToggleTaskCommand}" />
                <Button Content="刪除" ToolTip="{Binding SelectionHint}" ToolTipService.ShowOnDisabled="True" Command="{Binding DeleteTaskCommand}" />
                <Button Content="匯出完整觸發日誌" Command="{Binding ExportTaskTriggerLogCommand}" ToolTip="匯出此任務每一次排定觸發的完整紀錄，含未產生簽收結果的觸發失敗情形" />
                <Button Content="重新整理" Command="{Binding RefreshCommand}" /><Button Content="全選結果" Click="SelectAllTasks"/>
              </WrapPanel>
              <WrapPanel Margin="0,0,0,8" Visibility="{Binding HasTaskSelection,Converter={StaticResource BoolVisibility}}">
 <Button Content="取消選取" Click="ClearTaskSelection"/>
 <Button Content="批次複製成本機" Command="{Binding BatchTasksCommand}" CommandParameter="copy"/>
 <Button Content="啟用所選本機" Command="{Binding BatchTasksCommand}" CommandParameter="enable"/>
 <Button Content="停用所選本機" Command="{Binding BatchTasksCommand}" CommandParameter="disable"/>
 <Button Content="刪除所選本機" Command="{Binding BatchTasksCommand}" CommandParameter="delete"/>
</WrapPanel>
<TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Muted}" Visibility="{Binding HasTaskSelection,Converter={StaticResource BoolVisibility}}"/>
<TextBlock Text="{Binding SelectionHint}" Style="{StaticResource Muted}" Margin="0,4,0,8"/><TextBlock Text="沒有符合條件的任務。按「新增任務」建立本機提醒。" Style="{StaticResource Muted}" Visibility="{Binding IsTasksEmpty,Converter={StaticResource BoolVisibility}}" Margin="0,12" />
            </StackPanel>
            <DataGrid x:Name="TaskGrid" ItemsSource="{Binding Tasks}" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="TaskSelectionChanged">
              <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="Padding" Value="6,4"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/>
                <Style.Triggers><Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/>
                </Trigger></Style.Triggers>
              </Style></DataGrid.CellStyle>
              <DataGrid.RowStyle><Style TargetType="DataGridRow">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsLocal}" Value="False">
                    <Setter Property="Background" Value="{adaptive:AdaptiveBrush #F3EFFA}"/>
                    <Setter Property="ToolTip" Value="雲端唯讀：啟用狀態依 Sheet 設定；可選取並複製成本機任務。"/>
                  </DataTrigger>
                  <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{adaptive:AdaptiveBrush #E6F0FF}"/></Trigger>
                </Style.Triggers>
              </Style></DataGrid.RowStyle>
              <DataGrid.Columns><DataGridTemplateColumn Header="選取" Width="44">
 <DataGridTemplateColumn.CellTemplate><DataTemplate>
  <CheckBox Style="{StaticResource TaskSelectionCheckBox}" HorizontalAlignment="Center" PreviewMouseLeftButtonDown="TaskCheckMouseDown" PreviewKeyDown="TaskCheckKeyDown" IsChecked="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=DataGridRow},Mode=OneWay}" AutomationProperties.Name="選取任務"/>
 </DataTemplate></DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTemplateColumn Header="權限" Width="44">
 <DataGridTemplateColumn.CellTemplate><DataTemplate>
  <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" ToolTip="雲端唯讀：不能編輯、刪除或切換啟用；可複製成本機任務。">
   <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding IsLocal}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
 </DataTemplate></DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
                <DataGridTemplateColumn Header="任務名稱" Width="*" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Background="Transparent" Padding="4,0" Cursor="Hand" ToolTip="{Binding Title}" AutomationProperties.HelpText="連按兩下查看詳細訊息" MouseLeftButtonDown="TaskTitleDoubleClick"/>
                  <Button Grid.Column="1" Style="{StaticResource TaskPinButton}" Tag="{Binding IsPinned}" Command="{Binding DataContext.ToggleTaskPinCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="3,2,2,2" ToolTip="{Binding PinLabel}" AutomationProperties.Name="{Binding PinLabel}"/>
                 </Grid>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="日期 / 時間" Binding="{Binding Time}" Width="136" MinWidth="136" />
                <DataGridTemplateColumn Header="等級" CellTemplate="{StaticResource LevelBadge}" Width="90" MinWidth="90" />
                <DataGridTextColumn Header="重複" Binding="{Binding Recurrence}" Width="102" MinWidth="90" />
                <DataGridTemplateColumn Header="狀態" Width="148" MinWidth="148"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource PillSwitch}" IsChecked="{Binding Task.Enabled,Mode=OneWay}" IsEnabled="{Binding IsLocal}" VerticalAlignment="Center" Margin="0"
                      PreviewMouseLeftButtonDown="TaskStateMouseDown" PreviewKeyDown="TaskStateKeyDown" ToolTip="{Binding StateOrigin}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="任務啟用開關"/>
                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding State}"/><TextBlock Text="{Binding StateOrigin}" FontSize="11" Foreground="{adaptive:AdaptiveBrush #70568F}"/></StackPanel>
                  </Grid>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="來源" CellTemplate="{StaticResource SourceBadge}" Width="72" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="歷史紀錄"><TabControl SelectedIndex="{Binding HistoryTabIndex}" Style="{StaticResource FolderTabs}"><TabItem Header="任務提醒" xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views"><views:TaskHistoryView/></TabItem><TabItem Header="番茄鐘" xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views"><views:PomodoroHistoryView DataContext="{Binding Pomodoro}"/></TabItem></TabControl></TabItem>
        <TabItem Header="番茄鐘" xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views"><views:PomodoroView DataContext="{Binding Pomodoro}"/></TabItem>
        <TabItem Header="設定">
          <Grid xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="設定" Style="{StaticResource Heading}"/>
            <views:PreferencesView Grid.Row="1" DataContext="{Binding Preferences}"/>
          </Grid>
        </TabItem>
        <TabItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views" Header="管理者">
          <views:AdminView Visibility="{Binding Admin.IsAuthenticated,Converter={StaticResource BoolVisibility}}" />
        </TabItem>
        <TabItem Header="倒數日／時間" xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views">
          <views:CountdownsView DataContext="{Binding Countdowns}"/>
        </TabItem>
      </TabControl>
    </DockPanel>
  </Grid>
</Window>
