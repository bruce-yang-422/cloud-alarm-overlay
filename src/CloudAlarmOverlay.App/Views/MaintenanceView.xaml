<UserControl x:Class="CloudAlarmOverlay.App.Views.MaintenanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/LightTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <StackPanel>
  <TextBlock Text="外觀與資料" FontSize="20" FontWeight="SemiBold"/>
  <TextBlock Text="明暗模式" Margin="0,12,0,6"/>
  <ListBox Style="{StaticResource SegmentedSelector}" ItemsSource="{Binding Themes}" SelectedItem="{Binding ThemeChoice}" HorizontalAlignment="Left"/>
  <TextBlock Text="色彩風格" Margin="0,12,0,6"/>
  <ListBox Style="{StaticResource SegmentedSelector}" ItemsSource="{Binding ThemeColors}" SelectedItem="{Binding ThemeColorChoice}" HorizontalAlignment="Left"/>
  <TextBlock Text="跟隨系統會隨 Windows 切換明暗，並保留選擇的色彩風格。" Margin="0,6,0,12" TextWrapping="Wrap"/>
  <Border Style="{StaticResource Card}" Margin="0,0,0,14">
   <StackPanel>
    <TextBlock Text="視窗行為" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <CheckBox Content="縮放時維持寬高比例" IsChecked="{Binding KeepWindowAspectRatio}" Style="{StaticResource PillSwitch}" VerticalAlignment="Center" Margin="0,0,20,0"/>
     <TextBlock Grid.Column="1" Text="開啟後，拖曳主視窗邊框時維持拖曳前的比例。關閉可自由調整寬高；最大化不受影響。變更自動儲存。" Style="{StaticResource Muted}" FontSize="12"/>
    </Grid>
   </StackPanel>
  </Border>
  <TextBlock Text="軟體更新" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,6"/>
  <TextBlock Text="{Binding VersionLabel}"/>
  <TextBlock Text="公開 version.json 連結（管理者可設定）" Margin="0,12,0,0"/>
  <TextBox Text="{Binding UpdateUrl,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditUpdateUrl}" AutomationProperties.Name="更新資訊 HTTPS 連結" ToolTip="只有登入管理員後才能修改公開更新網址"/>
  <WrapPanel><Button Content="儲存更新來源" Command="{Binding SaveUpdateUrlCommand}"/><Button Content="檢查更新" Command="{Binding CheckUpdateCommand}"/><Button Content="下載新版安裝檔" Command="{Binding OpenDownloadCommand}"/></WrapPanel>
  <Border Style="{StaticResource Card}" Margin="0,16,0,0">
   <StackPanel>
    <TextBlock Text="恢復初始狀態" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock Text="清除這台電腦的全部程式資料與設定，包含管理者帳密、任務及歷史。需管理者驗證；確認後關閉程式，下次啟動回到首次設定。建議先至管理員專區建立備份。" TextWrapping="Wrap" Margin="0,8,0,8"/>
    <Button Content="重置所有資料與設定…" Click="ResetAll" HorizontalAlignment="Left"/>
   </StackPanel>
  </Border>
  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,16,0,0"/>
 </StackPanel>
</UserControl>
