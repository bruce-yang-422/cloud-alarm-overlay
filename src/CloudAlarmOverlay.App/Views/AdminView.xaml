<UserControl xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="clr-namespace:CloudAlarmOverlay.App.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CloudAlarmOverlay.App.Views.AdminView" Loaded="WorkspaceLoaded" Unloaded="WorkspaceUnloaded" SizeChanged="ResizeWorkspace" FontSize="14">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles/AdminWorkspaceStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="ConnectionStateText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #697C99}" />
        <Style.Triggers>
          <Trigger Property="Text" Value="測試中">
            <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #1668CA}" />
          </Trigger>
          <Trigger Property="Text" Value="成功">
            <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #147A46}" />
          </Trigger>
          <Trigger Property="Text" Value="部分失敗">
            <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #A15C00}" />
          </Trigger>
          <Trigger Property="Text" Value="失敗">
            <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #B42318}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <CollectionViewSource x:Key="AdminNavigation" Source="{Binding Admin.Navigation}">
        <CollectionViewSource.GroupDescriptions>
          <PropertyGroupDescription PropertyName="Group" />
        </CollectionViewSource.GroupDescriptions>
      </CollectionViewSource>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel LastChildFill="False" Margin="0,0,0,18">
      <Button x:Name="NavigationToggle" Content="☰" Click="ToggleNavigation" Visibility="Collapsed" Margin="0,0,12,0" AutomationProperties.Name="開啟管理功能導覽" />
      <TextBlock Text="管理者專區" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right" Content="登出管理者" Command="{Binding Admin.LogoutCommand}" Visibility="{Binding Admin.IsCompanyMode,Converter={StaticResource BoolVisibility}}" Margin="12,0,0,0" />
      <TextBlock x:Name="AccessCaption" Text="{Binding Admin.AccessDescription}" ToolTip="{Binding Admin.AccessDescription}" Style="{StaticResource WorkspaceMuted}" FontSize="12" Margin="18,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <Grid Grid.Row="1" x:Name="WorkspaceGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavigationColumn" Width="184" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="NavigationPanel" Panel.ZIndex="2" Background="{adaptive:AdaptiveBrush WorkspaceSidebar}" BorderBrush="{adaptive:AdaptiveBrush WorkspaceBorder}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8" Padding="8,12">
        <ListBox x:Name="NavigationList" ItemsSource="{Binding Source={StaticResource AdminNavigation}}" SelectedValuePath="Index" SelectedValue="{Binding Admin.SelectedTab,Mode=TwoWay}" ItemContainerStyle="{StaticResource AdminNavigationItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="管理功能分類">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource AdminNavGroup}" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="25" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{adaptive:AdaptiveBrush WorkspaceMuted}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="{adaptive:AdaptiveBrush WorkspaceText}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Border Grid.Column="1" BorderBrush="{adaptive:AdaptiveBrush WorkspaceBorder}" BorderThickness="1" CornerRadius="0,8,8,0" Background="{adaptive:AdaptiveBrush WorkspaceSurface}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TabControl x:Name="AdminPages" Style="{StaticResource AdminContentTabs}" SelectedIndex="{Binding Admin.SelectedTab}" IsEnabled="{Binding Admin.IsAuthenticated}">
            <TabItem Header="總覽">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Style="{StaticResource AdminScroll}">
                  <StackPanel HorizontalAlignment="Stretch" Style="{StaticResource AdminBody}">
                    <TextBlock Text="總覽" Style="{StaticResource AdminTitle}" />
                    <TextBlock Text="管理共用資料、使用者政策與維護工具。" Style="{StaticResource AdminDescription}" />
                    <Border Style="{StaticResource AdminCard}">
                      <StackPanel>
                        <TextBlock Text="此電腦的管理設定" Style="{StaticResource WorkspaceSection}" />
                        <TextBlock Text="{Binding Admin.AccessDescription}" Style="{StaticResource AdminDescription}" />
                        <TextBlock Text="{Binding Admin.Version,StringFormat=目前版本：{0}}" />
                        <TextBlock Text="公司預設只影響此電腦，不會遠端推送到其他同事的電腦。" Style="{StaticResource AdminResult}" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AdminCard}">
                      <StackPanel>
                        <TextBlock Text="連線與資料" Style="{StaticResource WorkspaceSection}" />
                        <TextBlock Text="{Binding ConnectionSummary}" Style="{StaticResource AdminDescription}" />
                        <StackPanel>
                          <Button Content="共用試算表" Tag="1" Click="Navigate" Style="{StaticResource AdminNavigationLink}" />
                          <Button Content="農曆與假日" Tag="2" Click="Navigate" Style="{StaticResource AdminNavigationLink}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AdminCard}">
                      <StackPanel>
                        <TextBlock Text="政策與維護" Style="{StaticResource WorkspaceSection}" />
                        <StackPanel>
                          <Button Content="使用者政策" Tag="3" Click="Navigate" Style="{StaticResource AdminNavigationLink}" />
                          <Button Content="安全與存取" Tag="4" Click="Navigate" Style="{StaticResource AdminNavigationLink}" />
                          <Button Content="備份與移轉" Tag="6" Click="Navigate" Style="{StaticResource AdminNavigationLink}" />
                          <Button Content="紀錄查詢" Tag="7" Click="Navigate" Style="{StaticResource AdminNavigationLink}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </TabItem>
            <TabItem Header="共用試算表">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Style="{StaticResource AdminScroll}">
                  <StackPanel HorizontalAlignment="Stretch" Style="{StaticResource AdminWideBody}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="共用試算表" Style="{StaticResource AdminTitle}" />
                        <TextBlock Text="管理以公開 CSV 讀取的公司與團隊資料。" Style="{StaticResource AdminDescription}" />
                      </StackPanel>
                      <Button Content="立即同步" Command="{Binding SyncCommand}" HorizontalAlignment="Right" Margin="12,0,0,0" Grid.Column="1" VerticalAlignment="Top" />
                    </Grid>
                    <Border Style="{StaticResource AdminCard}" Padding="12">
                      <DockPanel LastChildFill="False">
                        <TextBlock Text="{Binding Admin.LinkState}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="{Binding Admin.LinkToggleText}" Command="{Binding Admin.ToggleLinksCommand}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                          <TextBlock Text="同步間隔" Style="{StaticResource WorkspaceMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                          <ComboBox x:Name="SyncInterval" ItemsSource="{Binding Admin.IntervalChoices}" SelectedItem="{Binding IntervalSeconds}" Width="100" IsEnabled="{Binding Admin.LinksEditable}" AutomationProperties.Name="共用同步間隔秒數" ItemStringFormat="{}{0} 秒" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <Grid x:Name="SourceCards" SizeChanged="ResizeSourceCards">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Style="{StaticResource AdminCard}" x:Name="SourceA">
                        <StackPanel>
                          <TextBlock Text="Sheet A · 公司共用" FontSize="16" FontWeight="SemiBold" />
                          <TextBlock Text="任務、假日、人員例外與農曆對照" Style="{StaticResource WorkspaceMuted}" Margin="0,4,0,10" />
                          <StackPanel IsEnabled="{Binding Admin.LinksEditable}">
                            <TextBlock Text="Spreadsheet ID" Style="{StaticResource WorkspaceMuted}" />
                            <TextBox Text="{Binding SheetAId,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sheet A Spreadsheet ID" />
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>
                              <StackPanel>
                                <TextBlock Text="Tasks GID" />
                                <TextBox Text="{Binding TasksAGid,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tasks GID" />
                              </StackPanel>
                              <StackPanel Grid.Column="2">
                                <TextBlock Text="Holidays GID" />
                                <TextBox Text="{Binding HolidaysGid,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Holidays GID" />
                              </StackPanel>
                              <StackPanel Grid.Row="1">
                                <TextBlock Text="Employees GID" />
                                <TextBox Text="{Binding EmployeesGid,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Employees GID" />
                              </StackPanel>
                              <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="LunarCalendar GID" />
                                <TextBox Text="{Binding LunarGid,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="LunarCalendar GID" />
                              </StackPanel>
                            </Grid>
                          </StackPanel>
                          <Button Content="測試連線" Command="{Binding TestSheetACommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                          <Border BorderBrush="{adaptive:AdaptiveBrush #D6E1EF}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0" DataContext="{Binding Admin}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>
                              <TextBlock Text="連線狀態" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="1" Text="{Binding SheetATestState}" Style="{StaticResource ConnectionStateText}" />
                              <TextBlock Grid.Row="1" Text="Tasks" Style="{StaticResource WorkspaceMuted}" />
                              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SheetATasksStatus}" TextWrapping="Wrap" />
                              <TextBlock Grid.Row="2" Text="Holidays" Style="{StaticResource WorkspaceMuted}" />
                              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SheetAHolidaysStatus}" TextWrapping="Wrap" />
                              <TextBlock Grid.Row="3" Text="Employees" Style="{StaticResource WorkspaceMuted}" />
                              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SheetAEmployeesStatus}" TextWrapping="Wrap" />
                              <TextBlock Grid.Row="4" Text="LunarCalendar" Style="{StaticResource WorkspaceMuted}" />
                              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SheetALunarStatus}" TextWrapping="Wrap" />
                              <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="{Binding SheetATestedAt}" Style="{StaticResource WorkspaceMuted}" FontSize="11" Margin="0,6,0,0" />
                            </Grid>
                          </Border>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2" Style="{StaticResource AdminCard}" x:Name="SourceB">
                        <StackPanel>
                          <TextBlock Text="Sheet B · 團隊共用" FontSize="16" FontWeight="SemiBold" />
                          <TextBlock Text="額外的團隊任務" Style="{StaticResource WorkspaceMuted}" Margin="0,4,0,10" />
                          <StackPanel IsEnabled="{Binding Admin.LinksEditable}">
                            <TextBlock Text="Spreadsheet ID" Style="{StaticResource WorkspaceMuted}" />
                            <TextBox Text="{Binding SheetBId,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sheet B Spreadsheet ID" />
                            <TextBlock Text="Tasks GID" Style="{StaticResource WorkspaceMuted}" />
                            <TextBox Text="{Binding TasksBGid,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Sheet B Tasks GID" />
                          </StackPanel>
                          <Button Content="測試連線" Command="{Binding TestSheetBCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                          <Border BorderBrush="{adaptive:AdaptiveBrush #D6E1EF}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0" DataContext="{Binding Admin}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>
                              <TextBlock Text="連線狀態" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="1" Text="{Binding SheetBTestState}" Style="{StaticResource ConnectionStateText}" />
                              <TextBlock Grid.Row="1" Text="Tasks" Style="{StaticResource WorkspaceMuted}" />
                              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SheetBTasksStatus}" TextWrapping="Wrap" />
                              <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SheetBTestedAt}" Style="{StaticResource WorkspaceMuted}" FontSize="11" Margin="0,6,0,0" />
                            </Grid>
                          </Border>
                        </StackPanel>
                      </Border>
                    </Grid>
                    <TextBlock Text="來源 ID 留空可停用。測試只檢查下載與格式；設定儲存後才套用同步。" Style="{StaticResource AdminDescription}" />
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </TabItem>
            <TabItem Header="農曆與假日">
              <views:CalendarDataView x:Name="CalendarPage" DataContext="{Binding Admin.CalendarData}" Margin="24" />
            </TabItem>
            <TabItem Header="使用者政策">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Style="{StaticResource AdminScroll}">
                  <StackPanel HorizontalAlignment="Stretch" Style="{StaticResource AdminBody}">
                    <TextBlock Text="使用者政策" Style="{StaticResource AdminTitle}" />
                    <TextBlock Text="設定一般使用者可調整的項目與公司預設值。" Style="{StaticResource AdminDescription}" />
                    <StackPanel DataContext="{Binding Admin}">
                      <Border Style="{StaticResource AdminCard}">
                        <StackPanel>
                          <TextBlock Text="通知限制" Style="{StaticResource WorkspaceSection}" />
                          <Border Style="{StaticResource AdminRow}">
                            <CheckBox IsChecked="{Binding LockFlash}" Style="{StaticResource SettingsSwitch}">
                              <StackPanel>
                                <TextBlock Text="鎖定閃爍設定" FontWeight="SemiBold" />
                                <TextBlock Text="禁止一般使用者調整閃爍參數。" Style="{StaticResource AdminResult}" Margin="0,4,0,0" />
                              </StackPanel>
                            </CheckBox>
                          </Border>
                          <Border Style="{StaticResource AdminRow}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <StackPanel>
                                <TextBlock Text="閃爍間隔" FontWeight="SemiBold" />
                                <TextBlock Text="200–5000 毫秒" Style="{StaticResource AdminResult}" Margin="0,4,0,0" />
                              </StackPanel>
                              <ComboBox Grid.Column="1" ItemsSource="{Binding Preferences.FlashChoices}" IsEditable="True" Text="{Binding FlashMilliseconds,UpdateSourceTrigger=PropertyChanged}" Width="150" VerticalAlignment="Center" />
                            </Grid>
                          </Border>
                          <Border Style="{StaticResource AdminRow}">
                            <CheckBox IsChecked="{Binding LockQuiet}" Style="{StaticResource SettingsSwitch}">
                              <StackPanel>
                                <TextBlock Text="鎖定靜音時段" FontWeight="SemiBold" />
                                <TextBlock Text="保留現有時段，禁止一般使用者修改。" Style="{StaticResource AdminResult}" Margin="0,4,0,0" />
                              </StackPanel>
                            </CheckBox>
                          </Border>
                          <Border Padding="0,13,0,0">
                            <CheckBox IsChecked="{Binding AllowUrgentSnooze}" Style="{StaticResource SettingsSwitch}">
                              <StackPanel>
                                <TextBlock Text="允許緊急提醒稍後提醒" FontWeight="SemiBold" />
                                <TextBlock Text="每次通知最多可延後 3 次。" Style="{StaticResource AdminResult}" Margin="0,4,0,0" />
                              </StackPanel>
                            </CheckBox>
                          </Border>
                        </StackPanel>
                      </Border>
                      <TextBlock Text="音效開關仍由使用者自行調整。" Style="{StaticResource AdminDescription}" />
                      <Border Style="{StaticResource AdminCard}">
                        <StackPanel DataContext="{Binding Preferences.Weather}">
                          <TextBlock Text="公司預設天氣地點" Style="{StaticResource WorkspaceSection}" />
                          <views:WeatherLocationPicker />
                          <TextBlock Text="選擇地點後，按下方儲存變更套用。" Style="{StaticResource AdminResult}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </TabItem>
            <TabItem Header="安全與存取">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Style="{StaticResource AdminScroll}">
                  <StackPanel HorizontalAlignment="Stretch" Style="{StaticResource AdminBody}">
                    <TextBlock Text="安全與存取" Style="{StaticResource AdminTitle}" />
                    <TextBlock Text="管理身分驗證與結束程式保護。" Style="{StaticResource AdminDescription}" />
                    <StackPanel DataContext="{Binding Admin}">
                      <Border Style="{StaticResource AdminCard}" Visibility="{Binding IsCompanyMode,Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                          <TextBlock Text="管理者身分" Style="{StaticResource WorkspaceSection}" />
                          <TextBlock Text="{Binding AdminUsername}" FontWeight="SemiBold" />
                          <TextBlock Text="登入固定有效 10 分鐘，操作不會延長。" Style="{StaticResource AdminResult}" />
                          <Button Content="修改帳號與密碼…" Click="ChangeAdminCredentials" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        </StackPanel>
                      </Border>
                      <Border Style="{StaticResource AdminCard}">
                        <StackPanel>
                          <TextBlock Text="結束程式保護" Style="{StaticResource WorkspaceSection}" />
                          <CheckBox Content="結束程式時要求密碼" IsChecked="{Binding ExitPasswordRequired}" Style="{StaticResource SettingsSwitch}" />
                          <TextBlock Text="{Binding ExitPasswordModeLabel}" Style="{StaticResource AdminResult}" />
                          <TextBlock Text="從系統匣結束程式前驗證。個人使用請先設定專用密碼。" Style="{StaticResource AdminResult}" />
                          <WrapPanel Margin="0,16,0,0">
                            <Button Content="設定／重設專用密碼…" Click="SetExitPassword" />
                            <Button Content="改用管理者帳密…" Click="UseAdminExitPassword" Visibility="{Binding IsCompanyMode,Converter={StaticResource BoolVisibility}}" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <Expander x:Name="GoogleLoginAdvanced" Header="進階：自訂 Google 登入" IsExpanded="False" Expanded="LoadGoogleLoginSettings" FontSize="12" Margin="0,16,0,0">
                      <StackPanel x:Name="GoogleLoginSettings" MaxWidth="760" HorizontalAlignment="Left" DataContext="{Binding Admin.Preferences.Google}">
                        <StackPanel.Resources>
                          <ResourceDictionary>
                            <ResourceDictionary.MergedDictionaries>
                              <ResourceDictionary Source="../Styles/SettingsFormStyles.xaml" />
                            </ResourceDictionary.MergedDictionaries>
                          </ResourceDictionary>
                        </StackPanel.Resources>
                        <TextBlock Text="一般使用者直接使用程式內建的 Google 登入，不需要自行設定 JSON。" Style="{StaticResource WorkspaceMuted}" Margin="0,0,0,20" />
                        <Border Style="{StaticResource SettingsGroup}">
                          <StackPanel>
                            <TextBlock Text="目前登入方式" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding ConfigurationStatus}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,14" />
                            <TextBlock Text="僅在組織要求使用自訂 Google Cloud 專案時匯入設定。切換前請先登出所有 Google 帳號。" Style="{StaticResource WorkspaceMuted}" FontSize="12" />
                            <WrapPanel Margin="0,16,0,0" IsEnabled="{Binding CanAct}">
                              <Button x:Name="ImportGoogleClientButton" Click="ImportGoogleClient" Style="{StaticResource SettingsPrimary}">
                                <TextBlock Text="匯入桌面 OAuth 設定…" Foreground="{adaptive:AdaptiveBrush AccentText}" />
                              </Button>
                              <Button x:Name="RestoreGoogleClientButton" Content="恢復程式預設" Command="{Binding UseBuiltInClientCommand}" />
                              <Button Content="設定說明" Click="OpenGoogleLoginGuide" />
                            </WrapPanel>
                          </StackPanel>
                        </Border>
                        <TextBlock Text="接受 OAuth「桌面應用程式」JSON（installed）。服務帳戶私鑰（service_account）不適用於使用者登入，此處不接受匯入。" Style="{StaticResource WorkspaceMuted}" FontSize="12" />

                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </TabItem>
            <TabItem Header="啟動與更新">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Style="{StaticResource AdminScroll}">
                  <StackPanel HorizontalAlignment="Stretch" Style="{StaticResource AdminBody}">
                    <TextBlock Text="啟動與更新" Style="{StaticResource AdminTitle}" />
                    <TextBlock Text="設定目前 Windows 使用者的啟動方式與更新來源。" Style="{StaticResource AdminDescription}" />
                    <StackPanel DataContext="{Binding Admin}">
                      <Border Style="{StaticResource AdminCard}">
                        <StackPanel>
                          <TextBlock Text="程式啟動" FontSize="16" FontWeight="SemiBold" />
                          <CheckBox Content="登入 Windows 後自動啟動程式" IsChecked="{Binding AutoStartEnabled}" Style="{StaticResource SettingsSwitch}" Margin="0,10,0,4" MinHeight="40" />
                          <TextBlock Text="電腦重開機並登入目前使用者後，程式會自動啟動並顯示提醒。" Style="{StaticResource WorkspaceMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <Border Style="{StaticResource AdminCard}" DataContext="{Binding Preferences.Maintenance}">
                      <StackPanel>
                        <TextBlock Text="程式更新來源" Style="{StaticResource WorkspaceSection}" />
                        <TextBlock Text="更新資訊網址（HTTPS version.json）" Style="{StaticResource WorkspaceFieldLabel}" />
                        <TextBox Text="{Binding UpdateUrl,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditUpdateUrl}" AutomationProperties.Name="更新資訊 HTTPS 連結" />
                        <TextBlock Text="版本說明與下載：設定 → 軟體更新。" Style="{StaticResource AdminResult}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </TabItem>
            <TabItem Header="備份與移轉">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Style="{StaticResource AdminScroll}">
                  <StackPanel HorizontalAlignment="Stretch" Style="{StaticResource AdminBody}">
                    <TextBlock Text="備份與移轉" Style="{StaticResource AdminTitle}" />
                    <TextBlock Text="本機資料備份與管理設定檔，分開處理。" Style="{StaticResource AdminDescription}" />
                    <views:BackupMaintenanceView DataContext="{Binding Preferences.Maintenance}" />
                    <TextBlock Text="管理設定移轉" Style="{StaticResource WorkspaceSection}" Margin="0,24,0,12" />
                    <Border Style="{StaticResource AdminCard}">
                      <StackPanel>
                        <TextBlock Text="管理設定 JSON" FontWeight="SemiBold" />
                        <TextBlock Text="共用來源、通知政策、更新網址、日誌保留與公司預設天氣。匯入會先驗證並預覽，再確認套用。" Style="{StaticResource AdminResult}" />
                        <WrapPanel Margin="0,16,0,0">
                          <Button Content="匯入並預覽…" Command="{Binding ImportAdminSettingsCommand}" />
                          <Button Content="匯出已儲存設定" Command="{Binding Admin.ExportCurrentSettingsCommand}" />
                          <Button Content="下載 JSON 範本" Command="{Binding Admin.ExportSettingsTemplateCommand}" />
                        </WrapPanel>
                        <TextBlock Text="匯出不含畫面上的未儲存內容。JSON 含連線資訊，不含密碼或 OAuth 憑證。" Style="{StaticResource AdminResult}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </TabItem>
            <TabItem Header="紀錄查詢">
              <Grid Margin="20">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="紀錄查詢" Style="{StaticResource AdminTitle}" />
                  <TextBlock Text="依日期查詢同步、系統事件與管理操作。" Style="{StaticResource AdminDescription}" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,0,0,14">
                  <DatePicker SelectedDate="{Binding Admin.From}" Width="150" Style="{StaticResource HistoryDatePicker}" AutomationProperties.Name="紀錄起始日期" />
                  <TextBlock Text="至" VerticalAlignment="Center" Margin="8" />
                  <DatePicker SelectedDate="{Binding Admin.To}" Width="150" Style="{StaticResource HistoryDatePicker}" AutomationProperties.Name="紀錄結束日期" />
                  <Button Content="查詢" Command="{Binding Admin.RefreshLogsCommand}" Style="{StaticResource AdminPrimary}" Margin="10,0,0,0" />
                </WrapPanel>
                <Grid Grid.Row="2">
                  <TabControl Style="{StaticResource SegmentedTabs}" SelectedIndex="{Binding Admin.SelectedLogKind}" x:Name="LogKinds">
                    <TabItem Header="同步紀錄">
                      <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10" HorizontalAlignment="Right">
                          <Button Content="匯出同步紀錄 CSV" Command="{Binding Admin.ExportCommand}" CommandParameter="SyncLog" />
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding Admin.Logs}">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="次數" Binding="{Binding RepeatCount}" Width="55" />
                            <DataGridTextColumn Header="最後發生" Binding="{Binding LastSeenAt,StringFormat=MM/dd HH:mm:ss}" Width="125" />
                            <DataGridTextColumn Header="時間" Binding="{Binding Time,StringFormat=yyyy-MM-dd HH:mm:ss}" Width="155" />
                            <DataGridTextColumn Header="來源" Binding="{Binding Source}" Width="180" />
                            <DataGridTextColumn Header="狀態" Binding="{Binding Status}" Width="70" />
                            <DataGridTextColumn Header="訊息" Binding="{Binding Message}" Width="*" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DockPanel>
                    </TabItem>
                    <TabItem Header="系統事件">
                      <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="0,0,0,10">
                          <Button Content="匯出系統事件 CSV" Command="{Binding Admin.ExportCommand}" CommandParameter="SystemEvent" HorizontalAlignment="Right" Margin="0" />
                        </Border>
                        <DataGrid ItemsSource="{Binding Admin.Events}">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="時間" Binding="{Binding Time,StringFormat=yyyy-MM-dd HH:mm:ss}" Width="155" />
                            <DataGridTextColumn Header="事件" Binding="{Binding EventType}" Width="140" />
                            <DataGridTextColumn Header="訊息" Binding="{Binding Message}" Width="*" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DockPanel>
                    </TabItem>
                    <TabItem Header="操作稽核">
                      <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="0,0,0,10">
                          <Button Content="匯出稽核紀錄 CSV" Command="{Binding Admin.ExportCommand}" CommandParameter="AuditLog" HorizontalAlignment="Right" Margin="0" />
                        </Border>
                        <DataGrid ItemsSource="{Binding Admin.Audit}">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="時間" Binding="{Binding CreatedAt,StringFormat=yyyy-MM-dd HH:mm:ss}" Width="155" />
                            <DataGridTextColumn Header="操作人" Binding="{Binding UserId}" Width="90" />
                            <DataGridTextColumn Header="項目" Binding="{Binding Action}" Width="180" />
                            <DataGridTextColumn Header="舊值" Binding="{Binding OldValue}" Width="*" />
                            <DataGridTextColumn Header="新值" Binding="{Binding NewValue}" Width="*" />
                          </DataGrid.Columns>
                        </DataGrid>
                      </DockPanel>
                    </TabItem>
                  </TabControl>
                </Grid>
              </Grid>
            </TabItem>
            <TabItem Header="清理與重置">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Style="{StaticResource AdminScroll}">
                  <StackPanel HorizontalAlignment="Stretch" Style="{StaticResource AdminBody}">
                    <TextBlock Text="清理與重置" Style="{StaticResource AdminTitle}" />
                    <TextBlock Text="分開管理日誌保留、舊紀錄與全部資料重置。" Style="{StaticResource AdminDescription}" />
                    <StackPanel DataContext="{Binding Admin}">
                      <Border Style="{StaticResource AdminCard}">
                        <StackPanel>
                          <TextBlock Text="日誌自動清理" FontSize="16" FontWeight="SemiBold" />
                          <TextBlock Text="保留最近幾天的程式執行日誌（含今天），預設 30 天。啟動後及每小時自動檢查；任務歷史、同步紀錄、操作稽核與備份不受影響。" Style="{StaticResource WorkspaceMuted}" TextWrapping="Wrap" Margin="0,6,0,10" />
                          <WrapPanel>
                            <TextBlock Text="保留天數（1–365）" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Text="{Binding LogRetentionDaysText,UpdateSourceTrigger=PropertyChanged}" Width="90" MaxLength="3" AutomationProperties.Name="執行日誌保留天數" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                      <Border Style="{StaticResource AdminCard}">
                        <StackPanel>
                          <TextBlock Text="舊同步紀錄" Style="{StaticResource WorkspaceSection}" />
                          <TextBlock Text="只清理 30 天前舊格式的成功輪詢紀錄；失敗、新式變更明細及任務確認保留。" Style="{StaticResource AdminDescription}" />
                          <Button Content="清理舊成功紀錄…" Command="{Binding PruneSyncLogsCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <Border Style="{StaticResource AdminCard}">
                      <StackPanel>
                        <TextBlock Text="重置全部本機資料" Style="{StaticResource WorkspaceSection}" Foreground="{adaptive:AdaptiveBrush #BA3D45}" />
                        <TextBlock Text="清除本機任務、來源、設定、管理帳密、裝置與相關紀錄。確認後關閉程式，下次啟動回到首次設定。其他位置的匯出備份保留。" Style="{StaticResource AdminDescription}" />
                        <Button Content="重置所有資料與設定…" Click="ResetAll" Style="{StaticResource SettingsDestructive}" HorizontalAlignment="Left" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </TabItem>
          </TabControl>
          <Border x:Name="DraftFooter" Grid.Row="1" Visibility="Collapsed" Padding="24,12" BorderBrush="{adaptive:AdaptiveBrush WorkspaceBorder}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False" x:Name="DraftActions" MaxWidth="760">
              <TextBlock Text="尚未儲存的變更" Style="{StaticResource WorkspaceMuted}" FontSize="12" VerticalAlignment="Center" />
              <Button x:Name="SaveDraftButton" DockPanel.Dock="Right" Content="儲存變更" Click="SaveDraft" Style="{StaticResource AdminPrimary}" Margin="8,0,0,0" />
              <Button DockPanel.Dock="Right" Content="放棄變更" Click="DiscardDraft" Margin="8,0,0,0" />
            </DockPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding Admin.WorkspaceMessage}" Style="{StaticResource AdminResult}" MaxHeight="48" ToolTip="{Binding Admin.WorkspaceMessage}" TextTrimming="CharacterEllipsis" />
  </Grid>
</UserControl>
