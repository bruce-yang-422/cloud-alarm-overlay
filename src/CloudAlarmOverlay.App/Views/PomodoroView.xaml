<UserControl FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="14" x:Class="CloudAlarmOverlay.App.Views.PomodoroView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles" xmlns:c="clr-namespace:CloudAlarmOverlay.App.Controls">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/LightTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
<DockPanel LastChildFill="True">
<StackPanel DockPanel.Dock="Top"><TextBlock Text="番茄鐘專注計時" Style="{StaticResource Heading}"/>
<TextBlock Text="留一段時間給眼前的事，專注與休息都剛剛好。" Style="{StaticResource Muted}" Margin="0,0,0,18"/></StackPanel>
<TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Foreground="{adaptive:AdaptiveBrush #C54D4D}" TextWrapping="Wrap"/>
<Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,18,0,0">
<StackPanel x:Name="SettingsPanel">
<StackPanel Orientation="Horizontal"><TextBlock Text="番茄鐘設定" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="待命時可調整 · 自動儲存" Foreground="{adaptive:AdaptiveBrush #7184A0}" FontSize="12" Margin="16,3,0,0"/></StackPanel>
<ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
<TabControl Style="{StaticResource SegmentedTabs}" IsEnabled="{Binding CanEdit}">
 <TabItem Header="專注節奏">
  <WrapPanel>
   <StackPanel Width="160" Margin="0,0,20,8"><TextBlock Text="專注時間 · 分鐘" Foreground="{adaptive:AdaptiveBrush #7184A0}"/><ComboBox ItemsSource="{Binding FocusChoices}" SelectedItem="{Binding FocusMinutes}" AutomationProperties.Name="專注分鐘"/></StackPanel>
   <StackPanel Width="160" Margin="0,0,20,8"><TextBlock Text="短休息 · 分鐘" Foreground="{adaptive:AdaptiveBrush #7184A0}"/><ComboBox ItemsSource="{Binding BreakChoices}" SelectedItem="{Binding BreakMinutes}" AutomationProperties.Name="短休息分鐘"/></StackPanel>
   <TextBlock Text="每輪專注結束後，留一段短休息。" Foreground="{adaptive:AdaptiveBrush #7184A0}" VerticalAlignment="Center" Margin="0,12,0,0"/>
  </WrapPanel>
 </TabItem>
 <TabItem Header="長休息">
  <WrapPanel>
   <CheckBox Content="啟用長休息" IsChecked="{Binding LongBreakEnabled}" Style="{StaticResource PillSwitch}" Margin="0,20,24,8" VerticalAlignment="Center"/>
   <StackPanel Width="160" Margin="0,0,20,8" IsEnabled="{Binding LongBreakEnabled}"><TextBlock Text="長休息 · 分鐘" Foreground="{adaptive:AdaptiveBrush #7184A0}"/><ComboBox ItemsSource="{Binding LongChoices}" SelectedItem="{Binding LongBreakMinutes}" AutomationProperties.Name="長休息分鐘"/></StackPanel>
   <StackPanel Width="160" Margin="0,0,20,8" IsEnabled="{Binding LongBreakEnabled}"><TextBlock Text="每幾輪安排一次" Foreground="{adaptive:AdaptiveBrush #7184A0}"/><ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding Interval}" AutomationProperties.Name="長休息間隔"/></StackPanel>
  </WrapPanel>
 </TabItem>
 <TabItem Header="結束音效"><StackPanel>
  <WrapPanel>
   <CheckBox Content="播放提示音" IsChecked="{Binding SoundEnabled}" Style="{StaticResource PillSwitch}" Margin="0,20,24,8" VerticalAlignment="Center"/>
   <StackPanel Width="240" Margin="0,0,12,8" IsEnabled="{Binding SoundEnabled}"><TextBlock Text="階段結束時播放" Foreground="{adaptive:AdaptiveBrush #7184A0}"/><ComboBox ItemsSource="{Binding Sounds}" SelectedItem="{Binding SoundName}" AutomationProperties.Name="番茄鐘音效"/></StackPanel>
   <Button Content="{Binding PreviewButtonLabel}" Style="{StaticResource SoundPreviewButton}" Command="{Binding PreviewSoundCommand}" Padding="18,9" Margin="0,22,0,8" ToolTip="可試聽目前聲音，不變更播放提示音開關"/>
  </WrapPanel>
  <TextBlock Text="{Binding PreviewStatus}" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
 </StackPanel></TabItem>
</TabControl>
</ScrollViewer></StackPanel></Border>
<Grid VerticalAlignment="Top">
<Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border x:Name="TimerCard" VerticalAlignment="Stretch" Background="{adaptive:AdaptiveBrush #FFF0E6}" BorderBrush="{adaptive:AdaptiveBrush #F6DCCF}" BorderThickness="1" CornerRadius="18" Padding="14">
<Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="FOCUS TIME" Foreground="{adaptive:AdaptiveBrush #A96F59}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="一次專注，一步前進。" FontSize="22" Margin="0,12,0,0"/></StackPanel>
<Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,12"><StackPanel>
<Grid Width="84" Height="72" HorizontalAlignment="Left">
<Ellipse Fill="{adaptive:AdaptiveBrush #F49379}" Width="70" Height="58" VerticalAlignment="Bottom"/>
<Path Fill="{adaptive:AdaptiveBrush #6FA481}" Data="M 42,23 L 24,7 L 38,11 L 44,0 L 49,14 L 64,9 L 54,26 Z"/>
<Path Stroke="{adaptive:AdaptiveBrush #FFE4D7}" StrokeThickness="3" Data="M 22,43 C 16,49 20,60 25,62"/>
</Grid>
<Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="108" HorizontalAlignment="Left"><TextBlock Text="{Binding Clock}" FontSize="92" FontWeight="SemiBold" Foreground="{adaptive:AdaptiveBrush #DE624E}" FontFamily="Segoe UI" AutomationProperties.Name="剩餘時間"/></Viewbox>
<TextBlock Text="{Binding StateLabel}" Foreground="{adaptive:AdaptiveBrush #9D5C4B}" FontSize="20"/>
<TextBlock Text="{Binding RoundLabel}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
</StackPanel></Viewbox>
<WrapPanel Grid.Row="2">
<Button x:Name="ToggleButton" Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}" Background="{adaptive:AdaptiveBrush #E97861}" Foreground="{adaptive:AdaptiveBrush White}" Margin="0,0,8,8" MinWidth="108" ToolTip="Tab 選取後按空白鍵"/>
<Button Content="跳過" Command="{Binding SkipCommand}" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanToggle}" Margin="0,0,8,8"/>
<Button Content="重設" Command="{Binding ResetCommand}" Visibility="{Binding IsActive,Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"/>
</WrapPanel>
</Grid>
</Border>
<ScrollViewer x:Name="SummaryCards" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<Border Style="{StaticResource Card}" Padding="12">
<StackPanel><TextBlock Text="本輪計時狀態" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
<TextBlock Text="目前階段" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="{Binding StateLabel}" Margin="0,0,0,12"/>
<TextBlock Grid.Row="1" Text="下一個階段" Style="{StaticResource Muted}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Next}" Margin="0,0,0,12"/>
<TextBlock Grid.Row="2" Text="開始時間" Style="{StaticResource Muted}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Started}"/>
</Grid>
<TextBlock Text="{Binding UntilLongBreak}" Style="{StaticResource Muted}" Margin="0,10,0,4"/>
<TextBlock Text="{Binding Dots}" Foreground="{adaptive:AdaptiveBrush #E97861}" FontSize="24"/>
</StackPanel>
</Border>
<Border Style="{StaticResource Card}" Padding="12" Margin="0">
<StackPanel><DockPanel Margin="0,0,0,12"><Button Content="查看紀錄 →" Click="OpenHistory" DockPanel.Dock="Right" Padding="4" HorizontalAlignment="Right" Background="Transparent" Foreground="{adaptive:AdaptiveBrush #76869A}"/><TextBlock Text="今日進度" FontSize="18" FontWeight="SemiBold"/></DockPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel x:Name="ProgressSide" Margin="0,0,12,0">
<Grid Width="92" Height="92"><c:CountdownRing TrackBrush="{adaptive:AdaptiveBrush #F4DBD2}" ProgressBrush="{adaptive:AdaptiveBrush #DE624E}" RemainingHours="{Binding ProgressHours}"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding GoalLabel}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="完成輪數" FontSize="11" Style="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Grid>
</StackPanel>
<StackPanel Grid.Column="1" x:Name="TrendSide">
<StackPanel x:Name="EncouragementNode" Margin="0,0,0,10"><TextBlock Text="✦" Foreground="{adaptive:AdaptiveBrush #D39C43}"/><TextBlock Text="{Binding Encouragement}" TextWrapping="Wrap" FontSize="12" Foreground="{adaptive:AdaptiveBrush #9C7954}"/></StackPanel>
<StackPanel Visibility="{Binding HasProgress,Converter={StaticResource BoolVisibility}}"><TextBlock Text="近 7 天完成輪數" FontSize="13"/><TextBlock Text="{Binding Average}" FontSize="11" Style="{StaticResource Muted}" Margin="0,4,0,8"/></StackPanel>
<ItemsControl ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
<StackPanel Margin="2,0"><StackPanel.ToolTip><TextBlock><Run Foreground="{adaptive:AdaptiveBrush #697C99}" Text="{Binding Weekday}"/><Run Text=" "/><Run Text="{Binding Date}"/><Run Text="："/><Run Foreground="{adaptive:AdaptiveBrush #16243E}" Text="{Binding Count}"/><Run Text=" 輪"/></TextBlock></StackPanel.ToolTip>
<TextBlock Foreground="{adaptive:AdaptiveBrush #16243E}" Text="{Binding Count}" FontSize="10" HorizontalAlignment="Center"/><Grid Height="80" Margin="3,4"><Border Background="{adaptive:AdaptiveBrush #F0F3F6}" CornerRadius="5"/><Border Background="{Binding Color}" Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="5"/></Grid><TextBlock Foreground="{adaptive:AdaptiveBrush #697C99}" Text="{Binding Weekday}" FontSize="10" HorizontalAlignment="Center"/><TextBlock Text="{Binding Date}" FontSize="9" Foreground="{adaptive:AdaptiveBrush #758398}" HorizontalAlignment="Center"/></StackPanel>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></Grid>

</StackPanel></Border>
</StackPanel></ScrollViewer></Grid>
</DockPanel></UserControl>
