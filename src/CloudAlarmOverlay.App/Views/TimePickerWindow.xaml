<Window x:Class="CloudAlarmOverlay.App.Views.TimePickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles" Title="選擇時間" Width="390" Height="660" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{adaptive:AdaptiveBrush #F7FAFE}" Foreground="{adaptive:AdaptiveBrush #16243E}" FontFamily="Segoe UI, Microsoft JhengHei UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/LightTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <Border x:Name="DialColors" Height="0" Background="{adaptive:AdaptiveBrush #E6F0FF}" BorderBrush="{adaptive:AdaptiveBrush #0766FF}"/>
  <Border x:Name="SelectionColors" Height="0" Background="{adaptive:AdaptiveBrush Accent}" BorderBrush="{adaptive:AdaptiveBrush AccentText}"/>
  <TextBlock Text="選擇時間" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel><Button x:Name="HourMode" Content="時 · 24 小時制" Click="SelectHours" Margin="0,0,0,4"/><TextBox x:Name="Hours" FontSize="38" TextAlignment="Center" MaxLength="2" TextChanged="TextEdited" GotKeyboardFocus="FocusHours" AutomationProperties.Name="小時"/></StackPanel>
   <TextBlock Grid.Column="1" Text=":" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
   <StackPanel Grid.Column="2"><Button x:Name="MinuteMode" Content="分" Click="SelectMinutes" Margin="0,0,0,4"/><TextBox x:Name="Minutes" FontSize="38" TextAlignment="Center" MaxLength="2" TextChanged="TextEdited" GotKeyboardFocus="FocusMinutes" AutomationProperties.Name="分鐘"/></StackPanel>
  </Grid>
  <TextBlock x:Name="Hint" Style="{StaticResource Muted}" FontSize="12" Margin="0,10"/>
  <Canvas x:Name="Dial" Width="290" Height="290" Background="Transparent" PreviewMouseLeftButtonDown="DialDown" MouseMove="DialMove" MouseLeftButtonUp="DialUp" LostMouseCapture="DialLostCapture" HorizontalAlignment="Center"/>
 </StackPanel></ScrollViewer><StackPanel Grid.Row="1">
  <TextBlock x:Name="Error" Foreground="{adaptive:AdaptiveBrush #B13C5A}" TextWrapping="Wrap" Margin="0,10,0,6" AutomationProperties.LiveSetting="Polite"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True"/><Button x:Name="Confirm" Content="確定" Click="Accept" Style="{StaticResource Primary}" Margin="0"/></StackPanel>
 </StackPanel></Grid>
</Window>
