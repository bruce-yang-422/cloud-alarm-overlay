<UserControl x:Class="CloudAlarmOverlay.App.Views.WeatherLocationPicker"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="QueryVisibility"/></UserControl.Resources>
 <StackPanel>
  <WrapPanel Margin="0,8">
   <StackPanel Margin="0,0,16,8"><TextBlock Text="縣市" Margin="0,0,0,6"/><ComboBox x:Name="CountyPicker" ItemsSource="{Binding Counties}" SelectedItem="{Binding SelectedCounty}" Width="180" IsEditable="False" AutomationProperties.Name="天氣縣市"/></StackPanel>
   <StackPanel Margin="0,0,0,8"><TextBlock Text="鄉鎮市區" Margin="0,0,0,6"/><ComboBox x:Name="DistrictPicker" ItemsSource="{Binding Districts}" SelectedItem="{Binding SelectedDistrict}" DisplayMemberPath="DistrictLabel" Width="230" IsEditable="False" AutomationProperties.Name="天氣鄉鎮市區"/></StackPanel>
  </WrapPanel>
  <TextBlock Text="快速尋找地點／郵遞區號" Margin="0,0,0,6"/>
  <DockPanel MaxWidth="560" HorizontalAlignment="Left" LastChildFill="True">
   <Button DockPanel.Dock="Right" Content="清除搜尋" Command="{Binding ClearLocationQueryCommand}" Margin="8,0,0,0"/>
   <TextBox x:Name="QueryBox" Text="{Binding LocationQuery,UpdateSourceTrigger=PropertyChanged}" MinWidth="220" MaxLength="80" AutomationProperties.Name="搜尋內建地點或郵遞區號">
    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ChooseUniqueLocationCommand}"/></TextBox.InputBindings>
   </TextBox>
  </DockPanel>
  <TextBlock Text="{Binding SearchHint}" TextWrapping="Wrap" Margin="0,6,0,6"/>
  <ListBox x:Name="ResultsList" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}" DisplayMemberPath="SearchLabel" MaxHeight="160" MaxWidth="560" HorizontalAlignment="Left" MinWidth="300" Visibility="{Binding HasLocationQuery,Converter={StaticResource QueryVisibility}}" AutomationProperties.Name="符合的天氣地點" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{adaptive:AdaptiveBrush #FFFFFF}" Foreground="{adaptive:AdaptiveBrush #16243E}" BorderBrush="{adaptive:AdaptiveBrush #D6E1EF}">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{adaptive:AdaptiveBrush #F7FAFE}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{adaptive:AdaptiveBrush #E6F0FF}"/><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style></ListBox.ItemContainerStyle>
  </ListBox>
  <TextBlock Text="{Binding SelectedLocationLabel}" TextWrapping="Wrap" Margin="0,8"/>
  <TextBlock Text="地點資料：中華郵政、國土測繪中心、© OpenStreetMap contributors（ODbL）、GeoNames（CC BY）。" FontSize="12" TextWrapping="Wrap" Foreground="{adaptive:AdaptiveBrush #697C99}" Margin="0,4,0,8"/>
  <TextBlock Text="openstreetmap.org/copyright · geonames.org" FontSize="12" TextWrapping="Wrap" Foreground="{adaptive:AdaptiveBrush #697C99}"/>
 </StackPanel>
</UserControl>
