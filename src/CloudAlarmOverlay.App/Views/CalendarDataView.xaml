<UserControl x:Class="CloudAlarmOverlay.App.Views.CalendarDataView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CloudAlarmOverlay.App.Controls" xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Styles/LightTheme.xaml"/><ResourceDictionary Source="../Styles/SlidingSegmentedControl.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
  <TextBlock Text="農曆與假日資料" Style="{StaticResource Heading}"/>
  <TextBlock Text="安裝後自動套用內建資料，離線也可使用。若有 Sheet A 同日期資料，優先採用 Sheet A。" Style="{StaticResource Muted}" Margin="0,8,0,16"/>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Summary}" FontSize="16" TextWrapping="Wrap"/><TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="GitHub 網路更新" FontSize="20" FontWeight="SemiBold"/>
   <CheckBox x:Name="NetworkUpdates" Content="允許網路更新（預設關閉）" IsChecked="{Binding Enabled}" Style="{StaticResource PillSwitch}" Margin="0,14"/>
   <controls:SlidingSegmentedControl x:Name="UpdateFrequency" ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}" Style="{StaticResource PillSlidingSegmentedControl}" Height="44" MaxWidth="620"/>
   <TextBlock Text="每天：每日首次執行時；每週：週一後首次執行時；每月：每月 1 日後首次執行時。程式持續開啟時也會檢查。手動更新只在按下「立即更新」時連線。" Style="{StaticResource Muted}" Margin="0,12,0,18"/>
   <TextBlock Text="假日 JSON 網址" FontWeight="SemiBold"/><TextBox x:Name="HolidaysSource" Text="{Binding HolidaysUrl,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="假日 JSON 網址"/>
   <TextBlock Text="農曆 JSON 網址" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBox x:Name="LunarSource" Text="{Binding LunarUrl,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="農曆 JSON 網址"/>
   <TextBlock Text="支援公開 GitHub JSON 的原始檔網址或 blob 檔案網址。兩份檔案需有相同版本與涵蓋期間；下載或驗證失敗時保留原資料，下個週期再試，也可手動重試。" Style="{StaticResource Muted}" Margin="0,12,0,18"/>
   <WrapPanel><Button Content="儲存設定" Command="{Binding SaveCommand}" Style="{StaticResource Primary}"/><Button Content="立即更新" Command="{Binding UpdateCommand}"/></WrapPanel>
  </StackPanel></Border>
  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,10"/>
 </StackPanel></ScrollViewer>
</UserControl>
