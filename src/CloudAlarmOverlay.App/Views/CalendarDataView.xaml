<UserControl xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CloudAlarmOverlay.App.Views.CalendarDataView" FontSize="14">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles/AdminWorkspaceStyles.xaml" />
        <ResourceDictionary Source="../Styles/SlidingSegmentedControl.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid MaxWidth="760" Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="農曆與假日資料" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBlock Text="內建資料可離線使用；同日期的 Sheet A 資料優先套用。" Style="{StaticResource Muted}" FontSize="13" />
    </StackPanel>
    <ScrollViewer x:Name="CalendarSettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
      <StackPanel>
        <Border Style="{StaticResource AdminCard}" Padding="12,4" Margin="0,4,0,4">
          <Expander x:Name="DataStatus" Header="資料狀態與更新紀錄" IsExpanded="True">
            <StackPanel Margin="4,8,4,12">
              <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" LineHeight="22" />
              <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Muted}" FontSize="13" Margin="0,12,0,0" />
            </StackPanel>
          </Expander>
        </Border>
        <TextBlock Text="GitHub 網路更新" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource AdminCard}">
          <StackPanel IsEnabled="{Binding CanEditSourceSettings}">
            <CheckBox x:Name="NetworkUpdates" IsChecked="{Binding Enabled}" Style="{StaticResource SettingsSwitch}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="允許網路更新">
              <StackPanel>
                <TextBlock Text="允許網路更新" FontWeight="SemiBold" />
                <TextBlock Text="預設關閉，開啟後依下方頻率更新資料。" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" />
              </StackPanel>
            </CheckBox>
            <Border BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="0,1,0,0" Margin="0,14,0,14" />
            <TextBlock Text="更新頻率" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
            <ComboBox x:Name="UpdateFrequency" ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}" AutomationProperties.Name="日曆資料更新頻率" Width="170" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding FrequencyDescription}" Style="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Expander Header="進階：資料來源網址" IsExpanded="False" Margin="0,8,0,0" x:Name="AdvancedSources">
          <StackPanel Margin="0,12,0,0">
            <Grid Margin="2,4,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="更新來源" FontWeight="SemiBold" />
              <CheckBox x:Name="SourceUrlsLock" Grid.Column="1" Content="鎖定網址" IsChecked="{Binding UrlsLocked}" IsEnabled="{Binding CanEditSourceSettings}" Style="{StaticResource SettingsSwitch}" Margin="12,0" AutomationProperties.Name="鎖定日曆來源網址" />
              <Button x:Name="RestoreSourceUrls" Grid.Column="2" Content="還原預設網址" Command="{Binding RestoreDefaultUrlsCommand}" Margin="0" AutomationProperties.Name="還原兩個日曆預設網址" />
            </Grid>
            <Border Style="{StaticResource AdminCard}">
              <StackPanel>
                <TextBlock Text="假日 JSON 網址" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="HolidaysSource" Text="{Binding HolidaysUrl,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding UrlsReadOnly}" ToolTip="{Binding HolidaysUrl}" AutomationProperties.Name="假日 JSON 網址" FontSize="12" Margin="0,0,0,16" />
                <TextBlock Text="農曆 JSON 網址" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="LunarSource" Text="{Binding LunarUrl,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding UrlsReadOnly}" ToolTip="{Binding LunarUrl}" AutomationProperties.Name="農曆 JSON 網址" FontSize="12" Margin="0" />
                <TextBlock Text="{Binding UrlLockDescription}" Style="{StaticResource Muted}" FontSize="13" Margin="0,10,0,0" />
                <Expander Header="來源格式說明" Margin="0,8,0,0">
                  <TextBlock Text="支援 GitHub 公開 JSON 的原始檔網址或 blob 網址。兩份檔案須使用相同版本與涵蓋期間；下載或驗證失敗時保留原資料，下個週期重試。" Style="{StaticResource Muted}" FontSize="13" Margin="4,4,4,8" />
                </Expander>
              </StackPanel>
            </Border>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{adaptive:AdaptiveBrush #DEE6F1}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEditSourceSettings}">
          <Button x:Name="SaveSettingsButton" Content="儲存設定" Command="{Binding SaveCommand}" Style="{StaticResource SettingsPrimary}" />
          <Button x:Name="UpdateNowButton" Content="立即更新" Command="{Binding UpdateCommand}" />
        </StackPanel>
        <TextBlock x:Name="OperationResult" Text="{Binding Message}" FontSize="13" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" MaxHeight="40" ToolTip="{Binding Message}">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Message}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
