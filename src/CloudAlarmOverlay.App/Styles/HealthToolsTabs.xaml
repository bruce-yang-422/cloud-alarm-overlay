<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles" xmlns:controls="clr-namespace:CloudAlarmOverlay.App.Controls">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SlidingSegmentedControl.xaml"/></ResourceDictionary.MergedDictionaries>
 <Style x:Key="HealthSegmentedTabs" TargetType="TabControl">
  <Setter Property="Background" Value="{adaptive:AdaptiveBrush #FFFFFF}"/>
  <Setter Property="BorderBrush" Value="{adaptive:AdaptiveBrush #DEE6F1}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
   <Grid KeyboardNavigation.TabNavigation="Local">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <controls:SlidingSegmentedControl x:Name="PART_HealthSegments" ItemsSource="{Binding PageNames}"
     SelectedIndex="{Binding SelectedIndex,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"
     Style="{StaticResource PillSlidingSegmentedControl}" Height="46" MaxWidth="680"
     Width="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left"
     Margin="0,0,0,14" FontSize="14" AutomationProperties.Name="健康工具分頁"/>
    <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14">
     <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" TextElement.FontWeight="Normal" Margin="0" KeyboardNavigation.TabIndex="2"/>
    </Border>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
