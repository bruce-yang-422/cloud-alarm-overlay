<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles">
   <Style x:Key="CalendarNavButton" TargetType="Button">
    <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
    <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Surface" Background="Transparent" CornerRadius="9" BorderBrush="Transparent" BorderThickness="1">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{adaptive:AdaptiveBrush #E6F0FF}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="CalendarHeaderButton" TargetType="Button" BasedOn="{StaticResource CalendarNavButton}">
    <Setter Property="Width" Value="Auto"/><Setter Property="Padding" Value="8,0"/>
    <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="15"/>
   </Style>
   <Style x:Key="CalendarDayCell" TargetType="primitives:CalendarDayButton">
    <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/>
    <Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="primitives:CalendarDayButton">
     <Border x:Name="Surface" Margin="2" CornerRadius="9" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #A7B3C6}"/></Trigger>
      <Trigger Property="IsToday" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{adaptive:AdaptiveBrush #E6F0FF}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{adaptive:AdaptiveBrush #2563EB}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #2563EB}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="CalendarMonthCell" TargetType="primitives:CalendarButton">
    <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="primitives:CalendarButton">
     <Border x:Name="Surface" Margin="3" CornerRadius="9" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #A7B3C6}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{adaptive:AdaptiveBrush #E6F0FF}"/></Trigger>
      <Trigger Property="HasSelectedDays" Value="True"><Setter TargetName="Surface" Property="Background" Value="{adaptive:AdaptiveBrush #2563EB}"/><Setter Property="Foreground" Value="White"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="EditorCalendarItem" TargetType="primitives:CalendarItem">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="primitives:CalendarItem">
     <ControlTemplate.Resources>
      <DataTemplate x:Key="{x:Static primitives:CalendarItem.DayTitleTemplateResourceKey}"><TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{adaptive:AdaptiveBrush #7184A0}" FontSize="12" FontWeight="SemiBold"/></DataTemplate>
     </ControlTemplate.Resources>
     <Grid x:Name="PART_Root" Width="308">
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="252"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="2,0,2,7">
       <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
       <Button x:Name="PART_PreviousButton" Grid.Column="0" Content="‹" FontSize="23" Style="{StaticResource CalendarNavButton}" AutomationProperties.Name="上一個月"/>
       <Button x:Name="PART_HeaderButton" Grid.Column="1" Style="{StaticResource CalendarHeaderButton}" AutomationProperties.Name="切換月份或年份"/>
       <Button x:Name="PART_NextButton" Grid.Column="2" Content="›" FontSize="23" Style="{StaticResource CalendarNavButton}" AutomationProperties.Name="下一個月"/>
      </Grid>
      <Border Grid.Row="1" Height="1" Margin="4,0,4,5" Background="{adaptive:AdaptiveBrush #E0E7F1}"/>
      <Grid x:Name="PART_MonthView" Grid.Row="2" KeyboardNavigation.TabNavigation="Once">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      </Grid>
      <Grid x:Name="PART_YearView" Grid.Row="2" Visibility="Hidden" KeyboardNavigation.TabNavigation="Once">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
      </Grid>
      <Border x:Name="PART_DisabledVisual" Grid.RowSpan="3" Background="{adaptive:AdaptiveBrush #FFFFFF}" Opacity="0.5" Visibility="Collapsed"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible"/></Trigger>
      <DataTrigger Binding="{Binding DisplayMode,RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/></DataTrigger>
      <DataTrigger Binding="{Binding DisplayMode,RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/></DataTrigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="EditorCalendar" TargetType="Calendar">
    <Setter Property="CalendarItemStyle" Value="{StaticResource EditorCalendarItem}"/>
    <Setter Property="CalendarButtonStyle" Value="{StaticResource CalendarMonthCell}"/>
    <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarDayCell}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Calendar">
     <StackPanel x:Name="PART_Root"><primitives:CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/></StackPanel>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
</ResourceDictionary>
