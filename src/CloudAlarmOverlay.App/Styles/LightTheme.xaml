<ResourceDictionary xmlns:local="clr-namespace:CloudAlarmOverlay.App.Styles" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:adaptive="clr-namespace:CloudAlarmOverlay.App.Styles">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="NavigationStyles.xaml"/><ResourceDictionary Source="FormControls.xaml"/></ResourceDictionary.MergedDictionaries>
  <local:AlarmLevelLabelConverter x:Key="AlarmLevelLabel"/>
  <DataTemplate x:Key="AlarmLevelItem"><TextBlock Text="{Binding Converter={StaticResource AlarmLevelLabel}}"/></DataTemplate>
  <SolidColorBrush x:Key="CanvasBrush" Color="#F7FAFE" />
  <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TextBrush" Color="#16243E" />
  <SolidColorBrush x:Key="MutedBrush" Color="#697C99" />
  <BooleanToVisibilityConverter x:Key="BoolVisibility" />
  <Style TargetType="Window">
    <Setter Property="Background" Value="{adaptive:AdaptiveBrush #F7FAFE}" />
    <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}" />
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft JhengHei UI" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #697C99}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}" />
    <Setter Property="FontSize" Value="23" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{adaptive:AdaptiveBrush #FFFFFF}" />
    <Setter Property="BorderBrush" Value="{adaptive:AdaptiveBrush #DEE6F1}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="Background" Value="{adaptive:AdaptiveBrush #F0F5FC}" />
    <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{adaptive:AdaptiveBrush #D6E1EF}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger><Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #1668CA}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="B" Property="Opacity" Value=".4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#2563EB" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style x:Key="SoundPreviewButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
        <Setter Property="Background" Value="#2563EB"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#2563EB"/>
        <DataTrigger.EnterActions>
          <BeginStoryboard Name="SoundPreviewPulse"><Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.65" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="Forever"/>
          </Storyboard></BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="SoundPreviewPulse"/></DataTrigger.ExitActions>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="CompactSecondsSlider" TargetType="Slider">
    <Setter Property="Height" Value="34"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Slider">
        <Grid Margin="9,0">
          <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="8"/></Grid.RowDefinitions>
          <Track x:Name="PART_Track" Grid.Row="0" Height="22" Orientation="Horizontal"
                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
              <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" Background="{adaptive:AdaptiveBrush #2563EB}" CornerRadius="3"/></ControlTemplate></RepeatButton.Template>
            </RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="18" Height="18">
              <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{adaptive:AdaptiveBrush #FFFFFF}" Stroke="{adaptive:AdaptiveBrush #2563EB}" StrokeThickness="3"/></ControlTemplate></Thumb.Template>
            </Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
              <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" Background="{adaptive:AdaptiveBrush #D6E1EF}" CornerRadius="3"/></ControlTemplate></RepeatButton.Template>
            </RepeatButton></Track.IncreaseRepeatButton>
          </Track>
          <TickBar Grid.Row="1" Placement="Bottom" Height="6" Fill="{adaptive:AdaptiveBrush #697C99}"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   TickFrequency="{TemplateBinding TickFrequency}"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{adaptive:AdaptiveBrush #FDFEFF}" />
    <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}" />
    <Setter Property="BorderBrush" Value="{adaptive:AdaptiveBrush #D6E1EF}" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="CaretBrush" Value="{adaptive:AdaptiveBrush #16243E}" />
    <Setter Property="Margin" Value="0,4,0,8" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="TextBox">
        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ScrollViewer x:Name="PART_ContentHost"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #1668CA}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/><Setter TargetName="Field" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value=".5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>

  <Style TargetType="DatePicker">
    <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Margin" Value="0,4,0,8" />
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}" />
    <Setter Property="Margin" Value="0,8,0,8" />
  </Style>
  <Style TargetType="DataGrid">
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="CanUserReorderColumns" Value="False" />
    <Setter Property="CanUserResizeColumns" Value="True" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="CanUserSortColumns" Value="True" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{adaptive:AdaptiveBrush #E8EEF6}" />
    <Setter Property="Background" Value="{adaptive:AdaptiveBrush #FFFFFF}" />
    <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}" />
    <Setter Property="RowBackground" Value="{adaptive:AdaptiveBrush #FFFFFF}" />
    <Setter Property="AlternatingRowBackground" Value="{adaptive:AdaptiveBrush #FAFCFF}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowHeight" Value="42" />
    <Setter Property="MinHeight" Value="120" />
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{adaptive:AdaptiveBrush #F1F5FA}" />
    <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #697C99}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{adaptive:AdaptiveBrush #D6E1EF}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="LevelBadge">
    <Border x:Name="Badge" Background="{adaptive:AdaptiveBrush #EAF3FF}" CornerRadius="5" Padding="8,4" HorizontalAlignment="Left">
      <TextBlock x:Name="BadgeText" Text="{Binding Level,Converter={StaticResource AlarmLevelLabel}}" Foreground="{adaptive:AdaptiveBrush #0766FF}" FontWeight="SemiBold" />
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Level}" Value="重要提醒">
        <Setter TargetName="Badge" Property="Background" Value="{adaptive:AdaptiveBrush #EDF7F2}" />
        <Setter TargetName="BadgeText" Property="Foreground" Value="{adaptive:AdaptiveBrush #14715E}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Level}" Value="緊急提醒">
        <Setter TargetName="Badge" Property="Background" Value="{adaptive:AdaptiveBrush #FAEEF0}" />
        <Setter TargetName="BadgeText" Property="Foreground" Value="{adaptive:AdaptiveBrush #963D52}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Level}" Value="強制通知">
        <Setter TargetName="Badge" Property="Background" Value="{adaptive:AdaptiveBrush #FFF0EC}" />
        <Setter TargetName="BadgeText" Property="Foreground" Value="{adaptive:AdaptiveBrush #BC2925}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="SourceBadge">
    <Border x:Name="SourceBox" Background="{adaptive:AdaptiveBrush #EFF2F7}" CornerRadius="5" Padding="8,4" HorizontalAlignment="Left">
      <TextBlock x:Name="SourceText" Text="{Binding Source}" Foreground="{adaptive:AdaptiveBrush #50617C}" />
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Source}" Value="SheetA">
        <Setter TargetName="SourceBox" Property="Background" Value="{adaptive:AdaptiveBrush #EAF3FF}" />
        <Setter TargetName="SourceText" Property="Foreground" Value="{adaptive:AdaptiveBrush #0766FF}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Source}" Value="SheetB">
        <Setter TargetName="SourceBox" Property="Background" Value="{adaptive:AdaptiveBrush #E9F9EF}" />
        <Setter TargetName="SourceText" Property="Foreground" Value="{adaptive:AdaptiveBrush #148D48}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Template"><Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{adaptive:AdaptiveBrush #F0F5FB}">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb MinHeight="32">
                  <Thumb.Template><ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" Background="{adaptive:AdaptiveBrush #AABBD1}" CornerRadius="5" Margin="3,2"/>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger></ControlTemplate.Triggers>
                  </ControlTemplate></Thumb.Template>
                </Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}"/></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value></Setter>
      </Trigger>
    </Style.Triggers>
  </Style> <Style x:Key="PillSwitch" TargetType="CheckBox">
  <Setter Property="Foreground" Value="{adaptive:AdaptiveBrush #16243E}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <StackPanel Orientation="Horizontal" Background="Transparent">
    <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" Background="{adaptive:AdaptiveBrush #A7B3C6}" BorderThickness="1" BorderBrush="{adaptive:AdaptiveBrush #D6E1EF}" Margin="0,0,12,0">
     <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3"/>
    </Border><ContentPresenter VerticalAlignment="Center"/>
   </StackPanel>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{adaptive:AdaptiveBrush #2563EB}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #0766FF}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #16243E}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style><Style x:Key="HistoryDatePicker" TargetType="DatePicker" xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"><Setter Property="SelectedDateFormat" Value="Short"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker">
<Border x:Name="Outline" Background="{adaptive:AdaptiveBrush White}" BorderBrush="{adaptive:AdaptiveBrush #D9E3EF}" BorderThickness="1" CornerRadius="8" Padding="10,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
<p:DatePickerTextBox x:Name="PART_TextBox" Foreground="{adaptive:AdaptiveBrush #253B55}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="0" Margin="0"><p:DatePickerTextBox.Template><ControlTemplate TargetType="p:DatePickerTextBox"><ScrollViewer x:Name="PART_ContentHost"/></ControlTemplate></p:DatePickerTextBox.Template></p:DatePickerTextBox>
<Button x:Name="PART_Button" Grid.Column="1" Content="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{adaptive:AdaptiveBrush #56738F}" Background="Transparent" Padding="6" Margin="0" AutomationProperties.Name="開啟月曆"/>
<Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False"/>
</Grid></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{adaptive:AdaptiveBrush #1670D5}"/></Trigger></ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
