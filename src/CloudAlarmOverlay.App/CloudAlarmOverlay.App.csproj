<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/Brand/cloud_alarm_app.ico</ApplicationIcon>
    <AppLastUpdated Condition="'$(AppLastUpdated)' == ''">$([System.DateTime]::Now.ToString('yyyy-MM-dd'))</AppLastUpdated>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppLastUpdated</_Parameter1>
      <_Parameter2>$(AppLastUpdated)</_Parameter2>
    </AssemblyAttribute>
    <Content Include="../CloudAlarmOverlay.Core/Data/TaiwanWeatherLocations.json" Link="Data/TaiwanWeatherLocations.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../CloudAlarmOverlay.Core/Data/README.md" Link="Data/WeatherLocations-README.md" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets/Emoji/*.png" />
    <Content Include="Assets/Emoji/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets/Brand/*.png" />
    <Content Include="../../task_builder_tailwind.html" Link="task_builder_tailwind.html" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../CloudAlarmOverlay.Core/CloudAlarmOverlay.Core.csproj" />
    <ProjectReference Include="../CloudAlarmOverlay.Data/CloudAlarmOverlay.Data.csproj" />
    <ProjectReference Include="../CloudAlarmOverlay.BackgroundServices/CloudAlarmOverlay.BackgroundServices.csproj" />
    <ProjectReference Include="../CloudAlarmOverlay.Infrastructure/CloudAlarmOverlay.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>
</Project>
